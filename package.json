{
  "name": "waytoasia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:translations && astro check && astro build && node scripts/localize-built-html.mjs && node scripts/check-rendered-translations.mjs && node scripts/harden-csp.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "npm run build && playwright test",
    "test:smoke": "playwright test",
    "test:trip-planner": "node --import tsx --test tests/trip-planner.test.ts",
    "test:suppliers": "node --import tsx --test tests/supplier-contracts.test.ts",
    "test:hbx": "node --import tsx --test tests/hbx-sandbox.test.ts",
    "test:availability": "node --import tsx --test tests/supplier-availability.test.ts",
    "test:proposal": "node --import tsx --test tests/proposal-portal.test.ts tests/proposal-response.test.ts",
    "cf:deploy": "wrangler pages deploy dist --project-name waytoasia",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sanity/client": "latest",
    "astro": "latest",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "maplibre-gl": "^6.9.0",
    "react": "latest",
    "react-dom": "latest",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@eslint/js": "latest",
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "latest",
    "eslint-plugin-astro": "latest",
    "globals": "latest",
    "parse5": "^7.3.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "tsx": "^4.20.6",
    "wrangler": "latest"
  }
}
