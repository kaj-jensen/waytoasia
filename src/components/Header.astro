---
import {locales,localeNames,localizedPath,t,tr,localizeContent,type Locale} from '../i18n';
import {countries,journeyStyles} from '../content/data';
const {locale,path=''}=Astro.props as {locale:Locale;path?:string};
const displayCountries=localizeContent(locale,countries);const displayStyles=localizeContent(locale,journeyStyles);
---
<header class="header">
 <a class="brand" href={localizedPath(locale)} aria-label={tr(locale,'Way to Asia home')}><span>WAY</span><i>to</i><span>ASIA</span></a>
 <nav aria-label={tr(locale,'Primary')}>
  <div class="nav-group"><button type="button" aria-expanded="false" data-nav-toggle>{t(locale,'navDestinations')} <span>⌄</span></button><div class="mega"><div><small>{tr(locale,'Explore by country')}</small>{displayCountries.map(c=><a href={localizedPath(locale,`/${c.slug}`)}><b>{c.code}</b><span>{c.name}<em>{c.nativeName}</em></span></a>)}</div><div><small>{tr(locale,'Find your way')}</small>{displayStyles.map(s=><a href={localizedPath(locale,`/tours#${s.slug}`)}><span>{s.label}<em>{s.eyebrow}</em></span></a>)}<a class="mega-all" href={localizedPath(locale,'/tours')}>{tr(locale,'View all journeys')} ↗</a></div></div></div>
  <a href={localizedPath(locale,'/tours')}>{t(locale,'navTours')}</a>
  <a href={localizedPath(locale,'/inspiration')}>{tr(locale,'Inspiration')}</a>
  <a href={localizedPath(locale,'/about')}>{t(locale,'navAbout')}</a>
 </nav>
 <div class="actions"><label class="lang"><span class="sr">{tr(locale,'Language')}</span><select aria-label={tr(locale,'Language')} data-language>{locales.map(l=><option value={localizedPath(l,path)} selected={l===locale}>{localeNames[l]}</option>)}</select></label><a class="plan" href={localizedPath(locale,'/contact')}>{t(locale,'navContact')} <span>↗</span></a></div>
 <button class="menu" aria-label={tr(locale,'Open menu')} aria-expanded="false">{tr(locale,'Menu')}</button>
</header>
<script>document.querySelectorAll<HTMLSelectElement>('[data-language]').forEach(el=>el.addEventListener('change',()=>{const locale=el.value.split('/')[1];localStorage.setItem('waytoasia-locale',locale);location.href=el.value}));document.querySelectorAll<HTMLButtonElement>('.menu').forEach(btn=>btn.addEventListener('click',()=>{const h=btn.closest('header');const open=h?.classList.toggle('open');btn.setAttribute('aria-expanded',String(Boolean(open)))}));document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach(btn=>btn.addEventListener('click',()=>btn.setAttribute('aria-expanded',String(btn.getAttribute('aria-expanded')!=='true'))));</script>
<style>
.header{height:86px;padding:0 max(24px,calc((100vw - 1180px)/2));display:flex;align-items:center;gap:3rem;position:absolute;inset:0 0 auto;z-index:20;color:var(--cream);background-color:rgba(6,25,19,.84);background-image:linear-gradient(180deg,rgba(6,25,19,.94),rgba(6,25,19,.76));border-bottom:1px solid rgba(243,238,223,.32);box-shadow:0 8px 22px rgba(4,17,13,.2);backdrop-filter:blur(8px) saturate(.9);-webkit-backdrop-filter:blur(8px) saturate(.9)}.brand{display:flex;align-items:baseline;gap:.22rem;font:600 1.05rem var(--mono);letter-spacing:.09em}.brand i{font:italic 1.1rem var(--display);color:var(--gold)}nav{display:flex;align-items:center;gap:2rem;margin-left:auto}nav>a,nav button,.plan{font:500 .69rem var(--mono);letter-spacing:.08em;text-transform:uppercase;text-shadow:0 1px 2px rgba(0,0,0,.35)}.nav-group{position:relative}.nav-group>button{border:0;background:transparent;color:inherit;padding:1.8rem 0}.nav-group>button span{color:var(--gold)}.mega{position:absolute;top:100%;left:-10rem;width:min(720px,75vw);display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(243,238,223,.18);box-shadow:0 28px 70px rgba(0,0,0,.3);opacity:0;visibility:hidden;transform:translateY(-8px);transition:.22s}.nav-group:hover .mega,.nav-group:focus-within .mega,.nav-group>button[aria-expanded="true"]+.mega{opacity:1;visibility:visible;transform:none}.mega>div{background:var(--ink);padding:1.4rem}.mega small{display:block;margin-bottom:.7rem;color:var(--gold);font:500 .6rem var(--mono);letter-spacing:.15em;text-transform:uppercase}.mega a{display:flex;align-items:center;gap:.8rem;padding:.65rem;border-top:1px solid rgba(243,238,223,.16);text-transform:none;letter-spacing:0}.mega a:hover{background:var(--ink-2)}.mega b{color:var(--gold);font:.62rem var(--mono)}.mega span{font:.8rem var(--body)}.mega em{display:block;color:rgba(243,238,223,.72);font:normal .65rem var(--body)}.mega .mega-all{margin-top:.7rem;color:var(--gold);font:.65rem var(--mono);text-transform:uppercase;letter-spacing:.08em}.actions{display:flex;align-items:center;gap:1.5rem}.lang select{background:transparent;border:0;color:inherit;font:500 .68rem var(--mono);max-width:80px}.lang option{color:#111}.plan{border-left:1px solid rgba(243,238,223,.25);padding-left:1.5rem}.plan span{color:var(--gold)}.menu{display:none;background:none;border:0;color:inherit}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:850px){.header{height:72px;padding-inline:20px}.header nav,.header .actions{display:none}.menu{display:block;margin-left:auto}.header.open{height:auto;padding-block:24px;align-items:flex-start;background:var(--ink);flex-wrap:wrap}.header.open nav,.header.open .actions{display:flex;flex:1 0 100%;flex-direction:column;align-items:stretch;gap:1rem}.header.open nav{margin:1rem 0 0}.header.open .plan{border:0;padding:0}.header.open .nav-group>button{padding:0}.mega{position:static;width:100%;display:none;grid-template-columns:1fr;opacity:1;visibility:visible;transform:none;box-shadow:none;margin-top:1rem}.nav-group>button[aria-expanded="true"]+.mega{display:grid}}
</style>
