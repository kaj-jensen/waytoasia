---
import {locales,localeNames,localizedPath,t,type Locale} from '../i18n';
const {locale,path=''}=Astro.props as {locale:Locale;path?:string};
---
<header class="header">
 <a class="brand" href={localizedPath(locale)} aria-label="Way to Asia home"><span>WAY</span><i>to</i><span>ASIA</span></a>
 <nav aria-label="Primary">
  <a href={localizedPath(locale,'/#destinations')}>{t(locale,'navDestinations')}</a>
  <a href={localizedPath(locale,'/tours')}>{t(locale,'navTours')}</a>
  <a href={localizedPath(locale,'/about')}>{t(locale,'navAbout')}</a>
 </nav>
 <div class="actions"><label class="lang"><span class="sr">Language</span><select aria-label="Language" data-language>{locales.map(l=><option value={localizedPath(l,path)} selected={l===locale}>{localeNames[l]}</option>)}</select></label><a class="plan" href={localizedPath(locale,'/contact')}>{t(locale,'navContact')} <span>↗</span></a></div>
 <button class="menu" aria-label="Open menu" aria-expanded="false">Menu</button>
</header>
<script>document.querySelectorAll<HTMLSelectElement>('[data-language]').forEach(el=>el.addEventListener('change',()=>location.href=el.value));document.querySelectorAll<HTMLButtonElement>('.menu').forEach(btn=>btn.addEventListener('click',()=>{const h=btn.closest('header');const open=h?.classList.toggle('open');btn.setAttribute('aria-expanded',String(Boolean(open)))}));</script>
<style>
.header{height:86px;padding:0 max(24px,calc((100vw - 1180px)/2));display:flex;align-items:center;gap:3rem;position:absolute;inset:0 0 auto;z-index:20;color:var(--cream);border-bottom:1px solid rgba(243,238,223,.2)}.brand{display:flex;align-items:baseline;gap:.22rem;font:600 1.05rem var(--mono);letter-spacing:.09em}.brand i{font:italic 1.1rem var(--display);color:var(--gold)}nav{display:flex;gap:2rem;margin-left:auto}nav a,.plan{font:500 .69rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.actions{display:flex;align-items:center;gap:1.5rem}.lang select{background:transparent;border:0;color:inherit;font:500 .68rem var(--mono);max-width:80px}.lang option{color:#111}.plan{border-left:1px solid rgba(243,238,223,.25);padding-left:1.5rem}.plan span{color:var(--gold)}.menu{display:none;background:none;border:0;color:inherit}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:850px){.header{height:72px;padding-inline:20px}.header nav,.header .actions{display:none}.menu{display:block;margin-left:auto}.header.open{height:auto;padding-block:24px;align-items:flex-start;background:var(--ink);flex-wrap:wrap}.header.open nav,.header.open .actions{display:flex;flex:1 0 100%;flex-direction:column;gap:1rem}.header.open nav{margin:1rem 0 0}.header.open .plan{border:0;padding:0}}
</style>
