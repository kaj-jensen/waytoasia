---
import {Picture} from 'astro:assets';
import arashiyama from '../assets/homepage-arashiyama.webp';
import type {Locale} from '../i18n';
const {locale} = Astro.props as {locale:Locale};
const alt = {
 en:'A traditional wooden boat beneath sunlit green maple leaves in Arashiyama, Japan',
 da:'En traditionel træbåd under solbelyste grønne ahornblade i Arashiyama, Japan',
 sv:'En traditionell träbåt under solbelysta gröna lönnlöv i Arashiyama, Japan',
 no:'En tradisjonell trebåt under solbelyste grønne lønneblader i Arashiyama, Japan',
 es:'Una barca tradicional de madera bajo hojas verdes de arce iluminadas por el sol en Arashiyama, Japón',
 fr:'Un bateau traditionnel en bois sous des feuilles vertes d’érable éclairées par le soleil à Arashiyama, au Japon',
 it:'Una barca tradizionale in legno sotto foglie verdi di acero illuminate dal sole ad Arashiyama, in Giappone',
 nl:'Een traditionele houten boot onder zonovergoten groene esdoornbladeren in Arashiyama, Japan',
 hu:'Hagyományos facsónak napsütötte zöld juharlevelek alatt Arashiyamában, Japánban',
}[locale];
---
<div class="nature-hero">
 <Picture class="hero-image" src={arashiyama} widths={[480,800,1200,1600,2400]} sizes="100vw" width={2400} formats={['avif','webp']} quality={82} {alt} loading="eager" fetchpriority="high" />
 <div class="hero-shade" aria-hidden="true"></div>
 <div class="hero-copy-slot"><slot /></div>
</div>
<style>
 .nature-hero{position:relative;isolation:isolate;min-height:clamp(540px,64vw,700px);display:flex;align-items:flex-end;overflow:hidden;background:#10271f}
 .hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:58% 85%;z-index:-2}
 .nature-hero :global(picture){position:absolute;inset:0;z-index:-2}.nature-hero :global(.hero-image){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:58% 85%;z-index:-2}
 .hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(5,22,17,.60) 0%,rgba(5,22,17,.38) 32%,rgba(5,22,17,.02) 66%,rgba(5,22,17,0) 100%),linear-gradient(0deg,rgba(5,22,17,.20),transparent 48%)}
 .hero-copy-slot{width:100%;padding:clamp(52px,7vw,92px) 0}
 .hero-copy-slot :global(.shell){width:var(--page);margin:auto}
 @media(max-width:800px){
  .nature-hero{min-height:620px}
  .nature-hero :global(.hero-image){object-position:65% 80%}
  .hero-shade{background:linear-gradient(0deg,rgba(5,22,17,.70) 0%,rgba(5,22,17,.42) 45%,rgba(5,22,17,0) 78%),linear-gradient(90deg,rgba(5,22,17,.18),transparent 70%)}
  .hero-copy-slot{padding:48px 0}
 }
 @media(max-width:560px){.nature-hero{min-height:560px}.nature-hero :global(.hero-image){object-position:65% 80%}.hero-copy-slot{padding:34px 0}}
</style>
