---
import type {Tour,Country} from '../content/data';
import {tr,localizeContent,localizedPath,type Locale} from '../i18n';
import {formatPrice} from '../lib/format';
import {tourPhotos} from '../content/tourPhotos';
import {tourOverviews} from '../content/tourOverviews';
import {tourPresentation} from '../lib/tourPresentation';
import {journeyGeography} from '../lib/journeyGeography';
import JourneyMediaGallery from './JourneyMediaGallery';
import '../styles/journey-media.css';
import '../styles/tour-product.css';
const {tour,country,locale}=Astro.props as {tour:Tour;country:Country;locale:Locale};
const copy=(s:string,vars:Record<string,string|number>={})=>tr(locale,s,vars);
const localized=localizeContent(locale,tour);
const editorial=tourOverviews[tour.slug];
const overview=locale==='en'||copy(editorial.summary)!==editorial.summary?localizeContent(locale,editorial):{heading:copy('Tour overview'),summary:localized.teaser,reason:''};
const model=tourPresentation(tour);
const geo=journeyGeography(country.slug,model.route);
const enquiry=localizedPath(locale,`/contact?tour=${tour.slug}`);
const sections=[['overview','Overview'],['itinerary','Itinerary & map'],['included','What’s included']];
const entries=model.entries.map(entry=>({...localizeContent(locale,entry),location:entry.location.split(' · ').map(name=>copy(name)).join(' · '),label:copy(tour.dailyItinerary?'Day {day}':'Days {day}',{day:entry.range})}));
const media=tourPhotos[tour.slug].map(({src},i)=>({type:'image' as const,src,caption:copy('{country} · Travel inspiration {number}',{country:copy(country.name),number:i+1}),alt:copy('{country} travel photograph',{country:copy(country.name)})}));
const config={legs:model.legs,paths:model.entries.map(e=>e.points),points:model.points,stops:model.stops.map(stop=>({...stop,name:copy(stop.name)})),labels:entries.map(e=>`${e.label} · ${e.location}`),whole:copy('The whole journey'),expand:copy('Expand all days +'),collapse:copy('Collapse all days −'),open:copy('Enlarge map'),close:copy('Close enlarged map'),error:copy('Detailed map unavailable. The geographic route preview remains available.'),show:copy('Show on map')};
---
<div class="tour-product" data-map-config={JSON.stringify(config)}>
<nav class="journey-nav" aria-label={copy('Tour sections')}><div class="section-links">{sections.map(([id,label])=><a href={`#${id}`}>{copy(label)}</a>)}</div><a class="proposal" href={enquiry}>{copy('Enquire')} ↗</a></nav>
<header class="gallery-hero"><div class="gallery-intro"><a class="eyebrow" href={localizedPath(locale,`/${country.slug}`)}>{copy(country.name)} / {copy(tour.journeyType??'Private tailor-made journey')}</a><h1>{localized.name}</h1><p>{localized.teaser}</p></div><JourneyMediaGallery items={media} name={localized.name} client:load labels={{gallery:copy('Gallery'),view:copy('View gallery'),enlarge:copy('Enlarge photograph'),previous:copy('Previous photograph'),next:copy('Next photograph'),close:copy('Close gallery')}}/>
<aside class="booking-card" aria-label={copy('Tour facts and price')}><p class="eyebrow">{copy(tour.country==='south-korea'?'Illustrative price':'Guide price from')}</p><div class="price">{formatPrice(locale,tour.prices)}</div><p>{copy('per person')}</p><dl><div><dt>{copy('Duration')}</dt><dd>{tour.duration} {copy('days')}</dd></div><div><dt>{copy('Tour type')}</dt><dd>{localized.groupSize}</dd></div><div><dt>{copy('Best time')}</dt><dd>{localized.departures.join(' · ')}</dd></div>{tour.meals&&<div><dt>{copy('Meals')}</dt><dd>{localized.meals}</dd></div>}<div><dt>{copy('Pace')}</dt><dd>{copy(tour.pace??'Thoughtfully balanced')}</dd></div></dl><a class="button" href={enquiry}>{copy('Request a proposal')} ↗</a><small>{localized.priceNote??copy('Final price depends on dates and accommodation.')}</small></aside>
</header>
<div class="prototype-content">
<section id="overview" class="overview tour-section"><div class="overview-intro">{overview.heading!==copy('Tour overview')&&<p class="eyebrow">{copy('Tour overview')}</p>}<h2>{overview.heading}</h2><p class="lead">{overview.summary}</p>{overview.reason&&<p>{overview.reason}</p>}</div><div id="highlights" class="overview-highlights"><p class="highlights-label">{copy('The journey highlights.')}</p><div class="highlight-grid">{tour.itinerary.slice(0,4).map((stage,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{copy(stage.title)}</h3><p>{copy(stage.copy)}</p></article>)}</div></div><div class="route-strip" aria-label={copy('Route')}>{model.route.map((stop,i)=><Fragment>{copy(stop)}{i < model.route.length - 1&&<span>→</span>}</Fragment>)}</div><div id="practical" class="practical-details overview-practical"><details id="stays"><summary>{copy('Accommodation')}</summary><p>{copy('Named properties and room categories are confirmed in your proposal. Comparable alternatives match location, quality and character.')}</p>{localized.accommodation&&<ul class="stay-list">{localized.accommodation.map(stay=><li><b>{stay.place} <span>{stay.nights}</span></b><small>{stay.style}</small></li>)}</ul>}</details><details><summary>{copy('Best time')}</summary><p>{localized.departures.join(' · ')}</p><p>{copy('The itinerary is clear enough to plan from and flexible enough to personalise. Optional activities are identified in your final proposal.')}</p></details><details><summary>{copy('Route & transport')}</summary><ul>{(localized.transport??[copy('All internal transport described')]).map(item=><li>{item}</li>)}</ul><p>{copy('Reserved intercity sectors and transfers are coordinated as one journey. Exact timings and tickets arrive with your final travel documents.')}</p></details><details><summary>{copy('Tailor this journey')}</summary><p>{copy('Use these journeys as a beginning. Every private route can be reshaped around your interests, pace and people.')}</p></details></div></section>
<section id="itinerary" class="tour-section itinerary"><span id="route"></span><div class="section-heading"><div><p class="eyebrow">{copy('Suggested itinerary')}</p><h2>{copy('Follow the journey.')}</h2></div><p>{copy('Select an itinerary section to explore its setting on the map.')}</p></div><div class="itinerary-grid"><div class="days"><div class="days-toolbar"><span>{tour.duration} {copy('days')} · {model.route.length} {copy('stops')}</span><button type="button" data-expand-all>{copy('Expand all days +')}</button></div>{entries.map((day,i)=><details class="day" data-day={i+1} open={i===0}><summary><span class="day-number">{String(i+1).padStart(2,'0')}</span><span><small>{day.label} · {day.location}</small><strong>{day.title}</strong></span><span class="day-toggle" aria-hidden="true">+</span></summary><div class="day-body"><p>{day.summary}</p>{day.activities.length>0&&<ul>{day.activities.map(item=><li>{item}</li>)}</ul>}{day.overnight&&<dl><div><dt>{copy('Overnight')}</dt><dd>{day.overnight}</dd></div><div><dt>{copy('Meals')}</dt><dd>{day.meals}</dd></div><div><dt>{copy('Transport')}</dt><dd>{day.transport}</dd></div></dl>}<button class="show-day" data-show-day={i+1} type="button">{copy('Show on map')} ↗</button></div></details>)}</div>
<aside class="map-card" aria-label={copy('Itinerary & map')}><div class="map-heading"><div><small>{copy('Route')}</small><strong data-map-title>{copy('The whole journey')}</strong></div><button type="button" data-map-expand aria-label={copy('Enlarge map')}>⛶</button></div><div class="map-legend" aria-label={copy('Route & transport')}>{[...new Set(model.legs.flatMap(leg=>leg.modes))].map(mode=><span><i class={mode}></i>{copy({rail:'Train',road:'Private vehicle',flight:'Flight',boat:'Boat'}[mode])}</span>)}</div><div class="map-stage"><svg class="map-fallback" viewBox="0 0 600 420" role="img" aria-label={model.route.map(copyName=>copy(copyName)).join(' → ')}><rect width="600" height="420" fill="#dce9e7"/>{geo.context.map(d=><path d={d} fill="#ecebe2" stroke="#c9cec1"/>)}<path d={geo.land} fill="#f6f2e6" stroke="#82938a"/>{geo.legs.map(d=><path d={d} fill="none" stroke="#bf452f" stroke-width="2" stroke-dasharray="4 4"/>)}{geo.selected.map((p,i)=><g><circle cx={p.x} cy={p.y} r="5" fill="#bf452f"/><text x={p.x+8} y={p.y+(i%2?-10:14)} font-size="11" fill="#183b31">{copy(p.name)}</text></g>)}</svg><div id="journey-live-map" aria-label={copy('Itinerary & map')}></div><p class="map-status" role="status">{copy('Geographic route preview · detailed map loads here')}</p></div><div class="map-controls"><button type="button" data-map-overview>↖ {copy('Whole journey')}</button><div><button type="button" data-map-prev aria-label={copy('Previous itinerary section')}>←</button><button type="button" data-map-next aria-label={copy('Next itinerary section')}>→</button></div></div><p class="map-note"><span></span>{copy('Indicative connections, not exact travel routes. Optional excursions are described in the itinerary.')}</p></aside></div></section>
<section id="included" class="tour-section inclusions"><span id="details"></span><div class="section-heading"><p class="eyebrow">{copy('Important information')}</p><h2>{copy('What’s included')}</h2></div><div class="inclusion-grid"><div><h3>{copy('Included')}</h3><ul>{localized.includes.map(item=><li><span>✓</span>{item}</li>)}</ul></div><div><h3>{copy('Not included')}</h3><ul>{localized.excludes.map(item=><li><span>—</span>{item}</li>)}</ul></div></div></section>

<section class="closing"><p class="eyebrow">{copy('Begin a conversation')}</p><h2>{copy('Make it part of your journey.')}</h2><p>{copy('Each is a starting point, designed to be adjusted in conversation with you.')}</p><a class="button" href={enquiry}>{copy('Request a proposal')} ↗</a></section>
</div></div>
<script>import '../lib/tourProduct';</script>
