---
import {locales,localeNames,localizedPath,type Locale} from '../i18n';
const {locale,path=''}=Astro.props as {locale:Locale;path?:string};
---
<footer><div class="shell top"><div><div class="mark">WAY <i>to</i> ASIA</div><p>Tailor-made and small-group journeys across Asia.</p></div><div><span class="label">Journey</span><a href={localizedPath(locale,'/tours')}>All journeys</a><a href={localizedPath(locale,'/contact')}>Private proposal</a></div><div><span class="label">Studio</span><a href={localizedPath(locale,'/about')}>About us</a><a href={localizedPath(locale,'/contact')}>Contact</a></div><div><span class="label">Languages</span><div class="languages">{locales.map(l=><a class:list={{active:l===locale}} href={localizedPath(l,path)}>{localeNames[l]}</a>)}</div></div></div><div class="shell bottom"><span>© {new Date().getFullYear()} Way to Asia</span><span>Travel with attention.</span><a href="/privacy">Privacy</a></div></footer>
<style>footer{background:#091713;color:var(--cream);padding:5rem 0 2rem}.top{display:grid;grid-template-columns:2fr 1fr 1fr 2fr;gap:3rem}.top>div{display:flex;flex-direction:column;align-items:flex-start;gap:.65rem}.mark{font:500 1.25rem var(--mono);letter-spacing:.09em}.mark i{font:italic 1.2rem var(--display);color:var(--gold)}p{color:rgba(243,238,223,.55);max-width:16rem;font-size:.86rem}.label{font:500 .65rem var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem}.top a{font-size:.84rem;color:rgba(243,238,223,.72)}.languages{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem 1rem}.languages .active{color:var(--gold)}.bottom{display:flex;justify-content:space-between;margin-top:5rem;padding-top:1.3rem;border-top:1px solid rgba(243,238,223,.13);font:400 .62rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(243,238,223,.45)}@media(max-width:800px){.top{grid-template-columns:1fr 1fr}.top>div:first-child,.top>div:last-child{grid-column:1/-1}.bottom{flex-wrap:wrap;gap:1rem}}</style>
