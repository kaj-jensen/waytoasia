---
import {countries} from '../content/data';import {localizedPath,type Locale} from '../i18n';
const {locale}=Astro.props as {locale:Locale};
---
<div class="grid">{countries.map((c,i)=><a id={c.slug} class={`tile t${i+1}`} href={localizedPath(locale,`/${c.slug}`)} aria-label={`Explore ${c.name}`}><img src={c.tile} alt={c.alt} loading={i<2?'eager':'lazy'} decoding="async"><span class="shade"></span><div><small>{c.code} · 0{i+1}</small><h3>{c.name}</h3><p>{c.nativeName}</p><b>Explore ↗</b></div></a>)}</div>
<style>.grid{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:380px 330px;gap:14px}.tile{position:relative;overflow:hidden;color:#fff}.t1,.t2{grid-column:span 6}.t3,.t4,.t5{grid-column:span 4}.tile img,.shade{position:absolute;inset:0;width:100%;height:100%}.tile img{transition:transform .6s cubic-bezier(.2,.7,.2,1)}.tile:hover img{transform:scale(1.055)}.shade{background:linear-gradient(180deg,transparent 25%,rgba(4,16,12,.78))}.tile>div{position:absolute;inset:auto 1.5rem 1.4rem}.tile small,.tile b{font:500 .64rem var(--mono);letter-spacing:.13em;text-transform:uppercase}.tile small{color:var(--gold)}h3{font-size:2.6rem;margin-top:.4rem}.tile p{opacity:.72}.tile b{position:absolute;right:0;bottom:.3rem;opacity:0;transform:translateX(-8px);transition:.3s}.tile:hover b{opacity:1;transform:none}@media(max-width:700px){.grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-right:calc((100vw - var(--page))/ -2);padding-right:20px}.tile{flex:0 0 83vw;height:470px;scroll-snap-align:start}.tile b{opacity:1}}</style>
