---
import TourGallery from './TourGallery';import {countries,type Tour} from '../content/data';import type {Locale} from '../i18n';import {localizedPath,t} from '../i18n';import {formatPrice} from '../lib/format';
const {tour,locale}=Astro.props as {tour:Tour;locale:Locale};
const images=[tour.image,...(countries.find(country=>country.slug===tour.country)?.gallery??[])];
---
<article class="card"><TourGallery client:load {images} name={tour.name}/><a class="card-body" href={localizedPath(locale,`/${tour.country}/tours/${tour.slug}`)}><div class="meta"><span>{tour.country} · {tour.duration} {t(locale,'days')}</span><span class="price">{t(locale,'from')} {formatPrice(locale,tour.prices)}</span></div><h3>{tour.name}</h3><p>{tour.teaser}</p><span class="link">View itinerary ↗</span></a></article>
<style>.card{display:flex;flex-direction:column}.card-body{display:flex;flex:1;flex-direction:column}h3{margin:.8rem 0 .55rem;color:#16231d}.card-body p{color:#52615b;font-size:.88rem;min-height:3.1rem}.link{display:block;margin-top:auto;padding-top:1.25rem;font:500 .67rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--vermilion-dark)}</style>
