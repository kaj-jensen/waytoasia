---
import {getRouteModes,type RouteMode as Mode} from '../content/routeTransport';
import {journeyGeography} from '../lib/journeyGeography';
import type {CountryKey} from '../content/mapCoordinates';
type Locale='en'|'es'|'it'|'fr'|'nl'|'hu'|'sv'|'da'|'no';
const {route=[],stages=[],country='south-korea',locale='en'}=Astro.props as {route:string[];stages?:{day:string;title:string;copy:string}[];country?:CountryKey;locale?:Locale};
const controls:Record<Locale,{open:string;close:string}>={
  en:{open:'View larger map',close:'Close larger map'},es:{open:'Ampliar mapa',close:'Cerrar mapa ampliado'},it:{open:'Ingrandisci mappa',close:'Chiudi mappa ingrandita'},fr:{open:'Agrandir la carte',close:'Fermer la grande carte'},nl:{open:'Kaart vergroten',close:'Grote kaart sluiten'},hu:{open:'Térkép nagyítása',close:'Nagy térkép bezárása'},sv:{open:'Förstora kartan',close:'Stäng den stora kartan'},da:{open:'Forstør kortet',close:'Luk det store kort'},no:{open:'Forstørr kartet',close:'Lukk det store kartet'}
};
const map=journeyGeography(country,route);
const flagX=505;
// A small anchor stays on the actual coordinate when crowded numbered markers
// need displacement. No city coordinate is changed for layout convenience.
const selected: (typeof map.selected[number] & {markerX:number;markerY:number})[]=[];
for(const stop of map.selected){
  const candidates=[{x:stop.x,y:stop.y}];
  for(let ring=1;ring<=4;ring++)for(let index=0;index<12;index++){
    const angle=index*Math.PI/6;
    candidates.push({x:stop.x+Math.cos(angle)*ring*30,y:stop.y+Math.sin(angle)*ring*30});
  }
  const marker=candidates.find(point=>point.x>24&&point.x<576&&point.y>24&&point.y<390&&
    !(point.x<158&&point.y>280)&&
    !(point.x>20&&point.x<110&&point.y<110)&&
    selected.every(other=>Math.hypot(point.x-other.markerX,point.y-other.markerY)>=29))!;
  if(!marker)throw new Error(`Unable to place map marker: ${stop.name}`);
  selected.push({...stop,markerX:marker.x,markerY:marker.y});
}
const modeCopy:Record<Locale,Record<Mode,string>>={
  en:{rail:'Rail',flight:'Flight',road:'Private road',boat:'Boat'},es:{rail:'Tren',flight:'Vuelo',road:'Vehículo privado',boat:'Barco'},it:{rail:'Treno',flight:'Volo',road:'Veicolo privato',boat:'Barca'},fr:{rail:'Train',flight:'Vol',road:'Véhicule privé',boat:'Bateau'},nl:{rail:'Trein',flight:'Vlucht',road:'Privévervoer',boat:'Boot'},hu:{rail:'Vonat',flight:'Repülő',road:'Privát autó',boat:'Hajó'},sv:{rail:'Tåg',flight:'Flyg',road:'Privat bil',boat:'Båt'},da:{rail:'Tog',flight:'Fly',road:'Privat bil',boat:'Båd'},no:{rail:'Tog',flight:'Fly',road:'Privat bil',boat:'Båt'}
};
const modeIcon:Record<Mode,string>={rail:'🚆',flight:'✈',road:'🚙',boat:'⛴'};
const daysCopy:Record<Locale,string>={en:'Days',es:'Días',it:'Giorni',fr:'Jours',nl:'Dagen',hu:'Nap',sv:'Dagar',da:'Dage',no:'Dager'};
const segments=selected.slice(0,-1).map((from,index)=>{
  const to=selected[index+1];
  const modes=getRouteModes(from.name,to.name);
  return{from,to,modes,primary:modes[0],path:map.legs[index]};
});
type Bounds={left:number;right:number;top:number;bottom:number};
const occupied:Bounds[]=[
  ...selected.map(stop=>({left:stop.markerX-16,right:stop.markerX+16,top:stop.markerY-16,bottom:stop.markerY+16})),
  {left:8,right:144,top:290,bottom:420},
  {left:38,right:94,top:28,bottom:94}
];
const overlaps=(a:Bounds,b:Bounds)=>a.left<b.right&&a.right>b.left&&a.top<b.bottom&&a.bottom>b.top;
const labelStops=selected.map((stop,index)=>{
  const width=stop.name.length*12.1+12;
  const preferred=stop.x>=300;
  const candidates=[0,-32,32,-64,64,-96,96,-128,128,-160,160].flatMap(dy=>[preferred,!preferred].flatMap(right=>[26,54,86,118,150,182].map(gap=>{
    const x=stop.markerX+(right?gap:-gap);
    const y=stop.markerY+dy;
    const bounds={left:right?x-4:x-width,right:right?x+width:x+4,top:y-15,bottom:y+15};
    const collisions=occupied.filter(box=>overlaps(bounds,box)).length;
    const outside=bounds.left<8||bounds.right>592||bounds.top<8||bounds.bottom>410;
    return{x,y,right,bounds,score:collisions*10000+(outside?100000:0)+Math.abs(dy)+gap+(right===preferred?0:8)};
  })));
  candidates.sort((a,b)=>a.score-b.score);
  const label=candidates[0];
  occupied.push(label.bounds);
  return{...stop,index,label};
});
const mapNote:Record<Locale,string>={
  en:'Lines show the journey, not exact roads. Regional stops indicate representative locations.',
  sv:'Linjerna visar resrutten, inte exakta vägar. Regionala stopp markeras med representativa platser.',
  da:'Linjerne viser rejsens forløb, ikke præcise veje. Regionale stop vises med repræsentative steder.',
  no:'Linjene viser reiseruten, ikke nøyaktige veier. Regionale stopp viser representative steder.',
  es:'Las líneas indican el itinerario, no las carreteras exactas. Las paradas regionales señalan lugares representativos.',
  fr:'Les lignes indiquent le parcours, pas les routes exactes. Les étapes régionales sont représentées par des lieux indicatifs.',
  it:'Le linee indicano l’itinerario, non le strade esatte. Le tappe regionali indicano località rappresentative.',
  nl:'De lijnen tonen de reisroute, niet de exacte wegen. Regionale stops geven representatieve locaties aan.',
  hu:'A vonalak az útitervet mutatják, nem a pontos utakat. A regionális megállók jelképes helyszíneket jelölnek.',
};
const usedModes=([...new Set(segments.flatMap(segment=>segment.modes))] as Mode[]);
const stageForStop=(index:number)=>stages.find(stage=>stage.title.toLocaleLowerCase().includes(selected[index].name.toLocaleLowerCase()))??stages[Math.min(stages.length-1,Math.floor(index*stages.length/selected.length))];
---
<figure class:list={['journey-map',`map-${country}`]}>
<div class="map-tools"><svg class="map-flag" viewBox={`${flagX-40} 18 80 80`} aria-hidden="true"><defs><clipPath id={`flag-${country}`}><circle cx={flagX} cy="58" r="32"/></clipPath></defs><g class="country-emblem emblem-top" data-country={country} aria-hidden="true"><circle class="emblem-shadow" cx={flagX} cy="61" r="35"/><g clip-path={`url(#flag-${country})`}>{country==='china'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#de2910"/><path d="M0-11l2.6 8h8.4L4.2 2l2.6 8L0 5.1-6.8 10l2.6-8-6.8-5h8.4z" fill="#ffde00" transform={`translate(${flagX-11} 48) scale(.72)`}/></>}{country==='thailand'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#a51931"/><rect x={flagX-34} y="36" width="68" height="44" fill="#f4f5f8"/><rect x={flagX-34} y="44" width="68" height="28" fill="#2d2a4a"/></>}{country==='vietnam'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#da251d"/><path d="M0-13l3 9.5h10L5 2.2l3 9.5L0 5.9l-8 5.8 3-9.5-8-5.7h10z" fill="#ffdf00" transform={`translate(${flagX} 58)`}/></>}{country==='indonesia'&&<><rect x={flagX-34} y="24" width="68" height="34" fill="#ce1126"/><rect x={flagX-34} y="58" width="68" height="34" fill="#fff"/></>}</g><circle class="emblem-border" cx={flagX} cy="58" r="34"/></g></svg><button class="map-toggle" type="button" aria-expanded="false" aria-label={controls[locale].open} data-open-label={controls[locale].open} data-close-label={controls[locale].close}><span aria-hidden="true">↗</span><b>{controls[locale].open}</b></button></div>
<svg class="map-canvas" viewBox="0 0 600 420" role="img" aria-labelledby={`map-title-${country} map-desc-${country}`}>
<title id={`map-title-${country}`}>Illustrated journey route through {map.label}</title>
<desc id={`map-desc-${country}`}>Geographic map showing the route from {route.join(' to ')}. Lines indicate the journey sequence, not exact transport paths.</desc>
<rect class="sea" width="600" height="420"/>
<g class="map-plot">
  {map.context.map(path=><path class="neighbor" d={path}/>)}
  <path class="land" d={map.land}/>
  <path class="graticule" d={map.graticule}/>
</g>
{segments.map(segment=><g class:list={['segment',`mode-${segment.primary}`]}><path class="route-halo" d={segment.path}/><path class="route-line" d={segment.path}/></g>)}
{selected.map(stop=><g class="location-anchor" data-longitude={stop.coordinates[0]} data-latitude={stop.coordinates[1]}><line x1={stop.x} y1={stop.y} x2={stop.markerX} y2={stop.markerY}/><circle cx={stop.x} cy={stop.y} r="2.5"/></g>)}
{labelStops.map(stop=><g class="place-label"><line x1={stop.markerX} y1={stop.markerY} x2={stop.label.x+(stop.label.right?-7:7)} y2={stop.label.y}/><text x={stop.label.x} y={stop.label.y} dominant-baseline="central" text-anchor={stop.label.right?'start':'end'}>{stop.name}</text></g>)}
{selected.map((stop,index)=><g class:list={['stop',{major:index===0||index===selected.length-1}]} transform={`translate(${stop.markerX} ${stop.markerY})`}><circle class="outer" r="11"/><text class="number" y=".35em">{String(index+1).padStart(2,'0')}</text></g>)}
<g class="compass" transform="translate(66 65)"><circle r="24"/><path d="M0-16L5 0 0 16-5 0z"/><text y="-31">N</text></g>
<g class="country-inset" transform="translate(10 298)" aria-hidden="true">
  <rect width="130" height="112" rx="3"/>
  <path class="inset-land" d={map.insetPath}/>
  <path class="inset-route" d={map.insetRoute}/>
  <text x="65" y="106" text-anchor="middle">{map.label}</text>
</g>

</svg>
<ol class="stop-index" aria-label={`Route: ${route.join(' to ')}`}>{selected.map((stop,index)=>{const stage=stageForStop(index);return <li><b>{String(index+1).padStart(2,'0')}</b><span><strong>{stop.name}</strong>{stage&&<small>{daysCopy[locale]} {stage.day}</small>}</span></li>})}</ol>
<ol class="route-overview">{segments.map((segment,index)=><li><span class="leg-number">{String(index+1).padStart(2,'0')}</span><div class="places"><strong>{segment.from.name}</strong><i>→</i><strong>{segment.to.name}</strong></div><div class="modes">{segment.modes.map(mode=><span class={`mode-${mode}`}><i>{modeIcon[mode]}</i>{modeCopy[locale][mode]}</span>)}</div></li>)}</ol>
<figcaption><div class="legend">{usedModes.map(mode=><span class={`mode-${mode}`}><i></i>{modeCopy[locale][mode]}</span>)}</div><small>Indicative route · <a href="https://github.com/topojson/world-atlas">Natural Earth</a></small></figcaption>
<p class="map-note">{mapNote[locale]}</p>
</figure>
<script>
document.querySelectorAll<HTMLElement>('.journey-map').forEach(map=>{const button=map.querySelector<HTMLButtonElement>('.map-toggle');if(!button)return;const close=()=>{map.classList.remove('is-expanded');button.setAttribute('aria-expanded','false');button.setAttribute('aria-label',button.dataset.openLabel??'');button.querySelector('b')!.textContent=button.dataset.openLabel??'';button.querySelector('span')!.textContent='↗';document.body.classList.remove('map-open')};button.addEventListener('click',()=>{if(map.classList.contains('is-expanded')){close();return}map.classList.add('is-expanded');button.setAttribute('aria-expanded','true');button.setAttribute('aria-label',button.dataset.closeLabel??'');button.querySelector('b')!.textContent=button.dataset.closeLabel??'';button.querySelector('span')!.textContent='×';document.body.classList.add('map-open')});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&map.classList.contains('is-expanded'))close()})});
</script>
<style>
.journey-map{--sea:#d7e5e3;--wave:#477f83;--land:#f5eedf;--ink:#17382f;--route:#a93627;--rail:#a93627;--flight:#315c78;--road:#376b4d;--boat:#247a80;position:relative;margin:0;background:var(--sea);padding:clamp(1rem,2.5vw,2rem);box-shadow:0 22px 60px rgba(15,33,28,.16);border:1px solid rgba(15,33,28,.13);overflow:hidden}.map-china{--sea:#d9e1dc;--wave:#738f86;--land:#f3e6ce;--route:#9f2e22}.map-thailand{--sea:#cfe5e1;--wave:#3f8684;--land:#f4e5c9;--route:#a93627}.map-vietnam{--sea:#d7e4dd;--wave:#568679;--land:#f2e8d3;--route:#a63b2c}.map-indonesia{--sea:#c8e0df;--wave:#287a80;--land:#f3dfbd;--route:#a73a2b}.map-tools{display:flex;justify-content:flex-end;margin:0 0 .65rem}.map-toggle{display:flex;align-items:center;gap:.5rem;border:1px solid rgba(16,39,31,.28);background:#fffaf0;color:var(--ink);padding:.6rem .75rem;font:600 .56rem var(--mono);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.map-toggle span{font-size:1rem;line-height:.7}.map-toggle:hover,.map-toggle:focus-visible{background:var(--ink);color:#fff}svg{display:block;width:100%;height:auto;background:var(--sea);color:var(--wave)}.sea{fill:var(--sea)}.wave-field{opacity:.24}.land-shadow{fill:#17392f;opacity:.14;transform:translate(5px,7px)}.land,.islands{fill:var(--land);stroke:var(--ink);stroke-width:1.5}.terrain{fill:none;stroke:#718f83;stroke-width:1.25;opacity:.55}.feature{fill:none;stroke:#4b8782;stroke-width:2;stroke-dasharray:3 5;opacity:.65}.route-halo,.route-line{stroke-linecap:round}.route-halo{stroke:#fffaf0;stroke-width:11}.route-line{stroke-width:4.5}.segment.mode-rail .route-line{stroke:var(--rail)}.segment.mode-flight .route-line{stroke:var(--flight);stroke-dasharray:8 7}.segment.mode-road .route-line{stroke:var(--road);stroke-dasharray:2 6}.segment.mode-boat .route-line{stroke:var(--boat);stroke-dasharray:12 5 2 5}.mode-pin circle{stroke:#fffaf0;stroke-width:2.5}.segment.mode-rail .mode-pin circle{fill:var(--rail)}.segment.mode-flight .mode-pin circle{fill:var(--flight)}.segment.mode-road .mode-pin circle{fill:var(--road)}.segment.mode-boat .mode-pin circle{fill:var(--boat)}.transport-icon{pointer-events:none}.stop .outer{fill:var(--land);stroke:var(--route);stroke-width:3}.stop .core{fill:var(--ink)}.stop.major .outer{fill:var(--route);stroke:var(--land);stroke-width:4}.stop.major .core{fill:var(--land)}.stop text,.country,.compass text{font-family:var(--mono);font-weight:600}.number{font-size:8px;fill:#872a20;text-anchor:middle}.country{font-size:9px;letter-spacing:.24em;fill:#315f56}.compass circle{fill:#f8f1e2dd;stroke:var(--ink)}.compass path{fill:var(--route)}.compass text{text-anchor:middle;font-size:8px;fill:var(--ink)}.journey-map.is-expanded{position:fixed;z-index:1000;inset:2vh 2vw;margin:0;padding:clamp(1rem,2vw,2rem);display:flex;flex-direction:column;background:var(--sea);box-shadow:0 0 0 100vmax rgba(4,17,13,.82);overflow:auto}.journey-map.is-expanded .map-canvas{min-height:0;flex:1}.journey-map.is-expanded .map-toggle span{font-size:1.3rem}.emblem-top{filter:drop-shadow(0 5px 7px rgba(15,33,28,.2))}.emblem-shadow{fill:#17392f;opacity:.16}.emblem-border{fill:none;stroke:#fff8e9;stroke-width:4}
.place-label line{stroke:var(--ink);stroke-width:.8;opacity:.65}.place-label text{font:700 10px var(--mono);fill:var(--ink);paint-order:stroke;stroke:var(--land);stroke-width:3px;stroke-linejoin:round}.stop-index,.route-overview{list-style:none;margin:.8rem 0 0;padding:0;background:#fffaf0;border:1px solid rgba(16,39,31,.2)}.stop-index{display:flex}.stop-index li{flex:1;display:flex;align-items:center;gap:.65rem;padding:.75rem .8rem;border-right:1px solid rgba(16,39,31,.15)}.stop-index li:last-child{border-right:0}.stop-index b{display:grid;place-items:center;flex:0 0 1.65rem;height:1.65rem;border-radius:50%;background:var(--ink);color:#fff;font:600 .52rem var(--mono)}.stop-index span{display:grid;gap:.12rem}.stop-index strong{font:650 .66rem var(--mono);color:var(--ink)}.stop-index small{font:500 .5rem var(--mono);color:#68756f;text-transform:uppercase}.route-overview{display:grid}.route-overview li{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.65rem;padding:.58rem .8rem;border-bottom:1px solid rgba(16,39,31,.14)}.route-overview li:last-child{border-bottom:0}.leg-number{font:600 .52rem var(--mono);color:var(--route)}.places,.modes,.legend,.legend span{display:flex;align-items:center}.places{gap:.6rem;font:600 .61rem var(--mono);color:var(--ink)}.places i{color:var(--route);font-style:normal}.modes{gap:.4rem;flex-wrap:wrap;justify-content:end}.modes span{display:inline-flex;align-items:center;gap:.3rem;min-width:6.8rem;padding:.25rem .4rem;border-left:3px solid currentColor;font:600 .49rem var(--mono);text-transform:uppercase;letter-spacing:.03em}.modes i{font-style:normal}.mode-rail{color:var(--rail)}.mode-flight{color:var(--flight)}.mode-road{color:var(--road)}.mode-boat{color:var(--boat)}figcaption{display:flex;justify-content:space-between;gap:1rem;margin-top:.75rem;padding-top:.75rem;border-top:1px solid #91aaa5;font:600 .56rem var(--mono);letter-spacing:.06em;text-transform:uppercase;color:#21483f}.legend{gap:1rem;flex-wrap:wrap}.legend span{gap:.35rem}.legend i{display:block;width:25px;height:3px;background:currentColor}.legend .mode-flight i{background:repeating-linear-gradient(90deg,currentColor 0 6px,transparent 6px 10px)}.legend .mode-road i{background:repeating-linear-gradient(90deg,currentColor 0 2px,transparent 2px 6px)}.legend .mode-boat i{background:repeating-linear-gradient(90deg,currentColor 0 9px,transparent 9px 12px,currentColor 12px 14px,transparent 14px 18px)}@media(max-width:700px){.country{display:none}.place-label text{font-size:12px}.stop-index{display:grid;grid-template-columns:repeat(2,1fr)}.stop-index li{border-bottom:1px solid rgba(16,39,31,.15)}.route-overview li{grid-template-columns:1.5rem 1fr}.modes{grid-column:2;justify-content:start}figcaption{flex-direction:column}.map-toggle b{display:none}.map-toggle{padding:.55rem}.journey-map.is-expanded{inset:1vh 2vw}.journey-map.is-expanded .map-canvas{flex:none}}
.modes i{display:inline-grid;place-items:center;width:1.25rem;font-size:.85rem;line-height:1}
:global(body.map-open){overflow:hidden}
/* A quiet substrate keeps the journey and direct labels in the foreground. */
.journey-map{--sea:#e7efeb;--land:#faf5e8;padding:clamp(.85rem,2vw,1.6rem);box-shadow:0 12px 32px rgba(15,33,28,.06)}
.land-shadow,.terrain,.feature,.emblem-shadow{display:none}
.land,.islands{stroke:#8ca399;stroke-width:1;vector-effect:non-scaling-stroke}
.emblem-top{filter:none}
.map-tools{align-items:center;justify-content:space-between}
.map-tools .map-flag{width:44px;height:44px;flex:none}
.compass circle{fill:none;stroke:#a0b2a8}.compass path{fill:#587267}
.route-halo{stroke-width:7}.route-line{stroke-width:3}
.mode-leader{stroke:currentColor;stroke-width:.8;opacity:.45}
.stop .outer,.stop.major .outer{fill:#fffaf0;stroke:var(--ink);stroke-width:2}
.stop.major .outer{fill:var(--ink)}
.stop .number{font-size:10px;fill:var(--ink)}.stop.major .number{fill:#fffaf0}
.place-label line{stroke:#6c8277;stroke-width:.8;opacity:.65}
.place-label text{font:600 14px var(--mono);stroke:#faf7ee;stroke-width:5px}
.stop-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
.stop-index li{min-width:0;border-bottom:1px solid rgba(16,39,31,.12)}
.stop-index strong{font-size:.75rem}.stop-index small{font-size:.6rem}
.places{font-size:.7rem;flex-wrap:wrap;gap:.35rem}.modes span{font-size:.58rem}
.map-toggle{min-height:44px;min-width:44px}
@media(max-width:700px){
  .place-label text{font-size:20px}
  .stop .number{font-size:14px}
  .stop .outer{r:14px}
  .mode-pin,.mode-leader{display:none}
  .stop-index li{padding:.65rem .5rem;gap:.4rem}
  .stop-index strong{font-size:.7rem}
  .route-overview li{padding:.65rem .5rem}
  .journey-map.is-expanded .map-canvas{min-height:260px}
}
.map-canvas{border:1px solid #c4d2c8;border-radius:3px;overflow:hidden}
.neighbor{fill:#dce1d6;stroke:#b8c5b9;stroke-width:.65}
.land{fill:#faf6e9;stroke:#92a68e;stroke-width:1.1}
.graticule{fill:none;stroke:#95afa6;stroke-width:.45;opacity:.22}
.route-halo,.route-line{fill:none;stroke-linejoin:round}
.route-halo{stroke:#fffdf7;stroke-width:7}
.route-line{stroke-width:3;stroke-dasharray:6 5}
.location-anchor line{stroke:#536d61;stroke-width:1}
.location-anchor circle{fill:#17382f;stroke:#fffaf0;stroke-width:1}
.country-inset rect{fill:#f3f3e9;stroke:#b9c9bd;stroke-width:.8}
.country-inset .inset-land{fill:#d5ded0;stroke:#8a9f8f;stroke-width:.65}
.country-inset .inset-route{fill:none;stroke:#a93627;stroke-width:1.8}
.country-inset text{font:600 8px var(--mono);letter-spacing:1.3px;fill:#476252}
figcaption a{color:inherit;text-decoration:underline;text-underline-offset:3px}
.map-note{font:400 .65rem/1.55 var(--sans, sans-serif);color:#53675c;margin:.7rem 0 0}
</style>
