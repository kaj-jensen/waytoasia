---
import {getRouteModes,type RouteMode as Mode} from '../content/routeTransport';
type CountryKey='china'|'japan'|'thailand'|'vietnam'|'indonesia';
type Point={x:number;y:number;dx?:number;dy?:number};
type MapConfig={label:string;native:string;land:string;islands?:string;detail:string;points:Record<string,Point>};
type Locale='en'|'es'|'it'|'fr'|'nl'|'hu'|'sv'|'da'|'no';
const {route=[],stages=[],country='japan',locale='en'}=Astro.props as {route:string[];stages?:{day:string;title:string;copy:string}[];country?:CountryKey;locale?:Locale};
const controls:Record<Locale,{open:string;close:string}>={
  en:{open:'View larger map',close:'Close larger map'},es:{open:'Ampliar mapa',close:'Cerrar mapa ampliado'},it:{open:'Ingrandisci mappa',close:'Chiudi mappa ingrandita'},fr:{open:'Agrandir la carte',close:'Fermer la grande carte'},nl:{open:'Kaart vergroten',close:'Grote kaart sluiten'},hu:{open:'Térkép nagyítása',close:'Nagy térkép bezárása'},sv:{open:'Förstora kartan',close:'Stäng den stora kartan'},da:{open:'Forstør kortet',close:'Luk det store kort'},no:{open:'Forstørr kartet',close:'Lukk det store kartet'}
};
const maps:Record<CountryKey,MapConfig>={
  japan:{label:'JAPAN',native:'日本',land:'M526 3c-14 31-28 53-48 72-22 20-22 45-39 66-17 22-39 33-50 57-9 19-3 35-20 48-22 17-52 21-80 38-24 15-42 41-73 50-28 8-56 3-80-7-19-8-33-22-50-29l18-22c18 7 33 8 47 3 23-8 39-27 59-39 22-13 49-18 68-34 18-15 24-39 43-54 19-15 41-20 58-39 17-19 22-44 40-61 19-18 45-28 60-50 12-18 16-39 24-57z',islands:'M120 266c13-8 27-7 39-1l-7 15-27 3zM166 289c12-5 23-2 31 5l-10 11-22-3zM191 248l12-7 10 8-8 9z',detail:'M421 135l17-29 14 20 12-13 18 29M345 199l15-28 13 18 9-9 14 24M259 258l14-25 13 18 10-9 13 22',points:{Tokyo:{x:456,y:112,dx:18},Hakone:{x:405,y:161,dx:18},Kyoto:{x:273,y:226,dx:-16},Naoshima:{x:157,y:255,dx:-16},Teshima:{x:180,y:239,dx:-16,dy:-8},Osaka:{x:246,y:269,dx:18}}},
  china:{label:'CHINA',native:'中国',land:'M75 84l47-35 78 10 45-25 69 23 61-9 41 29 70 5 39 54-15 52 25 43-31 54-56 2-30 38-73-15-38 24-53-11-42 18-47-34-61-6-22-47 22-39-18-46 28-33-5-39 34-25 19-51z',islands:'M493 287l14-3 5 12-9 13-10-8zM459 321l8-2 3 8-8 7z',detail:'M100 115c53 15 92-22 142-4s82-10 128 8M113 262c52-30 102-34 146-5s91 26 141-4M181 84l18 22 17-17 25 27M330 222l19-30 16 22 13-15 20 28',points:{Beijing:{x:420,y:113,dx:18},'Great Wall':{x:373,y:83,dx:-16},Dali:{x:215,y:265,dx:-16},Shaxi:{x:190,y:232,dx:-16},Yunnan:{x:164,y:286,dx:-16}}},
  thailand:{label:'THAILAND',native:'ประเทศไทย',land:'M274 28l58 22 37 47-10 50 30 34-9 41-30 25-3 45-25 29-3 48-25 8-20-36 5-58-26-44 17-54-10-47 23-48-12-44 20-35z',islands:'M294 340l11 14-8 23-12-8zM335 324l12 9-4 16-13-2zM262 360l7 8-5 14-8-6z',detail:'M295 73l13 20 12-15 18 22M284 167c25 15 42 16 65 4M304 245c-13 22-15 45-5 67',points:{Bangkok:{x:313,y:238,dx:18},'Chiang Mai':{x:291,y:100,dx:-16},'Southern islands':{x:300,y:347,dx:-18,dy:-5}}},
  vietnam:{label:'VIETNAM',native:'Việt Nam',land:'M311 26l47 25-5 45-27 37 14 40-17 36 20 44-7 45-31 38-12 43-43 24-42-8 29-27 41-16 25-35 6-38-21-36 18-42-16-42 19-42 10-50z',islands:'M355 331l13 5-4 14-12-2zM391 294l8 3-2 10-8 1z',detail:'M320 68l12 17 12-13 15 21M300 145c22 7 31 21 32 41M278 272c-18 15-35 26-56 32M243 326c37-14 70-12 101 5',points:{Hanoi:{x:329,y:82,dx:18},Hue:{x:306,y:191,dx:18},'Hoi An':{x:318,y:222,dx:18},Saigon:{x:253,y:314,dx:-16},Mekong:{x:205,y:337,dx:-16}}},
  indonesia:{label:'INDONESIA',native:'Nusantara',land:'M66 176l82-9 35 18-22 19-74 2zM207 201l105 13 53 23-31 16-81-6-42-18zM363 145l47-21 54 13 25 30-31 15-62-10zM421 252l66-15 44 13-23 28-68 2z',islands:'M115 137l41-11 31 9-17 15-45 4zM321 176l22-9 14 9-16 12zM519 193l31-9 17 13-26 13zM370 283l24-4 14 14-20 8z',detail:'M108 177l18-27 16 22M257 216l18-34 19 32M425 148l17-31 18 30M447 254c22 8 39 8 63-2',points:{Yogyakarta:{x:270,y:220,dx:-16},Borobudur:{x:248,y:190,dx:-16},Bali:{x:376,y:250,dx:18},Komodo:{x:462,y:266,dx:18}}}
};
Object.assign(maps.china.points,{Shanghai:{x:486,y:244,dx:18},Hangzhou:{x:457,y:260,dx:-16},Huangshan:{x:416,y:273,dx:-16},'Xi’an':{x:330,y:168,dx:18},Chengdu:{x:260,y:214,dx:-16},Lijiang:{x:207,y:257,dx:-16},Guilin:{x:318,y:283,dx:18},Yangshuo:{x:345,y:305,dx:18},Longji:{x:287,y:274,dx:-16}});
Object.assign(maps.japan.points,{Sapporo:{x:507,y:34,dx:-16},Biei:{x:478,y:59,dx:-16},Furano:{x:450,y:82,dx:-16},Shiretoko:{x:548,y:48,dx:18},Fukuoka:{x:105,y:286,dx:-16},Aso:{x:139,y:278,dx:18},Kurokawa:{x:164,y:259,dx:18},Kagoshima:{x:112,y:332,dx:-16},Koyasan:{x:237,y:286,dx:18},Kumano:{x:225,y:316,dx:-16},Ise:{x:271,y:276,dx:18}});
Object.assign(maps.thailand.points,{Ayutthaya:{x:308,y:210,dx:18},Sukhothai:{x:299,y:158,dx:-16},'Chiang Rai':{x:300,y:66,dx:-16},'Golden Triangle':{x:341,y:52,dx:18},'Khao Sok':{x:315,y:303,dx:18},'Koh Yao Noi':{x:337,y:350,dx:18}});
Object.assign(maps.vietnam.points,{'Ninh Binh':{x:316,y:115,dx:-16},'Ha Long':{x:359,y:100,dx:18},'Quy Nhon':{x:314,y:251,dx:18},'Nha Trang':{x:298,y:278,dx:18},'Can Tho':{x:226,y:339,dx:-16},'Chau Doc':{x:188,y:318,dx:-16}});
Object.assign(maps.indonesia.points,{Jakarta:{x:214,y:219,dx:-16},Bromo:{x:316,y:234,dx:18},Ijen:{x:350,y:244,dx:18},Ubud:{x:378,y:238,dx:-16},Sidemen:{x:405,y:252,dx:18},Munduk:{x:360,y:214,dx:-16},Sanur:{x:420,y:263,dx:18},'Labuan Bajo':{x:443,y:255,dx:-16},Flores:{x:505,y:257,dx:18}});
const map=maps[country]??maps.japan;
const flagX=country==='thailand'?492:country==='indonesia'?530:505;
const selected=route.map(name=>({name,...map.points[name]})).filter(stop=>Number.isFinite(stop.x));
const modeCopy:Record<Locale,Record<Mode,string>>={
  en:{rail:'Rail',flight:'Flight',road:'Private road',boat:'Boat'},es:{rail:'Tren',flight:'Vuelo',road:'Vehículo privado',boat:'Barco'},it:{rail:'Treno',flight:'Volo',road:'Veicolo privato',boat:'Barca'},fr:{rail:'Train',flight:'Vol',road:'Véhicule privé',boat:'Bateau'},nl:{rail:'Trein',flight:'Vlucht',road:'Privévervoer',boat:'Boot'},hu:{rail:'Vonat',flight:'Repülő',road:'Privát autó',boat:'Hajó'},sv:{rail:'Tåg',flight:'Flyg',road:'Privat bil',boat:'Båt'},da:{rail:'Tog',flight:'Fly',road:'Privat bil',boat:'Båd'},no:{rail:'Tog',flight:'Fly',road:'Privat bil',boat:'Båt'}
};
const modeIcon:Record<Mode,string>={rail:'🚆',flight:'✈',road:'🚙',boat:'⛴'};
const daysCopy:Record<Locale,string>={en:'Days',es:'Días',it:'Giorni',fr:'Jours',nl:'Dagen',hu:'Nap',sv:'Dagar',da:'Dage',no:'Dager'};
const segments=selected.slice(0,-1).map((from,index)=>{const to=selected[index+1];const modes=getRouteModes(from.name,to.name);return{from,to,modes,primary:modes[0],midX:(from.x+to.x)/2,midY:(from.y+to.y)/2}});
const labelStops=selected.map((stop,index)=>{const right=stop.dx===undefined?stop.x<300:stop.dx>0;const dy=stop.dy??(index%2?25:-21);return{...stop,index,right,dy}});
const stageForStop=(index:number)=>stages.find(stage=>stage.title.toLocaleLowerCase().includes(selected[index].name.toLocaleLowerCase()))??stages[Math.min(stages.length-1,Math.floor(index*stages.length/selected.length))];
---
<figure class:list={['journey-map',`map-${country}`]}>
<div class="map-tools"><button class="map-toggle" type="button" aria-expanded="false" aria-label={controls[locale].open} data-open-label={controls[locale].open} data-close-label={controls[locale].close}><span aria-hidden="true">↗</span><b>{controls[locale].open}</b></button></div>
<svg viewBox="0 0 600 390" role="img" aria-labelledby={`map-title-${country} map-desc-${country}`}>
<title id={`map-title-${country}`}>Illustrated journey route through {map.label}</title>
<desc id={`map-desc-${country}`}>A stylised, not-to-scale map showing the route from {route.join(' to ')}.</desc>
<defs>
  <pattern id={`waves-${country}`} width="34" height="18" patternUnits="userSpaceOnUse"><path d="M0 9c5-5 11-5 17 0s12 5 17 0" fill="none" stroke="currentColor" stroke-width="1"/></pattern>
  <filter id={`shadow-${country}`}><feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#12302a" flood-opacity=".18"/></filter>
  <symbol id={`icon-rail-${country}`} viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="3" width="12" height="15" rx="3"/><path d="M8 7h8v4H8m0 10 2-3m6 3-2-3M7 21h10"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></g></symbol>
  <symbol id={`icon-flight-${country}`} viewBox="0 0 24 24"><path fill="currentColor" d="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V18l-2 1.5V21l3.5-1 3.5 1v-1.5L13 18v-4.5z"/></symbol>
  <symbol id={`icon-road-${country}`} viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10l2-5h10l2 5 2 2v5H3v-5zM7 10h10"/><circle cx="7" cy="14" r="1"/><circle cx="17" cy="14" r="1"/></g></symbol>
  <symbol id={`icon-boat-${country}`} viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h16l-3 6H7zm5-2V4h6v6M3 20c2 1 4 1 6 0 2 1 4 1 6 0 2 1 4 1 6 0"/></g></symbol>
  <clipPath id={`flag-${country}`}><circle cx={flagX} cy="58" r="32"/></clipPath>
</defs>
<rect class="sea" width="600" height="390"/><rect class="wave-field" width="600" height="390" fill={`url(#waves-${country})`}/>
<path class="land-shadow" d={map.land}/><path class="land" d={map.land} filter={`url(#shadow-${country})`}/>{map.islands&&<path class="islands" d={map.islands}/>}<path class="terrain" d={map.detail}/>
{country==='vietnam'&&<path class="feature" d="M326 91c-25 49 27 75-8 117s13 67-50 106"/>}
{country==='thailand'&&<path class="feature" d="M275 278q28 15 56 0t52 0"/>}
{segments.map(segment=><g class:list={['segment',`mode-${segment.primary}`]}><line class="route-halo" x1={segment.from.x} y1={segment.from.y} x2={segment.to.x} y2={segment.to.y}/><line class="route-line" x1={segment.from.x} y1={segment.from.y} x2={segment.to.x} y2={segment.to.y}/><g class="mode-pin" transform={`translate(${segment.midX} ${segment.midY})`}><circle r="10"/><use href={`#icon-${segment.primary}-${country}`} x="-7" y="-7" width="14" height="14"/></g></g>)}
{selected.map((stop,index)=>{const major=index===0||index===selected.length-1;return <g class:list={['stop',{major}]} transform={`translate(${stop.x} ${stop.y})`}><circle class="outer" r={major?13:9}/><circle class="core" r={major?5:3.5}/><text class="number" y={major?-20:-15}>{String(index+1).padStart(2,'0')}</text></g>})}
{labelStops.map(stop=><g class="place-label"><line x1={stop.x} y1={stop.y} x2={stop.x+(stop.right?14:-14)} y2={stop.y+stop.dy*.58}/><text x={stop.x+(stop.right?18:-18)} y={stop.y+stop.dy} text-anchor={stop.right?'start':'end'}>{stop.name}</text></g>)}
<g class="compass" transform="translate(66 65)"><circle r="24"/><path d="M0-16L5 0 0 16-5 0z"/><text y="-31">N</text></g>
<text class="country" x="430" y="355" text-anchor="end">{map.native} · {map.label}</text>
<g class="country-emblem emblem-top" data-country={country} aria-hidden="true"><circle class="emblem-shadow" cx={flagX} cy="61" r="35"/><g clip-path={`url(#flag-${country})`}>{country==='japan'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#fff"/><circle cx={flagX} cy="58" r="13" fill="#bc002d"/></>}{country==='china'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#de2910"/><path d="M0-11l2.6 8h8.4L4.2 2l2.6 8L0 5.1-6.8 10l2.6-8-6.8-5h8.4z" fill="#ffde00" transform={`translate(${flagX-11} 48) scale(.72)`}/></>}{country==='thailand'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#a51931"/><rect x={flagX-34} y="36" width="68" height="44" fill="#f4f5f8"/><rect x={flagX-34} y="44" width="68" height="28" fill="#2d2a4a"/></>}{country==='vietnam'&&<><rect x={flagX-34} y="24" width="68" height="68" fill="#da251d"/><path d="M0-13l3 9.5h10L5 2.2l3 9.5L0 5.9l-8 5.8 3-9.5-8-5.7h10z" fill="#ffdf00" transform={`translate(${flagX} 58)`}/></>}{country==='indonesia'&&<><rect x={flagX-34} y="24" width="68" height="34" fill="#ce1126"/><rect x={flagX-34} y="58" width="68" height="34" fill="#fff"/></>}</g><circle class="emblem-border" cx={flagX} cy="58" r="34"/></g>
</svg>
<ol class="stop-index" aria-label={`Route: ${route.join(' to ')}`}>{selected.map((stop,index)=>{const stage=stageForStop(index);return <li><b>{String(index+1).padStart(2,'0')}</b><span><strong>{stop.name}</strong>{stage&&<small>{daysCopy[locale]} {stage.day}</small>}</span></li>})}</ol>
<ol class="route-overview">{segments.map((segment,index)=><li><span class="leg-number">{String(index+1).padStart(2,'0')}</span><div class="places"><strong>{segment.from.name}</strong><i>→</i><strong>{segment.to.name}</strong></div><div class="modes">{segment.modes.map(mode=><span class={`mode-${mode}`}><i>{modeIcon[mode]}</i>{modeCopy[locale][mode]}</span>)}</div></li>)}</ol>
<figcaption><div class="legend">{(['rail','flight','road','boat'] as Mode[]).map(mode=><span class={`mode-${mode}`}><i></i>{modeCopy[locale][mode]}</span>)}</div><small>Illustrated route · not to scale</small></figcaption>
</figure>
<script>
document.querySelectorAll<HTMLElement>('.journey-map').forEach(map=>{const button=map.querySelector<HTMLButtonElement>('.map-toggle');if(!button)return;const close=()=>{map.classList.remove('is-expanded');button.setAttribute('aria-expanded','false');button.setAttribute('aria-label',button.dataset.openLabel??'');button.querySelector('b')!.textContent=button.dataset.openLabel??'';button.querySelector('span')!.textContent='↗';document.body.classList.remove('map-open')};button.addEventListener('click',()=>{if(map.classList.contains('is-expanded')){close();return}map.classList.add('is-expanded');button.setAttribute('aria-expanded','true');button.setAttribute('aria-label',button.dataset.closeLabel??'');button.querySelector('b')!.textContent=button.dataset.closeLabel??'';button.querySelector('span')!.textContent='×';document.body.classList.add('map-open')});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&map.classList.contains('is-expanded'))close()})});
</script>
<style>
.journey-map{--sea:#d7e5e3;--wave:#477f83;--land:#f5eedf;--ink:#17382f;--route:#a93627;--rail:#a93627;--flight:#315c78;--road:#376b4d;--boat:#247a80;position:relative;margin:0;background:var(--sea);padding:clamp(1rem,2.5vw,2rem);box-shadow:0 22px 60px rgba(15,33,28,.16);border:1px solid rgba(15,33,28,.13);overflow:hidden}.map-china{--sea:#d9e1dc;--wave:#738f86;--land:#f3e6ce;--route:#9f2e22}.map-thailand{--sea:#cfe5e1;--wave:#3f8684;--land:#f4e5c9;--route:#a93627}.map-vietnam{--sea:#d7e4dd;--wave:#568679;--land:#f2e8d3;--route:#a63b2c}.map-indonesia{--sea:#c8e0df;--wave:#287a80;--land:#f3dfbd;--route:#a73a2b}.map-tools{display:flex;justify-content:flex-end;margin:0 0 .65rem}.map-toggle{display:flex;align-items:center;gap:.5rem;border:1px solid rgba(16,39,31,.28);background:#fffaf0;color:var(--ink);padding:.6rem .75rem;font:600 .56rem var(--mono);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.map-toggle span{font-size:1rem;line-height:.7}.map-toggle:hover,.map-toggle:focus-visible{background:var(--ink);color:#fff}svg{display:block;width:100%;height:auto;background:var(--sea);color:var(--wave)}.sea{fill:var(--sea)}.wave-field{opacity:.24}.land-shadow{fill:#17392f;opacity:.14;transform:translate(5px,7px)}.land,.islands{fill:var(--land);stroke:var(--ink);stroke-width:1.5}.terrain{fill:none;stroke:#718f83;stroke-width:1.25;opacity:.55}.feature{fill:none;stroke:#4b8782;stroke-width:2;stroke-dasharray:3 5;opacity:.65}.route-halo,.route-line{stroke-linecap:round}.route-halo{stroke:#fffaf0;stroke-width:11}.route-line{stroke-width:4.5}.segment.mode-rail .route-line{stroke:var(--rail)}.segment.mode-flight .route-line{stroke:var(--flight);stroke-dasharray:8 7}.segment.mode-road .route-line{stroke:var(--road);stroke-dasharray:2 6}.segment.mode-boat .route-line{stroke:var(--boat);stroke-dasharray:12 5 2 5}.mode-pin{color:#fff}.mode-pin circle{stroke:#fffaf0;stroke-width:2}.segment.mode-rail .mode-pin circle{fill:var(--rail)}.segment.mode-flight .mode-pin circle{fil