---
const {route=[]}=Astro.props as {route:string[]};
const points:Record<string,[number,number]>= {Tokyo:[456,112],Hakone:[405,161],Kyoto:[273,226],Naoshima:[157,255],Teshima:[180,239],Osaka:[246,269]};
const selected=route.map(name=>({name,point:points[name]})).filter(stop=>stop.point);
const fallback=selected.map(stop=>stop.point.join(',')).join(' ');
const japanRoute=route.includes('Tokyo')&&route.includes('Osaka');
---
<figure class="journey-map">
<svg viewBox="0 0 600 390" role="img" aria-labelledby="map-title map-desc">
<title id="map-title">Illustrated journey route through Japan</title>
<desc id="map-desc">A stylised map showing the route from {route.join(' to ')}, including rail and ferry connections.</desc>
<defs>
  <pattern id="waves" width="34" height="18" patternUnits="userSpaceOnUse"><path d="M0 9c5-5 11-5 17 0s12 5 17 0" fill="none" stroke="#62959a" stroke-width="1"/></pattern>
  <pattern id="grain" width="7" height="7" patternUnits="userSpaceOnUse"><circle cx="1" cy="2" r=".55" fill="#102820" opacity=".12"/><circle cx="5" cy="6" r=".4" fill="#102820" opacity=".1"/></pattern>
  <filter id="paper"><feTurbulence baseFrequency=".7" numOctaves="2" seed="8" type="fractalNoise" result="n"/><feBlend in="SourceGraphic" in2="n" mode="soft-light"/></filter>
  <filter id="shadow"><feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#12302a" flood-opacity=".18"/></filter>
  <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0l8 4-8 4z" fill="#b43b2b"/></marker>
</defs>
<rect class="sea" x="0" y="0" width="600" height="390"/><rect class="wave-field" x="0" y="0" width="600" height="390"/>
<circle class="sun" cx="505" cy="58" r="37"/><circle class="sun-ring" cx="505" cy="58" r="47"/>
<path class="land-shadow" d="M530 8c-14 31-29 55-50 74-20 18-22 43-38 64-18 24-38 33-49 56-9 19-3 35-20 49-21 17-53 21-79 37-25 15-43 42-75 51-29 8-59 2-84-8-19-8-33-23-50-31l18-28c17 7 34 10 49 5 24-8 39-28 60-40 21-12 50-16 69-33 17-15 23-40 42-55 18-14 42-20 58-38 17-19 22-45 41-62 20-18 47-28 61-51 12-18 15-37 23-55z"/>
<path class="land" d="M526 3c-14 31-28 53-48 72-22 20-22 45-39 66-17 22-39 33-50 57-9 19-3 35-20 48-22 17-52 21-80 38-24 15-42 41-73 50-28 8-56 3-80-7-19-8-33-22-50-29l18-22c18 7 33 8 47 3 23-8 39-27 59-39 22-13 49-18 68-34 18-15 24-39 43-54 19-15 41-20 58-39 17-19 22-44 40-61 19-18 45-28 60-50 12-18 16-39 24-57z"/>
<path class="mountains" d="M421 135l17-29 14 20 12-13 18 29M345 199l15-28 13 18 9-9 14 24M259 258l14-25 13 18 10-9 13 22" />
<path class="islands" d="M120 266c13-8 27-7 39-1l-7 15-27 3zM166 289c12-5 23-2 31 5l-10 11-22-3zM191 248l12-7 10 8-8 9z"/>
<g class="route">
  {japanRoute?<path class="route-halo" d="M456 112C443 128 424 144 405 161S333 207 273 226C230 240 205 248 180 239C172 243 164 248 157 255C183 266 211 272 246 269"/>:<polyline class="route-halo" points={fallback}/>}
  {japanRoute?<path class="route-line" marker-end="url(#arrow)" d="M456 112C443 128 424 144 405 161S333 207 273 226C230 240 205 248 180 239C172 243 164 248 157 255C183 266 211 272 246 269"/>:<polyline class="route-line" points={fallback}/>}
</g>
<g class="transport-icons" aria-hidden="true">
  <g transform="translate(346 190)"><rect x="-8" y="-10" width="16" height="20" rx="5"/><path d="M-5 4h10M-4 13l3-4m5 4L1 9M-4-5h8"/></g>
  <g transform="translate(198 242)"><path d="M-11 2h22l-4 8H-7zM-6 2v-8h9l5 8M-14 14c4-3 8 3 12 0s8 3 12 0"/></g>
</g>
{selected.map((stop,index)=>{const right=stop.name==='Tokyo'||stop.name==='Hakone';const major=index===0||index===selected.length-1;return <g class:list={['stop',{major}]} transform={`translate(${stop.point[0]} ${stop.point[1]})`}><circle class="outer" r={major?13:9}/><circle class="core" r={major?5:3.5}/><text class="number" x="0" y={major?-20:-15}>{String(index+1).padStart(2,'0')}</text><text class="label" x={right?'19':'-16'} y="4" text-anchor={right?'start':'end'}>{stop.name}</text>{major&&<text class="role" x={right?'19':'-16'} y="17" text-anchor={right?'start':'end'}>{index===0?'START':'FINISH'}</text>}</g>})}
<g class="compass" transform="translate(66 65)"><circle r="24"/><path d="M0-16L5 0 0 16-5 0z"/><text x="0" y="-31">N</text></g>
<text class="country" x="374" y="95">日本 · JAPAN</text>
</svg>
<figcaption><span><i></i> Rail journey <i></i> Ferry crossing</span><small>Illustrated route · not to scale</small></figcaption>
</figure>
<style>
.journey-map{margin:0;background:#d7e5e3;padding:clamp(1rem,2.5vw,2rem);box-shadow:0 22px 60px rgba(15,33,28,.16);border:1px solid rgba(15,33,28,.13);overflow:hidden}svg{display:block;width:100%;height:auto;background:#d7e5e3}.sea{fill:#d7e5e3}.wave-field{fill:url(#waves);opacity:.28}.sun{fill:#d4543f;opacity:.88}.sun-ring{fill:none;stroke:#f8f1e2;stroke-width:2;stroke-dasharray:2 5}.land-shadow{fill:#17392f;opacity:.17;transform:translate(5px,7px)}.land{fill:#f5eedf;stroke:#16352c;stroke-width:1.5;filter:url(#paper) url(#shadow)}.islands{fill:#f5eedf;stroke:#16352c;stroke-width:1.2}.mountains{fill:none;stroke:#78958a;stroke-width:1.2;opacity:.48}.route-halo,.route-line{fill:none;stroke-linecap:round;stroke-linejoin:round}.route-halo{stroke:#f8f1e2;stroke-width:10}.route-line{stroke:#b43b2b;stroke-width:3.5;stroke-dasharray:5 6}.transport-icons{fill:#f5eedf;stroke:#17382f;stroke-width:1.4}.stop .outer{fill:#f5eedf;stroke:#b43b2b;stroke-width:2}.stop .core{fill:#17382f}.stop.major .outer{fill:#b43b2b;stroke:#f5eedf;stroke-width:4}.stop.major .core{fill:#f5eedf}.stop text,.country,.compass text{font-family:var(--mono);font-weight:500}.number{font-size:8px;fill:#923125;text-anchor:middle}.label{font-size:11px;fill:#112a22}.role{font-size:6px;letter-spacing:.14em;fill:#923125}.country{font-size:8px;letter-spacing:.28em;fill:#50736b}.compass circle{fill:#f5eedfcc;stroke:#17382f;stroke-width:1}.compass path{fill:#b43b2b}.compass text{text-anchor:middle;font-size:8px;fill:#17382f}figcaption{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;padding-top:.9rem;border-top:1px solid #9eb7b2;font:500 .62rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#23483f}figcaption i{display:inline-block;width:20px;height:2px;margin:0 .45rem 3px 0;background:#b43b2b}figcaption i+ i{height:8px;width:13px;background:none;border-bottom:2px solid #17382f;margin-left:1rem}@media(max-width:650px){.label{font-size:13px}.country{display:none}figcaption{flex-direction:column}}
</style>
