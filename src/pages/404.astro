---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Way to Asia" description="The requested Way to Asia page could not be found." locale="en" path="/404">
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1>This path has wandered.</h1>
    <p>The page you requested could not be found. Return to the journey overview and continue exploring.</p>
    <a class="btn" href="/en/">Return home ↗</a>
  </main>
</BaseLayout>

<style>
  .not-found{min-height:70vh;display:grid;place-content:center;justify-items:start;gap:1rem;max-width:760px;margin:auto;padding:8rem 1.5rem;background:var(--cream);color:var(--ink)}
  h1{font-size:clamp(2.8rem,7vw,5.8rem);line-height:1;margin:0}
  p:not(.eyebrow){max-width:560px;color:#526058;line-height:1.7}
</style>
