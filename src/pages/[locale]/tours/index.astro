---
import {tourPhotos} from '../../../content/tourPhotos';
import BaseLayout from '../../../layouts/BaseLayout.astro';import TourFilter from '../../../components/TourFilter';import {tours} from '../../../content/data';import {formatPrice} from '../../../lib/format';import {locales,localizedPath,tr,type Locale} from '../../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}const {locale}=Astro.props as {locale:Locale};const items=tours.map(x=>({...x,name:tr(locale,x.name),teaser:tr(locale,x.teaser),priceLabel:tr(locale,x.country==='south-korea'?'Illustrative price':'From'),countryLabel:tr(locale,x.country==='south-korea'?'South Korea':x.country),gallery:tourPhotos[x.slug].map(photo=>photo.src),price:formatPrice(locale,x.prices),href:localizedPath(locale,`/${x.country}/tours/${x.slug}`)}));
---
<BaseLayout title="Journeys across Asia — Way to Asia" description="Private and small-group journeys across China, South Korea, Thailand, Vietnam and Indonesia." {locale} path="/tours"><section class="compact-intro"><div class="shell"><h1>Journeys across Asia</h1><p>Use these journeys as a beginning. Every private route can be reshaped around your interests, pace and people.</p></div></section><section class="section section-paper collection-content"><div class="shell"><TourFilter client:load {items} labels={Object.fromEntries(['Destination','All destinations','Duration','Any length','Up to 11 days','12–13 days','14+ days','Travel style','Every style','First journeys','Food & culture','Nature & wild places','Private celebrations','journeys','days','View journey','Gallery','Previous photograph','Next photograph','Show photograph','Travel photograph'].map(s=>[s,tr(locale,s)]))}/></div></section></BaseLayout>
<style>.collection-content{padding-top:0}</style>
