---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripPlanner from '../../components/TripPlanner';
import {locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}
const {locale}=Astro.props as {locale:Locale};
const meta:Record<Locale,{title:string;description:string;eyebrow:string;heading:string;body:string}>={
 en:{title:'AI trip planner — Way to Asia',description:'Create a thoughtful first itinerary idea for Asia with the Way to Asia trip suggestion agent.',eyebrow:'A first idea in a few minutes',heading:'Begin with what matters to you.',body:'Shape an initial journey through Asia, then bring it to our travel designers for the human judgement, local detail and reservations that turn an idea into a real trip.'},
 es:{title:'Planificador de viajes con IA — Way to Asia',description:'Crea una primera idea de itinerario por Asia con el agente de Way to Asia.',eyebrow:'Una primera idea en pocos minutos',heading:'Empieza por lo que te importa.',body:'Da forma a un primer viaje por Asia y llévalo después a nuestros diseñadores para añadir criterio humano, detalles locales y reservas.'},
 it:{title:'Pianificatore di viaggi AI — Way to Asia',description:'Crea una prima idea di itinerario in Asia con l’agente di Way to Asia.',eyebrow:'Una prima idea in pochi minuti',heading:'Inizia da ciò che conta per te.',body:'Dai forma a un primo viaggio in Asia, poi affidalo ai nostri travel designer per il giudizio umano, i dettagli locali e le prenotazioni.'},
 fr:{title:'Planificateur de voyage IA — Way to Asia',description:'Créez une première idée d’itinéraire en Asie avec l’agent de Way to Asia.',eyebrow:'Une première idée en quelques minutes',heading:'Commencez par ce qui compte pour vous.',body:'Esquissez un premier voyage en Asie, puis confiez-le à nos créateurs de voyages pour le regard humain, les détails locaux et les réservations.'},
 nl:{title:'AI-reisplanner — Way to Asia',description:'Maak een eerste reisidee voor Azië met de reisagent van Way to Asia.',eyebrow:'Een eerste idee in enkele minuten',heading:'Begin met wat voor jou belangrijk is.',body:'Geef een eerste reis door Azië vorm en laat onze reisontwerpers daarna menselijk inzicht, lokale details en reserveringen toevoegen.'},
 hu:{title:'AI utazástervező — Way to Asia',description:'Készítsen első ázsiai útitervet a Way to Asia ügynökével.',eyebrow:'Első ötlet néhány perc alatt',heading:'Kezdje azzal, ami Önnek fontos.',body:'Formálja meg első ázsiai útját, majd utazástervezőink emberi megítéléssel, helyi részletekkel és foglalásokkal teszik valósággá.'},
 sv:{title:'AI-reseplanerare — Way to Asia',description:'Skapa ett första reseförslag för Asien med Way to Asias agent.',eyebrow:'En första idé på några minuter',heading:'Börja med det som är viktigt för dig.',body:'Forma en första resa genom Asien och låt sedan våra resedesigner lägga till mänskligt omdöme, lokala detaljer och bokningar.'},
 da:{title:'AI-rejseplanlægger — Way to Asia',description:'Skab et første rejseforslag til Asien med Way to Asias agent.',eyebrow:'Et første forslag på få minutter',heading:'Begynd med det, der betyder noget for dig.',body:'Form en første rejse gennem Asien, og tag den derefter med til vores rejsekonsulenter, som tilføjer menneskelig dømmekraft, lokal indsigt og reservationer.'},
 no:{title:'AI-reiseplanlegger — Way to Asia',description:'Lag et første reiseforslag til Asia med Way to Asias agent.',eyebrow:'Et første forslag på få minutter',heading:'Begynn med det som betyr noe for deg.',body:'Form en første reise gjennom Asia, og la deretter reisedesignerne våre tilføre menneskelig vurdering, lokale detaljer og reservasjoner.'},
};
const page=meta[locale];
---
<BaseLayout title={page.title} description={page.description} {locale} path="/trip-planner"><section class="planner-intro"><div class="shell"><span class="eyebrow">{page.eyebrow}</span><h1>{page.heading}</h1><p>{page.body}</p></div></section><section class="planner-stage"><div class="shell"><TripPlanner client:load {locale}/></div></section></BaseLayout>
<style>
.planner-intro{padding:7.5rem 0 1.4rem;background:var(--paper)}.planner-intro h1{max-width:900px;margin:.55rem 0 .7rem;font-size:clamp(2.2rem,4vw,4.2rem)}.planner-intro p{max-width:790px;color:#4d5953}.planner-stage{padding:0 0 4rem;background:linear-gradient(180deg,var(--paper) 0 11rem,var(--ink) 11rem)}
</style>
<style is:global>
.route-list p{margin-top:.35rem;line-height:1.55}
.route-list small{display:block;margin-top:.8rem;color:var(--vermilion-dark);font:600 .56rem var(--mono);letter-spacing:.08em;text-transform:uppercase}
.route-list ul{margin:.35rem 0 0;padding-left:1.1rem;color:#4d5953;font-size:.76rem}
.route-list ul li{display:list-item;padding:.15rem 0;border:0}
.route-list .onward{margin-top:.8rem;padding:.65rem .75rem;background:#eee5d4;color:#34453d}
.route-list .onward strong{font-family:var(--body);font-size:inherit}
.traveller-research{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3;background:#f1eadc}
.traveller-research>p{margin:.25rem 0 1rem;color:#59655f;font-size:.72rem}
.traveller-research>ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:0;padding:0;list-style:none}
.traveller-research>ul>li{padding:1rem;background:#fffdf8;border:1px solid #d4cbba}
.traveller-research li>span{font-size:.82rem;line-height:1.55}
.traveller-research li div{display:flex;flex-direction:column;gap:.35rem;margin-top:.7rem}
.traveller-research a{color:var(--vermilion-dark);font:.58rem var(--mono);text-decoration:underline;text-underline-offset:3px}
@media(max-width:800px){.traveller-research>ul{grid-template-columns:1fr}}
</style>
<style is:global>
.trip-planner,.trip-result{background:#f8f3e8;color:var(--ink);box-shadow:0 24px 70px #08130f38;border-top:4px solid var(--vermilion)}.trip-planner>header,.trip-result>header{padding:clamp(1.3rem,3vw,2.2rem);border-bottom:1px solid #cfc5b3}.trip-planner h2,.trip-result h2{margin:.5rem 0;font-size:clamp(1.8rem,3vw,2.8rem)}.trip-planner header p,.trip-result header>p{max-width:760px;color:#4d5953}.agent-mark{color:var(--vermilion-dark);font:600 .62rem var(--mono);letter-spacing:.14em;text-transform:uppercase}.planner-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#cfc5b3;border-bottom:1px solid #cfc5b3}.planner-grid>label,.planner-grid>fieldset{display:flex;flex-direction:column;gap:.55rem;min-width:0;padding:1.35rem;background:#f8f3e8;font:600 .65rem var(--mono);letter-spacing:.06em;text-transform:uppercase;border:0;margin:0}.planner-grid .wide{grid-column:1/-1;display:flex;flex-direction:row;flex-wrap:wrap;align-items:center}.planner-grid .prompt-field{flex-direction:column;align-items:stretch}.planner-grid legend{float:left;width:100%;margin-bottom:.3rem}.planner-grid input,.planner-grid select,.planner-grid textarea{border:1px solid #9f9688;background:#fffdf8;padding:.75rem;color:var(--ink)}.planner-grid input:not([type=checkbox]):not([type=range]),.planner-grid select{height:3rem}.planner-grid textarea{width:100%;resize:vertical}.planner-grid output{float:right;color:var(--vermilion-dark);font-size:1.1rem}.inline-fields{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.inline-fields label{display:flex;flex-direction:column;gap:.35rem}.choice{display:inline-flex;align-items:center;gap:.45rem;padding:.55rem .7rem;border:1px solid #aaa193;background:#fffdf8;font:400 .72rem var(--body);text-transform:none;letter-spacing:0}.choice:has(input:checked){border-color:var(--vermilion);background:#f3dfd7}.choice input{width:auto;accent-color:var(--vermilion)}.planner-submit{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.4rem 2rem}.planner-submit p{color:#59655f;font-size:.72rem}.form-error{margin:0 2rem 1.5rem;padding:.8rem 1rem;background:#f3dfd7;color:#7c2418}.result-meta{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.2rem}.result-meta span{padding:.4rem .6rem;background:#ded4c1;font:.58rem var(--mono);text-transform:uppercase}.result-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:1px;background:#cfc5b3}.result-grid>section,.result-grid>aside{background:#f8f3e8;padding:clamp(1.3rem,3vw,2.2rem)}.result-grid h3,.matches h3{font-size:1.15rem;margin-bottom:1rem}.route-list{list-style:none;margin:0;padding:0}.route-list li{display:grid;grid-template-columns:95px 1fr;gap:1rem;padding:1rem 0;border-top:1px solid #d4cbba}.route-list li>span{color:var(--vermilion-dark);font:600 .63rem var(--mono);text-transform:uppercase}.route-list b{font-family:var(--display);font-size:1.12rem}.route-list p{margin-top:.25rem;color:#4d5953;font-size:.8rem}.result-grid aside section+section{margin-top:2rem}.result-grid ul{padding-left:1.2rem;color:#4d5953;font-size:.8rem}.result-grid li+li{margin-top:.55rem}.matches{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3}.matches>div{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.matches a{display:flex;flex-direction:column;padding:1rem;background:#ded4c1}.matches span{color:var(--vermilion-dark);font:.58rem var(--mono);text-transform:uppercase}.matches b{margin:.25rem 0;font-family:var(--display)}.matches small{color:#4d5953}.agent-refinement{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3;background:#e5dac7}.agent-refinement h3{margin:.35rem 0;font-size:1.45rem}.agent-refinement header p{max-width:760px;color:#4d5953;font-size:.8rem}.agent-refinement form{display:grid;grid-template-columns:1fr auto;gap:.7rem;align-items:end;margin-top:1rem}.agent-refinement textarea{min-height:5.5rem;resize:vertical;border:1px solid #9f9688;background:#fffdf8;padding:.8rem;color:var(--ink)}.agent-refinement button{min-height:3rem}.agent-refinement .form-error{margin:1rem 0 0}.closing{padding:0 clamp(1.3rem,3vw,2.2rem) 1.5rem;color:#4d5953}.trip-result footer{display:flex;justify-content:flex-end;gap:.8rem;padding:1.3rem 2rem;border-top:1px solid #cfc5b3}.secondary{padding:.8rem 1rem;border:1px solid #8e877a;background:transparent;color:var(--ink);font:.68rem var(--mono);text-transform:uppercase}
.hbx-check{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3;background:#eee5d4}.hbx-check>header{max-width:760px}.hbx-check h3{margin:.35rem 0;font-size:1.45rem}.hbx-check>header p,.hbx-notice{color:#4d5953;font-size:.78rem}.hbx-check form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1.2rem 0}.hbx-check label{display:flex;flex-direction:column;gap:.35rem;font:600 .62rem var(--mono);letter-spacing:.05em;text-transform:uppercase}.hbx-check input,.hbx-check select{height:2.8rem;border:1px solid #9f9688;background:#fffdf8;padding:.65rem;color:var(--ink)}.hbx-check label small{font:400 .6rem var(--body);letter-spacing:0;text-transform:none}.hbx-check form button{align-self:end;min-height:2.8rem}.availability-results{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin-top:1.2rem}.availability-results>section{padding:1rem;background:#fffdf8;border:1px solid #cfc5b3}.availability-results>section>div{display:flex;justify-content:space-between;gap:.5rem}.availability-results h4{font-family:var(--display)}.availability-results span{color:var(--vermilion-dark);font:.55rem var(--mono);text-transform:uppercase}.availability-results ul{list-style:none;margin:.8rem 0 0;padding:0}.availability-results li{padding:.75rem 0;border-top:1px solid #ded4c1}.availability-results li p,.availability-results>section>p{margin:.25rem 0;color:#4d5953;font-size:.72rem}.availability-results strong{font:600 .7rem var(--mono)}
@media(max-width:800px){.planner-grid,.hbx-check form,.availability-results,.agent-refinement form{grid-template-columns:1fr}.planner-grid .wide{grid-column:auto}.result-grid{grid-template-columns:1fr}.matches>div{grid-template-columns:1fr}.planner-submit,.trip-result footer{align-items:stretch;flex-direction:column}.trip-result footer .btn{width:100%}.route-list li{grid-template-columns:72px 1fr}}
</style>
