---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripPlanner from '../../components/TripPlanner';
import {locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}
const {locale}=Astro.props as {locale:Locale};
const meta:Record<Locale,{title:string;description:string;eyebrow:string;heading:string;body:string}>={
 en:{title:'Journey Designer — Way to Asia',description:'Design a personal Asia itinerary, refine it, and send the complete travel brief to a Way to Asia consultant.',eyebrow:'Journey Designer · From inspiration to a real proposal',heading:'Design a journey worth taking.',body:'Explore a researched route, shape it around your pace and priorities, then send the complete plan to a travel consultant who can turn it into a bookable proposal.'},
 es:{title:'Journey Designer — Way to Asia',description:'Diseña un itinerario personal por Asia, ajústalo y envía el proyecto completo a un asesor de Way to Asia.',eyebrow:'Journey Designer · De la inspiración a una propuesta real',heading:'Diseña un viaje que merezca la pena.',body:'Explora una ruta documentada, adáptala a tu ritmo y prioridades y envía el plan completo a un asesor que pueda convertirlo en una propuesta reservable.'},
 it:{title:'Journey Designer — Way to Asia',description:'Crea un itinerario personale in Asia, perfezionalo e invia il progetto completo a un consulente Way to Asia.',eyebrow:'Journey Designer · Dall’ispirazione a una proposta reale',heading:'Progetta un viaggio che valga la pena vivere.',body:'Esplora un itinerario documentato, modellalo sul tuo ritmo e sulle tue priorità, quindi invia il piano completo a un consulente che potrà trasformarlo in una proposta prenotabile.'},
 fr:{title:'Journey Designer — Way to Asia',description:'Créez un itinéraire personnel en Asie, affinez-le et envoyez le projet complet à un conseiller Way to Asia.',eyebrow:'Journey Designer · De l’inspiration à une proposition concrète',heading:'Imaginez un voyage qui mérite d’être vécu.',body:'Explorez un itinéraire documenté, adaptez-le à votre rythme et à vos priorités, puis transmettez le projet complet à un conseiller qui pourra en faire une proposition réservable.'},
 nl:{title:'Journey Designer — Way to Asia',description:'Ontwerp een persoonlijke reis door Azië, verfijn die en stuur de complete briefing naar een Way to Asia-reisadviseur.',eyebrow:'Journey Designer · Van inspiratie naar een echt voorstel',heading:'Ontwerp een reis die de moeite waard is.',body:'Verken een onderbouwde route, pas die aan je tempo en prioriteiten aan en stuur het complete plan naar een reisadviseur die er een boekbaar voorstel van kan maken.'},
 hu:{title:'Journey Designer — Way to Asia',description:'Tervezzen személyes ázsiai útvonalat, finomítsa, majd küldje el a teljes utazási briefet a Way to Asia tanácsadójának.',eyebrow:'Journey Designer · Az inspirációtól a valódi ajánlatig',heading:'Tervezzen emlékezetes utazást.',body:'Fedezzen fel egy kutatásokkal alátámasztott útvonalat, igazítsa tempójához és prioritásaihoz, majd küldje el a teljes tervet egy tanácsadónak, aki foglalható ajánlattá alakíthatja.'},
 sv:{title:'Journey Designer — Way to Asia',description:'Skapa en personlig Asienresa, förfina den och skicka hela reseunderlaget till en Way to Asia-rådgivare.',eyebrow:'Journey Designer · Från inspiration till ett konkret förslag',heading:'Forma en resa värd att göra.',body:'Utforska en välgrundad rutt, anpassa den efter tempo och prioriteringar och skicka hela planen till en reserådgivare som kan göra den bokningsbar.'},
 da:{title:'Journey Designer — Way to Asia',description:'Design en personlig Asienrejse, tilpas den og send hele rejsebriefen til en Way to Asia-konsulent.',eyebrow:'Journey Designer · Fra inspiration til et konkret tilbud',heading:'Design en rejse, der er værd at tage på.',body:'Udforsk en velresearchet rute, tilpas den til jeres tempo og prioriteter, og send hele planen til en rejsekonsulent, der kan gøre den til et konkret, bestillingsklart tilbud.'},
 no:{title:'Journey Designer — Way to Asia',description:'Design en personlig Asia-reise, tilpass den og send hele reisebriefen til en Way to Asia-konsulent.',eyebrow:'Journey Designer · Fra inspirasjon til et konkret tilbud',heading:'Design en reise som er verdt å ta.',body:'Utforsk en godt undersøkt rute, tilpass den til tempo og prioriteringer, og send hele planen til en reisekonsulent som kan gjøre den til et bestillingsklart tilbud.'},
};
const page=meta[locale];
---
<BaseLayout title={page.title} description={page.description} {locale} path="/trip-planner"><section class="planner-intro"><div class="shell planner-hero"><div><span class="eyebrow">{page.eyebrow}</span><h1>{page.heading}</h1><p>{page.body}</p></div><ol class="planner-path" aria-label="Journey planning process"><li><span>01</span><b>Shape</b><small>Your priorities</small></li><li><span>02</span><b>Explore</b><small>A researched route</small></li><li><span>03</span><b>Convert</b><small>A consultant proposal</small></li></ol></div></section><section class="planner-stage"><div class="shell"><TripPlanner client:load {locale}/></div></section></BaseLayout>
<style>
.planner-intro{padding:8.5rem 0 3rem;background:radial-gradient(circle at 82% 15%,rgba(191,139,75,.16),transparent 24rem),var(--paper)}.planner-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:clamp(2rem,7vw,7rem);align-items:end}.planner-intro h1{max-width:820px;margin:.7rem 0 1rem;font-size:clamp(2.6rem,5vw,5rem);line-height:.96}.planner-intro p{max-width:720px;color:#4d5953;font-size:clamp(1rem,1.7vw,1.18rem);line-height:1.65}.planner-path{display:grid;gap:0;margin:0;padding:0;list-style:none;border-top:1px solid #cfc5b3}.planner-path li{display:grid;grid-template-columns:2.5rem 1fr;column-gap:.7rem;padding:.85rem 0;border-bottom:1px solid #cfc5b3}.planner-path span{grid-row:1/3;color:var(--vermilion-dark);font:.62rem var(--mono)}.planner-path b{font:.9rem var(--display)}.planner-path small{color:#69736e;font:.6rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.planner-stage{padding:0 0 5rem;background:linear-gradient(180deg,var(--paper) 0 8rem,var(--ink) 8rem)}@media(max-width:800px){.planner-intro{padding:6.5rem 0 2rem}.planner-hero{grid-template-columns:1fr;gap:1.5rem}.planner-path{grid-template-columns:repeat(3,1fr)}.planner-path li{display:flex;flex-direction:column;gap:.25rem;padding:.7rem}.planner-path span{grid-row:auto}}
</style>
<style is:global>
.trip-planner,.trip-result{overflow:hidden;border:1px solid rgba(184,171,149,.8);border-top:0;border-radius:3px;background:#fbf8f1;box-shadow:0 32px 90px rgba(3,18,13,.24)}
.trip-planner:before,.trip-result:before{content:"";display:block;height:5px;background:linear-gradient(90deg,var(--vermilion) 0 34%,var(--gold) 34% 66%,#294d41 66%)}
.trip-planner>header{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:clamp(1.5rem,4vw,4rem);align-items:center;padding:clamp(1.6rem,4vw,3rem);background:linear-gradient(135deg,#fbf8f1 60%,#f0e8d9)}
.trip-planner h2,.trip-result h2{letter-spacing:-.025em}
.planner-promise{display:flex;flex-direction:column;padding:1.1rem 1.2rem;background:#153329;color:#f8f3e8;box-shadow:12px 12px 0 #d9cbb2}
.planner-promise b{margin-bottom:.65rem;font:.95rem var(--display)}.planner-promise span{padding:.38rem 0;border-top:1px solid rgba(255,255,255,.16);color:#e6dfd2;font:.58rem var(--mono);letter-spacing:.04em;text-transform:uppercase}
.planner-grid{grid-template-columns:repeat(6,minmax(0,1fr));background:#ddd2c0}.planner-grid>label,.planner-grid>fieldset{grid-column:span 2;padding:1.4rem;background:#fbf8f1}.planner-grid .wide{grid-column:1/-1}.planner-grid>label:focus-within,.planner-grid>fieldset:focus-within{position:relative;z-index:1;background:#fffdf8;box-shadow:inset 0 0 0 1px var(--vermilion)}
.planner-grid input,.planner-grid select,.planner-grid textarea,.agent-refinement textarea,.consultant-handoff input,.consultant-handoff textarea{border-radius:2px;transition:border-color .18s,box-shadow .18s}.planner-grid input:focus,.planner-grid select:focus,.planner-grid textarea:focus,.agent-refinement textarea:focus,.consultant-handoff input:focus,.consultant-handoff textarea:focus{outline:0;border-color:var(--vermilion);box-shadow:0 0 0 3px rgba(167,67,44,.12)}
.choice{border-radius:999px;padding:.62rem .85rem;transition:transform .15s,background .15s,border-color .15s}.choice:hover{transform:translateY(-1px);border-color:#786f62}.choice:has(input:checked){color:#6e251a;box-shadow:inset 0 0 0 1px var(--vermilion)}
.planner-submit{padding:1.25rem clamp(1.4rem,4vw,3rem);background:#f3ecdf}.planner-submit .btn,.result-cta,.consultant-handoff .btn{min-height:3.35rem;padding-inline:1.35rem;box-shadow:0 8px 22px rgba(103,42,26,.2)}
.result-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;padding:clamp(1.7rem,4vw,3.2rem);background:radial-gradient(circle at 90% 10%,rgba(186,132,66,.18),transparent 18rem),#fbf8f1}.result-hero>div>p{max-width:820px;color:#4d5953;font-size:1rem;line-height:1.65}.result-cta{white-space:nowrap;align-self:end}.result-meta span{border:1px solid #d0c4b0;border-radius:999px;background:transparent;padding:.48rem .72rem}
.section-heading{display:flex;align-items:flex-start;gap:.8rem;margin-bottom:1.1rem}.section-heading>span{display:grid;place-items:center;flex:0 0 2rem;height:2rem;border-radius:50%;background:#17382d;color:#fff;font:.56rem var(--mono)}.section-heading h3{margin:.18rem 0 0}.traveller-research .section-heading p{margin:.2rem 0 0;color:#59655f;font-size:.72rem}
.result-grid{grid-template-columns:minmax(0,1.55fr) minmax(280px,.65fr);background:#ddd2c0}.result-grid>section,.result-grid>aside{padding:clamp(1.5rem,4vw,3rem);background:#fbf8f1}.result-grid>aside{background:#eee5d6}.result-grid>aside>*{position:sticky;top:1.5rem}.result-grid>aside .proposal-card{top:auto}
.insight-card{padding:1.3rem;border:1px solid #cfc2ad;background:#fffdf8}.insight-card>span{display:block;margin-bottom:1rem;color:var(--vermilion-dark);font:.62rem var(--mono)}.insight-card h3{margin-bottom:.7rem}.insight-card section+section{margin-top:1.6rem;padding-top:1.4rem;border-top:1px solid #ddd2c0}.insight-card ul{margin:0;padding-left:1.1rem}
.proposal-card{display:grid!important;grid-template-columns:1fr auto;gap:.35rem 1rem;margin-top:1rem!important;padding:1.2rem;background:#17382d;color:#fff}.proposal-card small{grid-column:1/-1;color:#d8ded9;line-height:1.45}.proposal-card strong{font:1rem var(--display)}.proposal-card>span{color:var(--gold);font-size:1.2rem}
.route-list li{grid-template-columns:105px 1fr;padding:1.3rem 0}.route-list li:first-child{border-top:0}.route-list li>span{padding-top:.25rem}.route-list b{font-size:1.25rem}.route-list p{font-size:.86rem}.route-list .onward{border-left:3px solid var(--gold);background:#f2eadc}
.journey-builder{padding:clamp(1.5rem,4vw,3rem);border-top:1px solid #cfc5b3;background:#f7f1e5}.journey-builder>header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;padding-bottom:1.5rem;border-bottom:1px solid #d4c8b5}.journey-builder h3{margin:.4rem 0;font-size:clamp(1.8rem,3vw,3rem)}.journey-builder header p,.builder-heading p{max-width:760px;color:#56625c;line-height:1.55}.builder-progress{display:grid;grid-template-columns:auto 1fr;gap:.15rem .6rem;align-items:end;min-width:210px}.builder-progress strong{font:2rem var(--display);color:var(--vermilion-dark)}.builder-progress span{padding-bottom:.35rem;color:#59655f;font:.58rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.builder-progress progress{grid-column:1/-1;width:100%;height:.35rem;border:0;accent-color:var(--vermilion)}.builder-block{padding-top:2rem}.builder-block+.builder-block{margin-top:2rem;border-top:1px solid #d4c8b5}.builder-heading{display:flex;gap:.8rem;align-items:flex-start;margin-bottom:1.2rem}.builder-heading>span{display:grid;place-items:center;flex:0 0 2rem;height:2rem;border-radius:50%;background:#17382d;color:#fff;font:.56rem var(--mono)}.builder-heading h4{margin:0;font:1.45rem var(--display)}.builder-heading p{margin:.25rem 0 0;font-size:.78rem}.stay-list,.day-list{display:grid;gap:1rem}.stay-choice,.day-choice{min-width:0;margin:0;padding:1.2rem;border:1px solid #cfc2ad;background:#fffdf8}.stay-choice>legend,.day-choice>legend{display:flex;align-items:center;gap:.75rem;padding:0 .45rem}.stay-choice>legend b,.day-choice>legend b{font:1.1rem var(--display)}.stay-choice>legend span,.day-choice>legend>span{color:var(--vermilion-dark);font:.58rem var(--mono);letter-spacing:.06em;text-transform:uppercase}.hotel-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.hotel-card,.day-option{position:relative;display:flex;min-width:0;border:1px solid #d2c7b5;background:#fbf8f1;cursor:pointer;transition:transform .15s,border-color .15s,box-shadow .15s}.hotel-card{flex-direction:column;padding:1rem}.hotel-card:hover,.day-option:hover{transform:translateY(-2px);border-color:#8e7563;box-shadow:0 10px 25px rgba(35,45,39,.08)}.hotel-card:has(input:checked),.day-option:has(input:checked){border-color:var(--vermilion);box-shadow:inset 0 0 0 1px var(--vermilion)}.hotel-card>input,.day-option>input{position:absolute;opacity:0}.selection-mark{position:absolute;right:.7rem;top:.7rem;display:grid;place-items:center;width:1.45rem;height:1.45rem;border:1px solid #a79c8b;border-radius:50%;color:transparent}.hotel-card:has(input:checked) .selection-mark,.day-option:has(input:checked) .selection-mark{border-color:var(--vermilion);background:var(--vermilion);color:#fff}.hotel-card>small,.day-option small{padding-right:1.7rem;color:var(--vermilion-dark);font:.55rem var(--mono);letter-spacing:.06em;text-transform:uppercase}.hotel-card>strong,.day-option strong{margin:.35rem 0;font:1.08rem var(--display)}.hotel-card>p,.day-option p{margin:.2rem 0;color:#4d5953;font-size:.75rem;line-height:1.5}.hotel-card dl{margin:.7rem 0 0}.hotel-card dl div{padding:.55rem 0;border-top:1px solid #ddd2c0}.hotel-card dt{font:600 .53rem var(--mono);letter-spacing:.07em;text-transform:uppercase}.hotel-card dd{margin:.2rem 0 0;color:#4d5953;font-size:.7rem;line-height:1.45}.hotel-card>em{margin-top:auto;padding-top:.8rem;color:var(--vermilion-dark);font:600 .58rem var(--mono);text-transform:uppercase}.option-sources{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.65rem}.option-sources span{width:100%;color:#6a746f;font:.52rem var(--mono);text-transform:uppercase}.option-sources a{color:var(--vermilion-dark);font:.55rem var(--mono);text-decoration:underline;text-underline-offset:2px}.custom-choice{display:grid;grid-template-columns:auto 1fr;gap:.55rem;margin-top:.75rem;padding:.85rem;border:1px dashed #a79c8b;background:#f7f1e5;color:#34453d;font-size:.75rem}.custom-choice textarea{grid-column:1/-1;width:100%;padding:.65rem;border:1px solid #b4a997;background:#fffdf8;color:var(--ink);resize:vertical}.day-choice>legend div{display:flex;flex-direction:column}.day-choice>legend small{color:#66716b;font-size:.65rem}.day-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.day-option{padding:1rem}.day-option>div{display:flex;flex-direction:column;min-width:0}.day-option em{margin-top:auto;padding-top:.55rem;color:#5c665f;font-size:.66rem;line-height:1.45}.day-alternatives{display:grid;grid-template-columns:1fr 2fr;gap:.75rem;margin-top:.75rem}.day-alternatives>label:first-child{display:flex;gap:.5rem;align-items:center;padding:.85rem;border:1px dashed #a79c8b;background:#f7f1e5;font-size:.72rem}.day-alternatives .custom-choice{margin:0}
.traveller-research{padding:clamp(1.5rem,4vw,3rem);background:#f4eee3}.traveller-research>ul>li{position:relative;padding:1.25rem;border:0;border-top:3px solid #bd8a50;box-shadow:0 10px 30px rgba(33,42,37,.07)}
.agent-refinement{display:grid;grid-template-columns:minmax(250px,.65fr) minmax(0,1.35fr);gap:2rem;padding:clamp(1.5rem,4vw,3rem);background:#e7dcc9}.agent-refinement form{margin:0}.agent-refinement header p{line-height:1.55}
.matches{padding:clamp(1.5rem,4vw,3rem);background:#fbf8f1}.matches a{border-top:3px solid #bd8a50;background:#eee5d6;transition:transform .15s,box-shadow .15s}.matches a:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(33,42,37,.1)}
.consultant-handoff{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.15fr);gap:clamp(2rem,5vw,5rem);padding:clamp(2rem,5vw,4rem);background:radial-gradient(circle at 15% 15%,rgba(191,139,75,.18),transparent 22rem),#102d24}.consultant-handoff h3{font-size:clamp(2rem,3.4vw,3.25rem);line-height:1.02}.handoff-story>p{max-width:580px;color:#d4ddd7;line-height:1.65}.handoff-includes{display:flex;flex-direction:column;gap:.55rem;margin:1.5rem 0;padding:1.1rem 0;border-block:1px solid rgba(255,255,255,.17)}.handoff-includes b{margin-bottom:.15rem;color:var(--gold);font:.62rem var(--mono);letter-spacing:.12em;text-transform:uppercase}.handoff-includes span{color:#eff2ef;font-size:.78rem}.handoff-story ol{margin:1.3rem 0 0;padding:0;list-style:none}.handoff-story li{display:grid;grid-template-columns:2rem 1fr;gap:.6rem;align-items:center;padding:.55rem 0;color:#d4ddd7;font-size:.76rem}.handoff-story li span{display:grid;place-items:center;width:1.65rem;height:1.65rem;border:1px solid rgba(255,255,255,.28);border-radius:50%;color:var(--gold);font:.56rem var(--mono)}
.handoff-panel{align-self:start;padding:clamp(1.2rem,3vw,2rem);background:#f8f3e8;color:var(--ink);box-shadow:16px 16px 0 rgba(191,139,75,.22)}.consultant-handoff form{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:0}.consultant-handoff label{min-width:0}.consultant-handoff label:nth-of-type(n+3),.consultant-handoff .consent,.consultant-handoff .btn,.consultant-handoff .form-error{grid-column:1/-1}.consultant-handoff input,.consultant-handoff textarea{width:100%;border-color:#b9ad9c}.consultant-handoff .btn{justify-self:stretch}.consultant-handoff .consent{color:#4d5953}.handoff-success{margin:0;padding:1.2rem;border-left:4px solid #4d8a65}.trip-result footer{background:#f3ecdf}
@media(max-width:900px){.trip-planner>header,.result-hero,.agent-refinement,.consultant-handoff,.journey-builder>header{grid-template-columns:1fr}.result-cta{justify-self:start}.planner-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.planner-grid>label,.planner-grid>fieldset{grid-column:span 1}.planner-grid .wide{grid-column:1/-1}.result-grid{grid-template-columns:1fr}.result-grid>aside>*{position:static}.consultant-handoff form{grid-template-columns:1fr}.consultant-handoff label,.consultant-handoff label:nth-of-type(n+3),.consultant-handoff .consent,.consultant-handoff .btn{grid-column:auto}}
@media(max-width:700px){.hotel-options,.day-options,.day-alternatives{grid-template-columns:1fr}.builder-progress{min-width:0}.stay-choice,.day-choice{padding:.9rem}}
@media(max-width:580px){.planner-grid{grid-template-columns:1fr}.planner-grid>label,.planner-grid>fieldset,.planner-grid .wide{grid-column:1}.planner-promise{box-shadow:8px 8px 0 #d9cbb2}.result-hero{gap:1.25rem}.result-cta{width:100%}.route-list li{grid-template-columns:1fr;gap:.45rem}.route-list li>span{display:inline-flex;width:max-content;padding:.35rem .55rem;border-radius:999px;background:#eadfcd}.traveller-research>ul{grid-template-columns:1fr}.handoff-panel{box-shadow:8px 8px 0 rgba(191,139,75,.22)}.journey-builder{padding:1rem}.stay-choice>legend,.day-choice>legend{align-items:flex-start;flex-direction:column;gap:.2rem}}
</style>
<style is:global>
.route-list p{margin-top:.35rem;line-height:1.55}
.route-list small{display:block;margin-top:.8rem;color:var(--vermilion-dark);font:600 .56rem var(--mono);letter-spacing:.08em;text-transform:uppercase}
.route-list ul{margin:.35rem 0 0;padding-left:1.1rem;color:#4d5953;font-size:.76rem}
.route-list ul li{display:list-item;padding:.15rem 0;border:0}
.route-list .onward{margin-top:.8rem;padding:.65rem .75rem;background:#eee5d4;color:#34453d}
.route-list .onward strong{font-family:var(--body);font-size:inherit}
.traveller-research{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3;background:#f1eadc}
.traveller-research>p{margin:.25rem 0 1rem;color:#59655f;font-size:.72rem}
.traveller-research>ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:0;padding:0;list-style:none}
.traveller-research>ul>li{min-width:0;padding:1rem;background:#fffdf8;border:1px solid #d4cbba}
.traveller-research li>span{font-size:.82rem;line-height:1.55}
.traveller-research li div{display:flex;flex-direction:column;gap:.35rem;margin-top:.7rem}
.traveller-research a{max-width:100%;color:var(--vermilion-dark);font:.58rem var(--mono);overflow-wrap:anywhere;text-decoration:underline;text-underline-offset:3px}
@media(max-width:800px){.traveller-research>ul{grid-template-columns:1fr}}
</style>
<style is:global>
@layer legacy {
.trip-planner,.trip-result{background:#f8f3e8;color:var(--ink);box-shadow:0 24px 70px #08130f38;border-top:4px solid var(--vermilion)}.trip-planner>header,.trip-result>header{padding:clamp(1.3rem,3vw,2.2rem);border-bottom:1px solid #cfc5b3}.trip-planner h2,.trip-result h2{margin:.5rem 0;font-size:clamp(1.8rem,3vw,2.8rem)}.trip-planner header p,.trip-result header>p{max-width:760px;color:#4d5953}.agent-mark{color:var(--vermilion-dark);font:600 .62rem var(--mono);letter-spacing:.14em;text-transform:uppercase}.planner-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#cfc5b3;border-bottom:1px solid #cfc5b3}.planner-grid>label,.planner-grid>fieldset{display:flex;flex-direction:column;gap:.55rem;min-width:0;padding:1.35rem;background:#f8f3e8;font:600 .65rem var(--mono);letter-spacing:.06em;text-transform:uppercase;border:0;margin:0}.planner-grid .wide{grid-column:1/-1;display:flex;flex-direction:row;flex-wrap:wrap;align-items:center}.planner-grid .prompt-field{flex-direction:column;align-items:stretch}.planner-grid legend{float:left;width:100%;margin-bottom:.3rem}.planner-grid input,.planner-grid select,.planner-grid textarea{border:1px solid #9f9688;background:#fffdf8;padding:.75rem;color:var(--ink)}.planner-grid input:not([type=checkbox]):not([type=range]),.planner-grid select{height:3rem}.planner-grid textarea{width:100%;resize:vertical}.planner-grid output{float:right;color:var(--vermilion-dark);font-size:1.1rem}.inline-fields{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.inline-fields label{display:flex;flex-direction:column;gap:.35rem}.choice{display:inline-flex;align-items:center;gap:.45rem;padding:.55rem .7rem;border:1px solid #aaa193;background:#fffdf8;font:400 .72rem var(--body);text-transform:none;letter-spacing:0}.choice:has(input:checked){border-color:var(--vermilion);background:#f3dfd7}.choice input{width:auto;accent-color:var(--vermilion)}.planner-submit{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.4rem 2rem}.planner-submit p{color:#59655f;font-size:.72rem}.form-error{margin:0 2rem 1.5rem;padding:.8rem 1rem;background:#f3dfd7;color:#7c2418}.result-meta{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.2rem}.result-meta span{padding:.4rem .6rem;background:#ded4c1;font:.58rem var(--mono);text-transform:uppercase}.result-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:1px;background:#cfc5b3}.result-grid>section,.result-grid>aside{background:#f8f3e8;padding:clamp(1.3rem,3vw,2.2rem)}.result-grid h3,.matches h3{font-size:1.15rem;margin-bottom:1rem}.route-list{list-style:none;margin:0;padding:0}.route-list li{display:grid;grid-template-columns:95px 1fr;gap:1rem;padding:1rem 0;border-top:1px solid #d4cbba}.route-list li>span{color:var(--vermilion-dark);font:600 .63rem var(--mono);text-transform:uppercase}.route-list b{font-family:var(--display);font-size:1.12rem}.route-list p{margin-top:.25rem;color:#4d5953;font-size:.8rem}.result-grid aside section+section{margin-top:2rem}.result-grid ul{padding-left:1.2rem;color:#4d5953;font-size:.8rem}.result-grid li+li{margin-top:.55rem}.matches{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3}.matches>div{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.matches a{display:flex;flex-direction:column;padding:1rem;background:#ded4c1}.matches span{color:var(--vermilion-dark);font:.58rem var(--mono);text-transform:uppercase}.matches b{margin:.25rem 0;font-family:var(--display)}.matches small{color:#4d5953}.agent-refinement{padding:clamp(1.3rem,3vw,2.2rem);border-top:1px solid #cfc5b3;background:#e5dac7}.agent-refinement h3{margin:.35rem 0;font-size:1.45rem}.agent-refinement header p{max-width:760px;color:#4d5953;font-size:.8rem}.agent-refinement form{display:grid;grid-template-columns:1fr auto;gap:.7rem;align-items:end;margin-top:1rem}.agent-refinement textarea{min-height:5.5rem;resize:vertical;border:1px solid #9f9688;background:#fffdf8;padding:.8rem;color:var(--ink)}.agent-refinement 