---
import BaseLayout from '../../layouts/BaseLayout.astro';import RouteMap from '../../components/RouteMap.astro';import DestinationGrid from '../../components/DestinationGrid.astro';import TourCard from '../../components/TourCard.astro';import {locales,localizedPath,t,type Locale} from '../../i18n';import {tours} from '../../content/data';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))} const {locale}=Astro.props as {locale:Locale};
---
<BaseLayout title="Way to Asia — Tailor-made journeys" description="Private and curated small-group journeys across China, Japan, Thailand, Vietnam and Indonesia." {locale} path="/">
 <section class="hero"><img src="https://images.unsplash.com/photo-1493780474015-ba834fd0ce2f?auto=format&fit=crop&w=2200&q=88" alt="Terraced green landscape in Asia" fetchpriority="high"><div class="veil"></div><div class="shell hero-copy"><span class="eyebrow">{t(locale,'heroEyebrow')}</span><h1>{t(locale,'heroTitle')}</h1><p>{t(locale,'heroBody')}</p><div class="hero-actions"><a class="btn" href="#destinations">{t(locale,'explore')} ↓</a><a class="btn outline" href={localizedPath(locale,'/contact')}>Request a proposal ↗</a></div></div><div class="shell route-wrap"><RouteMap /></div></section>
 <section id="destinations" class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">01 · Destinations</span><h2>{t(locale,'destinations')}</h2></div><p>Each route begins with a place, but unfolds through people: guides, cooks, makers and hosts who let us see their home with greater attention.</p></div><DestinationGrid {locale}/></div></section>
 <section class="section section-dark flagship"><div class="shell split"><div class="visual"><img src="https://images.unsplash.com/photo-1528360983277-13d401cdc186?auto=format&fit=crop&w=1400&q=86" alt="Cherry blossom framing a Japanese temple" loading="lazy"><span>PEK → NRT → BKK → SGN → DPS</span></div><div class="copy"><span class="eyebrow">02 · {t(locale,'featured')}</span><h2>The Long Way East</h2><p class="lead">Five countries. Thirty-two days. One unfolding conversation between ancient routes and contemporary Asia.</p><div class="stat"><b>32</b><span>days<br>designed to breathe</span></div><div class="stat"><b>05</b><span>countries<br>connected with purpose</span></div><a class="btn" href={localizedPath(locale,'/contact')}>Join the 2027 list ↗</a></div></div></section>
 <section class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">03 · Selected journeys</span><h2>Begin with an idea.</h2></div><a class="btn" href={localizedPath(locale,'/tours')}>View all journeys ↗</a></div><div class="cards">{tours.slice(0,3).map(tour=><TourCard {tour} {locale}/>)}</div></div></section>
 <section class="testimony"><div class="shell"><span class="eyebrow">04 · In good company</span><blockquote>“Every day felt considered, but never over-planned. We returned with the rare feeling that we had actually been somewhere.”</blockquote><p>— Eleanor & Martin · Japan, October 2025</p></div></section>
 <section class="section newsletter"><div class="shell news-grid"><div><span class="eyebrow">{t(locale,'newsletter')}</span><h2>Stories worth taking time over.</h2></div><form action="/api/lead" method="POST"><input type="hidden" name="locale" value={locale}><label for="email">{t(locale,'email')}</label><div><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com"><button class="btn" type="submit">{t(locale,'submit')} ↗</button></div><small>Occasional field notes. No noise.</small></form></div></section>
</BaseLayout>
<style>.hero{height:min(940px,100svh);min-height:720px;background:var(--ink);color:var(--cream);position:relative;display:flex;align-items:center}.hero>img,.veil{position:absolute;inset:0;width:100%;height:100%}.hero>img{object-fit:cover}.veil{background:linear-gradient(90deg,rgba(5,18,14,.85),rgba(5,18,14,.15) 68%),linear-gradient(0deg,rgba(5,18,14,.72),transparent 45%)}.hero-copy{position:relative;padding-top:5rem}.hero h1{max-width:900px;margin:.7rem 0 1.4rem}.hero-copy>p{max-width:560px;font-size:1.08rem;color:rgba(243,238,223,.82)}.hero-actions{display:flex;gap:.8rem;margin-top:2.3rem}.route-wrap{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%)}.split{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(3rem,7vw,8rem);align-items:center}.visual{position:relative}.visual img{width:100%;aspect-ratio:4/5}.visual span{position:absolute;right:-2rem;bottom:2rem;background:var(--gold);color:var(--ink);padding:1rem;font:500 .63rem var(--mono);letter-spacing:.1em}.copy h2{margin:.7rem 0 1.4rem}.lead{font:400 1.18rem/1.65 var(--display);color:rgba(243,238,223,.78);margin-bottom:2rem}.stat{display:flex;align-items:center;gap:1.3rem;border-top:1px solid rgba(243,238,223,.18);padding:1.1rem 0}.stat b{font:500 2rem var(--mono);color:var(--gold)}.stat span{font-size:.75rem;color:rgba(243,238,223,.6)}.copy .btn{margin-top:1.5rem}.testimony{background:var(--jade);color:var(--ink);padding:8rem 0;text-align:center}.testimony blockquote{font:500 clamp(2rem,5vw,4.6rem)/1.15 var(--display);max-width:1050px;margin:1.5rem auto}.testimony p{font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.1em}.newsletter{background:var(--ink-2);color:var(--cream)}.news-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:end}.news-grid h2{margin-top:.6rem}.news-grid label{display:block;font:.67rem var(--mono);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.6rem}.news-grid form>div{display:flex}.news-grid input{flex:1;min-width:0;background:transparent;border:1px solid rgba(243,238,223,.4);color:#fff;padding:1rem}.news-grid small{display:block;margin-top:.7rem;color:rgba(243,238,223,.45)}@media(max-width:800px){.hero{min-height:760px}.hero h1{font-size:3.8rem}.route-wrap{bottom:1.2rem}.split,.news-grid{grid-template-columns:1fr}.visual span{right:0}.section-head .btn{justify-self:start}.news-grid{gap:2rem}.news-grid form>div{flex-direction:column;gap:.7rem}}</style>
