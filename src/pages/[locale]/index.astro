---
import BaseLayout from '../../layouts/BaseLayout.astro';import RouteMap from '../../components/RouteMap.astro';import DestinationGrid from '../../components/DestinationGrid.astro';import TourCard from '../../components/TourCard.astro';import {locales,localizedPath,t,tr,localizeContent,type Locale} from '../../i18n';import {countries,journeyStyles,tours} from '../../content/data';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))} const {locale}=Astro.props as {locale:Locale};const displayCountries=localizeContent(locale,countries);const displayStyles=localizeContent(locale,journeyStyles);const displayTours=localizeContent(locale,tours);
---
<BaseLayout title="Way to Asia — Tailor-made journeys" description="Private and curated small-group journeys across China, Japan, Thailand, Vietnam and Indonesia." {locale} path="/">
 <section class="hero"><img src="https://images.unsplash.com/photo-1493780474015-ba834fd0ce2f?auto=format&fit=crop&w=2200&q=88" alt={tr(locale,'Terraced green landscape in Asia')} fetchpriority="high"><div class="veil"></div><div class="shell hero-copy"><span class="eyebrow">{t(locale,'heroEyebrow')}</span><h1>{t(locale,'heroTitle')}</h1><p>{t(locale,'heroBody')}</p><div class="hero-actions"><a class="btn" href="#destinations">{t(locale,'explore')} ↓</a><a class="btn outline" href={localizedPath(locale,'/contact')}>{tr(locale,'Request a proposal')} ↗</a></div></div><div class="shell route-wrap"><RouteMap /></div></section>
 <section id="destinations" class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">01 · {tr(locale,'Destinations')}</span><h2>{t(locale,'destinations')}</h2></div><p>{tr(locale,'Each route begins with a place, but unfolds through people: guides, cooks, makers and hosts who let us see their home with greater attention.')}</p></div><DestinationGrid {locale}/></div></section>
 <section class="finder"><div class="shell"><div class="finder-intro"><span class="eyebrow">{tr(locale,'Find your way')}</span><h2>{tr(locale,'What should your Asia feel like?')}</h2><p>{tr(locale,'Start with a place, a season or simply the kind of days you want. Every suggestion remains a beginning—not a fixed package.')}</p></div><form action={localizedPath(locale,'/tours')} method="get"><label>{tr(locale,'Where would you like to go?')}<select name="country"><option value="">{tr(locale,'Open to inspiration')}</option>{displayCountries.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>{tr(locale,'How long do you have?')}<select name="duration"><option value="">{tr(locale,'Any duration')}</option><option value="10">{tr(locale,'Up to 10 days')}</option><option value="14">{tr(locale,'11–14 days')}</option><option value="15">{tr(locale,'15 days or more')}</option></select></label><label>{tr(locale,'What draws you in?')}<select name="style"><option value="">{tr(locale,'Show me everything')}</option>{displayStyles.map(s=><option value={s.slug}>{s.label}</option>)}</select></label><button class="btn" type="submit">{tr(locale,'See journey ideas')} ↗</button></form></div></section>
 <section class="section styles"><div class="shell"><div class="section-head"><div><span class="eyebrow">02 · {tr(locale,'Ways to travel')}</span><h2>{tr(locale,'Begin with a feeling.')}</h2></div><p>{tr(locale,'Our journey collections organise possibilities without narrowing them. Each can be made private, extended or combined across borders.')}</p></div><div class="style-grid">{displayStyles.map((style,i)=><a id={style.slug} class="style-card" href={localizedPath(locale,`/tours#${style.slug}`)}><img src={style.image} alt="" loading="lazy" decoding="async"><span class="style-shade"></span><div><small>0{i+1} · {style.pace}</small><h3>{style.label}</h3><p>{style.description}</p><b>{style.idealFor} <i>{tr(locale,'Explore')} ↗</i></b></div></a>)}</div></div></section>
 <section class="section section-dark flagship"><div class="shell split"><div class="visual"><img src="https://images.unsplash.com/photo-1528360983277-13d401cdc186?auto=format&fit=crop&w=1400&q=86" alt="Cherry blossom framing a Japanese temple" loading="lazy"><span>PEK → NRT → BKK → SGN → DPS</span></div><div class="copy"><span class="eyebrow">02 · {t(locale,'featured')}</span><h2>The Long Way East</h2><p class="lead">Five countries. Thirty-two days. One unfolding conversation between ancient routes and contemporary Asia.</p><div class="stat"><b>32</b><span>days<br>designed to breathe</span></div><div class="stat"><b>05</b><span>countries<br>connected with purpose</span></div><a class="btn" href={localizedPath(locale,'/contact')}>Join the 2027 list ↗</a></div></div></section>
 <section class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">03 · {tr(locale,'Selected journeys')}</span><h2>{tr(locale,'Begin with an idea.')}</h2></div><a class="btn" href={localizedPath(locale,'/tours')}>{tr(locale,'View all journeys')} ↗</a></div><div class="cards">{displayTours.slice(0,3).map(tour=><TourCard {tour} {locale}/>)}</div></div></section>
 <section class="testimony"><div class="shell"><span class="eyebrow">04 · In good company</span><blockquote>“Every day felt considered, but never over-planned. We returned with the rare feeling that we had actually been somewhere.”</blockquote><p>— Eleanor & Martin · Japan, October 2025</p></div></section>
 <section class="section process"><div class="shell"><div class="section-head"><div><span class="eyebrow">How it works</span><h2>Designed in conversation.</h2></div><p>A specialist stays with your journey from the first sketch to your return home. The process is personal, transparent and deliberately unhurried.</p></div><ol><li><span>01</span><div><h3>Tell us what matters</h3><p>Share a destination, occasion, pace and the experiences you tend to remember.</p></div></li><li><span>02</span><div><h3>Receive your first route</h3><p>We shape an initial itinerary with clear, separately managed pricing in your currency.</p></div></li><li><span>03</span><div><h3>Refine it together</h3><p>Adjust hotels, rhythm and details until the journey feels unmistakably yours.</p></div></li><li><span>04</span><div><h3>Travel with support</h3><p>Local specialists and 24-hour assistance stay close without crowding the experience.</p></div></li></ol><a class="btn" href={localizedPath(locale,'/contact')}>Start a conversation ↗</a></div></section>
 <section class="section newsletter"><div class="shell news-grid"><div><span class="eyebrow">{t(locale,'newsletter')}</span><h2>Stories worth taking time over.</h2></div><form action="/api/lead" method="POST"><input type="hidden" name="locale" value={locale}><label for="email">{t(locale,'email')}</label><div><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com"><button class="btn" type="submit">{t(locale,'submit')} ↗</button></div><small>Occasional field notes. No noise.</small></form></div></section>
</BaseLayout>
<style>.hero{height:min(940px,100svh);min-height:720px;background:var(--ink);color:var(--cream);position:relative;display:flex;align-items:center}.hero>img,.veil{position:absolute;inset:0;width:100%;height:100%}.hero>img{object-fit:cover}.veil{background:linear-gradient(90deg,rgba(5,18,14,.85),rgba(5,18,14,.15) 68%),linear-gradient(0deg,rgba(5,18,14,.72),transparent 45%)}.hero-copy{position:relative;padding-top:5rem}.hero h1{max-width:900px;margin:.7rem 0 1.4rem}.hero-copy>p{max-width:560px;font-size:1.08rem;color:rgba(243,238,223,.82)}.hero-actions{display:flex;gap:.8rem;margin-top:2.3rem}.route-wrap{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%)}.finder{background:var(--ink-2);color:var(--cream);padding:4rem 0}.finder .shell{display:grid;grid-template-columns:.8fr 1.8fr;gap:4rem;align-items:end}.finder h2{font-size:clamp(2rem,4vw,3.4rem);margin:.5rem 0 1rem}.finder-intro p{color:rgba(243,238,223,.62);font-size:.85rem;max-width:30rem}.finder form{display:grid;grid-template-columns:repeat(3,1fr) auto;gap:1px;background:rgba(243,238,223,.16)}.finder label{background:var(--ink);padding:.8rem 1rem;color:var(--gold);font:500 .58rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.finder select{display:block;width:100%;margin-top:.45rem;background:transparent;border:0;color:var(--cream);font:.78rem var(--body);text-transform:none}.finder option{color:#111}.finder .btn{border-radius:0}.styles{background:#e6dcc7}.style-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(15,33,28,.22)}.style-card{height:500px;position:relative;overflow:hidden;color:#fff}.style-card>img,.style-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.style-card>img{transition:transform .7s cubic-bezier(.2,.7,.2,1)}.style-card:hover>img{transform:scale(1.045)}.style-shade{background:linear-gradient(0deg,rgba(8,25,20,.92),rgba(8,25,20,.06) 75%)}.style-card>div{position:absolute;inset:auto 2rem 2rem}.style-card small{color:var(--gold);font:.62rem var(--mono);letter-spacing:.12em;text-transform:uppercase}.style-card h3{font-size:clamp(2.2rem,4vw,3.7rem);margin:.5rem 0}.style-card p{max-width:32rem;color:rgba(255,255,255,.72);font-size:.85rem}.style-card b{display:flex;justify-content:space-between;margin-top:1.4rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.25);font:500 .62rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.style-card i{font-style:normal;color:var(--gold)}.split{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(3rem,7vw,8rem);align-items:center}.visual{position:relative}.visual img{width:100%;aspect-ratio:4/5}.visual span{position:absolute;right:-2rem;bottom:2rem;background:var(--gold);color:var(--ink);padding:1rem;font:500 .63rem var(--mono);letter-spacing:.1em}.copy h2{margin:.7rem 0 1.4rem}.lead{font:400 1.18rem/1.65 var(--display);color:rgba(243,238,223,.78);margin-bottom:2rem}.stat{display:flex;align-items:center;gap:1.3rem;border-top:1px solid rgba(243,238,223,.18);padding:1.1rem 0}.stat b{font:500 2rem var(--mono);color:var(--gold)}.stat span{font-size:.75rem;color:rgba(243,238,223,.6)}.copy .btn{margin-top:1.5rem}.testimony{background:var(--jade);color:var(--ink);padding:6rem 0;text-align:center}.testimony blockquote{font:500 clamp(2rem,5vw,4.6rem)/1.15 var(--display);max-width:1050px;margin:1.5rem auto}.testimony p{font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.1em}.process{background:var(--paper)}.process ol{list-style:none;margin:0 0 3rem;padding:0;border-top:1px solid rgba(15,33,28,.28)}.process li{display:grid;grid-template-columns:120px 1fr;padding:1.8rem 0;border-bottom:1px solid rgba(15,33,28,.2)}.process li>span{color:var(--vermilion);font:.72rem var(--mono)}.process li div{display:grid;grid-template-columns:1fr 1fr;gap:3rem}.process li p{color:#66706c}.newsletter{background:var(--ink-2);color:var(--cream)}.news-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:end}.news-grid h2{margin-top:.6rem}.news-grid label{display:block;font:.67rem var(--mono);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.6rem}.news-grid form>div{display:flex}.news-grid input{flex:1;min-width:0;background:transparent;border:1px solid rgba(243,238,223,.4);color:#fff;padding:1rem}.news-grid small{display:block;margin-top:.7rem;color:rgba(243,238,223,.45)}@media(max-width:900px){.finder .shell{grid-template-columns:1fr}.finder form{grid-template-columns:1fr 1fr}.style-card{height:430px}}@media(max-width:800px){.hero{min-height:760px}.hero h1{font-size:3.8rem}.route-wrap{bottom:1.2rem}.split,.news-grid{grid-template-columns:1fr}.visual span{right:0}.section-head .btn{justify-self:start}.news-grid{gap:2rem}.news-grid form>div{flex-direction:column;gap:.7rem}.style-grid{grid-template-columns:1fr}.process li{grid-template-columns:55px 1fr}.process li div{grid-template-columns:1fr;gap:.6rem}}@media(max-width:560px){.finder form{grid-template-columns:1fr}.hero-actions{align-items:flex-start;flex-direction:column}}</style>
