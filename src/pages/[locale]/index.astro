---
import NatureHero from '../../components/NatureHero.astro';
import {photoSize,photoSrcSet} from '../../lib/photoSize';
import BaseLayout from '../../layouts/BaseLayout.astro';import DestinationGrid from '../../components/DestinationGrid.astro';import TourCard from '../../components/TourCard.astro';import {locales,localizedPath,t,tr,localizeContent,type Locale} from '../../i18n';import {countries,journeyStyles,tours} from '../../content/data';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))} const {locale}=Astro.props as {locale:Locale};const displayCountries=localizeContent(locale,countries);const displayStyles=localizeContent(locale,journeyStyles);const displayTours=localizeContent(locale,tours);
const homeSeo:Record<Locale,{title:string;description:string}>={
 en:{title:'Tailor-made Asia Tours & Small Group Journeys | Way to Asia',description:'Plan thoughtful tailor-made tours and curated small-group journeys across China, South Korea, Thailand, Vietnam and Indonesia with trusted local knowledge.'},
 es:{title:'Viajes a medida por Asia y grupos pequeños | Way to Asia',description:'Diseña viajes a medida y recorridos en grupos pequeños por China, Corea del Sur, Tailandia, Vietnam e Indonesia con conocimiento local experto.'},
 it:{title:'Viaggi su misura in Asia e piccoli gruppi | Way to Asia',description:'Progetta viaggi su misura e itinerari in piccoli gruppi in Cina, Corea del Sud, Thailandia, Vietnam e Indonesia con esperti locali.'},
 fr:{title:'Voyages sur mesure en Asie et petits groupes | Way to Asia',description:'Créez un voyage sur mesure ou en petit groupe en Chine, Corée du Sud, Thaïlande, Vietnam et Indonésie avec une expertise locale.'},
 nl:{title:'Azië reizen op maat en kleine groepen | Way to Asia',description:'Plan reizen op maat en kleinschalige groepsreizen door China, Zuid-Korea, Thailand, Vietnam en Indonesië met lokale expertise.'},
 hu:{title:'Személyre szabott ázsiai utak kis csoportoknak | Way to Asia',description:'Tervezzen személyre szabott vagy kis csoportos utazást Kínába, Dél-Koreába, Thaiföldre, Vietnámba és Indonéziába helyi szakértőkkel.'},
 sv:{title:'Skräddarsydda Asienresor och små grupper | Way to Asia',description:'Planera skräddarsydda resor och små gruppresor i Kina, Sydkorea, Thailand, Vietnam och Indonesien med gedigen lokal kunskap.'},
 da:{title:'Skræddersyede rejser i Asien og små grupper | Way to Asia',description:'Planlæg skræddersyede rejser og små grupperejser i Kina, Sydkorea, Thailand, Vietnam og Indonesien med stærk lokal ekspertise.'},
 no:{title:'Skreddersydde Asia-reiser og små grupper | Way to Asia',description:'Planlegg skreddersydde reiser og små gruppereiser i Kina, Sør-Korea, Thailand, Vietnam og Indonesia med lokal ekspertise.'},
};
---
<BaseLayout title={homeSeo[locale].title} description={homeSeo[locale].description} {locale} path="/">
 <section class="hero"><NatureHero {locale}><div class="shell"><div class="hero-copy"><span class="eyebrow">{t(locale,'heroEyebrow')}</span><h1>{t(locale,'heroTitle')}</h1><p>{t(locale,'heroBody')}</p><div class="hero-actions"><a class="btn" href="#destinations">{t(locale,'explore')} ↓</a><a class="hero-enquiry" href={localizedPath(locale,'/contact')}>{tr(locale,'Request a proposal')} ↗</a></div></div></div></NatureHero></section>
 <section id="destinations" class="section section-paper"><div class="shell"><div class="section-head"><h2>{tr(locale,'Destinations')}</h2></div><DestinationGrid {locale}/></div></section>
 <section class="finder"><div class="shell"><div class="finder-intro"><span class="eyebrow">{tr(locale,'Find your way')}</span><h2>{tr(locale,'What should your Asia feel like?')}</h2><p>{tr(locale,'Start with a place, a season or simply the kind of days you want. Every suggestion remains a beginning—not a fixed package.')}</p></div><form action={localizedPath(locale,'/tours')} method="get"><label>{tr(locale,'Where would you like to go?')}<select name="country"><option value="">{tr(locale,'Open to inspiration')}</option>{displayCountries.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>{tr(locale,'How long do you have?')}<select name="duration"><option value="">{tr(locale,'Any duration')}</option><option value="10">{tr(locale,'Up to 10 days')}</option><option value="14">{tr(locale,'11–14 days')}</option><option value="15">{tr(locale,'15 days or more')}</option></select></label><label>{tr(locale,'What draws you in?')}<select name="style"><option value="">{tr(locale,'Show me everything')}</option>{displayStyles.map(s=><option value={s.slug}>{s.label}</option>)}</select></label><button class="btn" type="submit">{tr(locale,'See journey ideas')} ↗</button></form></div></section>
 <section class="section styles"><div class="shell"><div class="section-head"><div><span class="eyebrow">02 · {tr(locale,'Ways to travel')}</span><h2>{tr(locale,'Begin with a feeling.')}</h2></div><p>{tr(locale,'Our journey collections organise possibilities without narrowing them. Each can be made private, extended or combined across borders.')}</p></div><div class="style-grid">{displayStyles.map((style,i)=><a id={style.slug} class="style-card" href={localizedPath(locale,`/tours#${style.slug}`)}><img src={photoSize(style.image,768)} srcset={photoSrcSet(style.image,[480,768,1200])} sizes="(max-width: 800px) 100vw, 50vw" alt={`${style.label} — ${style.idealFor}`} loading="lazy" decoding="async"><span class="style-shade"></span><div><small>0{i+1} · {style.pace}</small><h3>{style.label}</h3><p>{style.description}</p><b>{style.idealFor} <i>{tr(locale,'Explore')} ↗</i></b></div></a>)}</div></div></section>
 <section class="section section-dark flagship"><div class="shell split"><div class="visual"><img src="https://images.unsplash.com/photo-1523760957528-55d1d540360d?auto=format&fit=crop&w=1400&q=82" alt="Traditional village architecture in Andong, South Korea" loading="lazy"><span>PEK → ICN → BKK → SGN → DPS</span></div><div class="copy"><span class="eyebrow">02 · {t(locale,'featured')}</span><h2>The Long Way East</h2><p class="lead">Five countries. Thirty-two days. One unfolding conversation between ancient routes and contemporary Asia.</p><div class="stat"><b>32</b><span>days<br>designed to breathe</span></div><div class="stat"><b>05</b><span>countries<br>connected with purpose</span></div><a class="btn" href={localizedPath(locale,'/contact')}>Join the 2027 list ↗</a></div></div></section>
 <section class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">03 · {tr(locale,'Selected journeys')}</span><h2>{tr(locale,'Begin with an idea.')}</h2></div><a class="btn" href={localizedPath(locale,'/tours')}>{tr(locale,'View all journeys')} ↗</a></div><div class="cards">{displayTours.slice(0,3).map(tour=><TourCard {tour} {locale}/>)}</div></div></section>
 <section class="testimony"><div class="shell"><span class="eyebrow">Our approach</span><blockquote>Travel with time to notice.</blockquote><p>Thoughtful routes, local knowledge and room to make the journey your own.</p></div></section>
 <section class="section process"><div class="shell"><div class="section-head"><div><span class="eyebrow">How it works</span><h2>Designed in conversation.</h2></div><p>A specialist stays with your journey from the first sketch to your return home. The process is personal, transparent and deliberately unhurried.</p></div><ol><li><span>01</span><div><h3>Tell us what matters</h3><p>Share a destination, occasion, pace and the experiences you tend to remember.</p></div></li><li><span>02</span><div><h3>Receive your first route</h3><p>We shape an initial itinerary with clear, separately managed pricing in your currency.</p></div></li><li><span>03</span><div><h3>Refine it together</h3><p>Adjust hotels, rhythm and details until the journey feels unmistakably yours.</p></div></li><li><span>04</span><div><h3>Travel with support</h3><p>Local specialists and 24-hour assistance stay close without crowding the experience.</p></div></li></ol><a class="btn" href={localizedPath(locale,'/contact')}>Start a conversation ↗</a></div></section>
 <section class="section newsletter"><div class="shell news-grid"><div><span class="eyebrow">{t(locale,'newsletter')}</span><h2>Stories worth taking time over.</h2></div><form action="/api/lead" method="POST"><input type="hidden" name="locale" value={locale}><label for="email">{t(locale,'email')}</label><div><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com"><button class="btn" type="submit">{t(locale,'submit')} ↗</button></div><small>Occasional field notes. No noise.</small></form></div></section>
</BaseLayout>
<style>.hero{padding:100px 0 28px;background:var(--cream);color:var(--ink)}.hero-layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:40px;align-items:center}.hero-photo{width:100%;height:360px;object-fit:cover;object-position:50% 55%}.hero-copy .eyebrow{color:#826020}.hero h1{font-size:clamp(2.5rem,4vw,3.8rem);max-width:500px;line-height:1.06;margin:12px 0 18px}.hero-copy>p{max-width:430px;font-size:1rem;color:#526058;line-height:1.65}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:14px 20px;margin-top:24px}.hero-enquiry{font:500 .68rem var(--mono);text-transform:uppercase;border-bottom:1px solid #9ca59e;padding:8px 0}.hero+.section{padding-top:24px}.hero+.section .section-head{margin-bottom:18px;display:block}.hero+.section h2{font-size:clamp(1.8rem,3vw,2.4rem)}.finder{background:var(--ink-2);color:var(--cream);padding:24px 0}.finder .shell{display:grid;grid-template-columns:1fr;gap:18px}.finder-intro{display:grid;grid-template-columns:1fr 1fr;column-gap:28px;align-items:center}.finder-intro .eyebrow{grid-column:1;margin-bottom:6px}.finder h2{font-size:clamp(1.5rem,2.3vw,2rem);margin:0;grid-column:1}.finder-intro p{color:rgba(243,238,223,.62);font-size:.85rem;max-width:none;margin:0;grid-column:2;grid-row:1/3}.finder form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:1px;background:rgba(243,238,223,.16)}.finder label{background:var(--ink);padding:.8rem 1rem;color:var(--gold);font:500 .58rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.finder select{display:block;width:100%;margin-top:.45rem;background:transparent;border:0;color:var(--cream);font:.78rem var(--body);text-transform:none}.finder option{color:#111}.finder .btn{border-radius:0}.styles{background:#e6dcc7}.style-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(15,33,28,.22)}.style-card{height:340px;position:relative;overflow:hidden;color:#fff}.style-card>img,.style-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.style-card>img{transition:transform .7s cubic-bezier(.2,.7,.2,1)}.style-card:hover>img{transform:scale(1.045)}.style-shade{background:linear-gradient(0deg,rgba(8,25,20,.92),rgba(8,25,20,.06) 75%)}.style-card>div{position:absolute;inset:auto 1.5rem 1.5rem}.style-card small{color:var(--gold);font:.62rem var(--mono);letter-spacing:.12em;text-transform:uppercase}.style-card h3{font-size:clamp(1.8rem,3vw,2.6rem);margin:.5rem 0}.style-card p{max-width:32rem;color:rgba(255,255,255,.72);font-size:.85rem}.style-card b{display:flex;justify-content:space-between;margin-top:1.4rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.25);font:500 .62rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.style-card i{font-style:normal;color:var(--gold)}.split{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center}.visual{position:relative}.visual img{width:100%;aspect-ratio:4/3}.visual span{position:absolute;right:-2rem;bottom:2rem;background:var(--gold);color:var(--ink);padding:1rem;font:500 .63rem var(--mono);letter-spacing:.1em}.copy h2{margin:.7rem 0 1.4rem}.lead{font:400 1.18rem/1.65 var(--display);color:rgba(243,238,223,.78);margin-bottom:2rem}.stat{display:flex;align-items:center;gap:1.3rem;border-top:1px solid rgba(243,238,223,.18);padding:1.1rem 0}.stat b{font:500 2rem var(--mono);color:var(--gold)}.stat span{font-size:.75rem;color:rgba(243,238,223,.6)}.copy .btn{margin-top:1.5rem}.testimony{background:var(--jade);color:var(--ink);padding:24px 0;text-align:center}.testimony .eyebrow{color:var(--ink)}.testimony blockquote{font:500 clamp(1.6rem,2.5vw,2.3rem)/1.15 var(--display);max-width:1050px;margin:8px auto}.testimony p{font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.1em}.process{background:var(--paper)}.process ol{list-style:none;margin:0 0 20px;padding:0;border-top:1px solid rgba(15,33,28,.28)}.process li{display:grid;grid-template-columns:48px 1fr;padding:16px 0;border-bottom:1px solid rgba(15,33,28,.2)}.process li>span{color:var(--vermilion-dark);font:.72rem var(--mono)}.process li div{display:grid;grid-template-columns:1fr 1fr;gap:3rem}.process li p{color:#59635f}.newsletter{background:var(--ink-2);color:var(--cream)}.newsletter .eyebrow{color:var(--cream)}.news-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center}.news-grid h2{margin-top:.6rem}.news-grid label{display:block;font:.67rem var(--mono);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.6rem}.news-grid form>div{display:flex}.news-grid input{flex:1;min-width:0;background:transparent;border:1px solid rgba(243,238,223,.4);color:#fff;padding:1rem}.news-grid small{display:block;margin-top:.7rem;color:rgba(243,238,223,.78)}@media(max-width:900px){.finder .shell{grid-template-columns:1fr}.finder form{grid-template-columns:1fr 1fr}.style-card{height:340px}}@media(max-width:800px){.hero{padding:86px 0 18px}.hero-layout{grid-template-columns:1fr;gap:20px}.hero-photo{grid-row:1;height:220px;object-position:50% 55%}.hero h1{font-size:2.5rem;max-width:580px;margin:10px 0 12px}.hero-copy>p{max-width:600px;font-size:.92rem}.hero-actions{margin-top:16px}.split,.news-grid{grid-template-columns:1fr}.visual span{right:0}.section-head .btn{justify-self:start}.news-grid{gap:2rem}.news-grid form>div{flex-direction:column;gap:.7rem}.style-grid{grid-template-columns:1fr}.process li{grid-template-columns:55px 1fr}.process li div{grid-template-columns:1fr;gap:.6rem}}@media(max-width:560px){.finder-intro{display:block}.finder-intro h2{margin:6px 0 8px}.finder form{grid-template-columns:1fr}.hero-photo{height:190px}.hero h1{font-size:2.15rem}.hero-actions .btn{padding:.8rem 1rem;font-size:.62rem}.hero-enquiry{font-size:.6rem}}</style>

<style>
.hero{padding:72px 0 0;background:var(--ink);color:var(--cream)}.hero-copy{max-width:560px;color:var(--cream);text-shadow:0 2px 24px rgba(0,0,0,.22)}.hero h1{font-size:clamp(3.2rem,6.2vw,5.8rem);max-width:720px;line-height:.98;margin:14px 0 20px;letter-spacing:-.045em}.hero-copy .eyebrow{color:#e4c56f}.hero-copy>p{color:rgba(255,255,255,.82);max-width:520px;font-size:1.05rem;line-height:1.65}.hero-actions{margin-top:28px}.hero-actions .btn{padding:1rem 1.35rem;text-shadow:none}.hero-enquiry{display:inline-block;color:var(--cream);border-color:rgba(255,255,255,.5);text-shadow:none}.hero+.section{padding-top:34px}
@media(max-width:800px){.hero{padding-top:64px}.hero-copy{max-width:600px}.hero h1{font-size:clamp(2.7rem,11vw,4.2rem);max-width:560px;margin:10px 0 14px}.hero-copy>p{font-size:.95rem;max-width:520px}.hero-actions{margin-top:20px}.hero-enquiry{display:none}.hero+.section{padding-top:24px}}
@media(max-width:560px){.hero-copy{max-width:340px}.hero h1{font-size:2.75rem}.hero-copy>p{font-size:.9rem;line-height:1.55}.hero-actions .btn{padding:.85rem 1rem}}
</style>
