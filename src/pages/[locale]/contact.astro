---
import BaseLayout from '../../layouts/BaseLayout.astro';import {countries} from '../../content/data';import {locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}const {locale}=Astro.props as {locale:Locale};
---
<BaseLayout title="Start planning — Way to Asia" description="Tell us what you imagine and receive a first tailor-made route." {locale} path="/contact"><section class="contact"><div class="shell contact-grid"><div><span class="eyebrow">A first conversation</span><h1>Where does Asia begin for you?</h1><p>Share what you know so far. A travel designer will reply within two working days with a few thoughtful questions.</p><div class="direct"><span>Prefer email?</span><a href="mailto:journeys@waytoasia.com">journeys@waytoasia.com ↗</a></div></div><form action="/api/lead" method="POST"><input type="hidden" name="locale" value={locale}><label>Your name<input name="name" required autocomplete="name"></label><label>Email address<input name="email" type="email" required autocomplete="email"></label><div class="row"><label>Destination<select name="destination"><option value="unsure">Still deciding</option>{countries.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>Travelers<input name="travelers" type="number" min="1" max="20" value="2"></label></div><label>What are you imagining?<textarea name="message" rows="6" placeholder="A season, a place, a feeling…"></textarea></label><label class="consent"><input type="checkbox" required name="consent"> <span>I agree to be contacted about this journey.</span></label><button class="btn" type="submit">Send my idea ↗</button></form></div></section></BaseLayout>
<style>.contact{background:var(--ink);color:var(--cream);padding:13rem 0 8rem;min-height:100vh}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(4rem,8vw,9rem)}h1{font-size:clamp(4rem,7vw,7rem);margin:.8rem 0 1.5rem}.contact-grid>div>p{max-width:480px;color:rgba(243,238,223,.68)}.direct{margin-top:4rem;display:flex;flex-direction:column;font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.08em}.direct span{color:var(--gold)}form{background:var(--paper);color:var(--ink);padding:clamp(1.5rem,4vw,3.5rem);display:flex;flex-direction:column;gap:1.4rem}form label{display:flex;flex-direction:column;gap:.4rem;font:500 .65rem var(--mono);letter-spacing:.1em;text-transform:uppercase}input,select,textarea{border:0;border-bottom:1px solid #a39f93;background:transparent;padding:.75rem 0;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--vermilion)}.row{display:grid;grid-template-columns:2fr 1fr;gap:1.5rem}.consent{flex-direction:row;font-family:var(--body);font-weight:400;letter-spacing:0;text-transform:none}.consent input{width:auto}.btn{align-self:start}@media(max-width:800px){.contact-grid{grid-template-columns:1fr}.contact{padding-top:10rem}.direct{margin-top:2rem}}</style>
