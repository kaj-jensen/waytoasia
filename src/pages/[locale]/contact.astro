---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {countries,tours} from '../../content/data';
import {locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}
const {locale}=Astro.props as {locale:Locale};
---
<BaseLayout title="Plan your journey — Way to Asia" description="Share the details we need to prepare a meaningful tailor-made travel proposal." {locale} path="/contact">
<section class="contact"><div class="shell contact-grid">
<header class="intro"><span class="eyebrow">Plan your journey</span><h1>Tell us who is travelling.</h1><p>A useful proposal begins with more than a destination. Your answers help us recommend the right route, rooms, pace and experiences from the first conversation.</p><div class="promise"><p><b>01 · Personal</b>A travel designer replies within two working days.</p><p><b>02 · No commitment</b>This is an enquiry, not a booking or payment.</p><p><b>03 · Private</b>Your details are used only to discuss your journey.</p></div><div class="direct"><span>Prefer email?</span><a href="mailto:journeys@waytoasia.com">journeys@waytoasia.com ↗</a></div></header>
<div class="form-card"><ol class="progress" aria-label="Enquiry progress"><li class="active" data-progress="1"><b>1</b> Contact</li><li data-progress="2"><b>2</b> Your trip</li><li data-progress="3"><b>3</b> Review</li></ol>
<form action="/api/lead" method="POST" data-planner><input type="hidden" name="locale" value={locale}><input type="hidden" name="tour" value=""><label class="trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
<fieldset data-step="1"><legend><span>Step one</span>Contact information</legend><p class="note">Who should our travel designer speak with?</p>
<div class="fields three names-row"><label>Title<select name="title" autocomplete="honorific-prefix"><option value="">Select</option><option>Mr</option><option>Ms</option><option>Mrs</option><option>Dr</option></select></label><label>First name *<input name="firstName" required autocomplete="given-name"></label><label>Last name *<input name="lastName" required autocomplete="family-name"></label></div>
<div class="fields two"><label>Email address *<input name="email" type="email" required autocomplete="email"><small>We send your proposal here.</small></label><label>Phone number *<input name="phone" type="tel" required autocomplete="tel" placeholder="+45 …"><small>Please include your country code.</small></label></div>
<div class="fields two"><label>Country of residence *<input name="residence" required autocomplete="country-name"></label><label>Preferred contact *<select name="preferredContact" required><option value="">Select</option><option value="email">Email</option><option value="phone">Phone</option><option value="whatsapp">WhatsApp</option></select></label></div>
<div class="actions"><span>About 3 minutes remaining</span><button class="btn" type="button" data-next>Continue to trip details →</button></div></fieldset>
<fieldset data-step="2"><legend><span>Step two</span>Trip and travellers</legend><p class="note">Estimates are fine. Choose “not decided” wherever needed.</p>
<div class="fields two"><label>Destination *<select name="destination" required><option value="unsure">Still deciding</option>{countries.map(c=><option value={c.slug}>{c.name}</option>)}</select></label><label>Journey idea<select name="journey"><option value="">No specific journey</option>{tours.map(t=><option value={t.slug} data-country={t.country}>{t.name}</option>)}</select></label></div>
<div class="fields three"><label>Earliest departure *<input name="departureDate" type="date" required></label><label>Date flexibility *<select name="dateFlexibility" required><option value="">Select</option><option>Exact dates</option><option>± 3 days</option><option>± 1 week</option><option>Flexible month</option><option>Not decided</option></select></label><label>Trip length *<select name="duration" required><option value="">Select</option><option>7–10 days</option><option>11–14 days</option><option>15–21 days</option><option>22+ days</option><option>Not decided</option></select></label></div>
<div class="fields four"><label>Adults *<input name="adults" type="number" min="1" max="20" value="2" required></label><label>Children<input name="children" type="number" min="0" max="10" value="0"></label><label>Children’s ages<input name="childrenAges" placeholder="e.g. 7, 12"></label><label>Rooms *<input name="rooms" type="number" min="1" max="10" value="1" required></label></div>
<div class="fields two"><label>Departure airport or city *<input name="departureAirport" required placeholder="e.g. Copenhagen"></label><label>International flights<select name="flightsStatus"><option>Not booked</option><option>Booked</option><option>Would like guidance</option></select></label></div>
<div class="fields three"><label>Budget currency *<select name="budgetCurrency" required><option>DKK</option><option>EUR</option><option>USD</option><option>SEK</option><option>NOK</option><option>HUF</option></select></label><label>Budget per person *<input name="budgetPerPerson" type="number" min="500" step="100" required placeholder="Excluding flights"></label><label>Accommodation *<select name="accommodation" required><option value="">Select</option><option>Comfortable 3-star</option><option>Premium 4-star</option><option>Luxury 5-star</option><option>Character stays and ryokan</option><option>Mix to suit the route</option></select></label></div>
<fieldset class="choices"><legend>What matters most? <small>Select all that apply</small></legend><div>{['Food & local culture','History & heritage','Nature & wildlife','Art & design','Active experiences','Wellness & relaxation','Family time','Honeymoon or celebration'].map(item=><label><input type="checkbox" name="interests" value={item}> {item}</label>)}</div></fieldset>
<div class="fields two"><label>Preferred pace<select name="pace"><option>Balanced</option><option>Slow and immersive</option><option>Active and full</option><option>Not sure</option></select></label><label>Room arrangement<input name="roomArrangement" placeholder="e.g. 1 double, 1 twin"></label></div>
<label>Dietary, mobility or accessibility requirements<textarea name="requirements" rows="3" placeholder="Tell us what we should plan for."></textarea></label><label>Anything else that would make this journey right for you?<textarea name="message" rows="5" placeholder="Must-see experiences, celebrations, previous trips or concerns…"></textarea></label>
<div class="actions"><button class="back" type="button" data-back>← Back</button><button class="btn" type="button" data-next>Review enquiry →</button></div></fieldset>
<fieldset data-step="3"><legend><span>Step three</span>Review your enquiry</legend><p class="note">Check the essentials before sending. You can go back and change anything.</p><div class="review" aria-live="polite" data-review></div><label class="consent"><input type="checkbox" required name="consent" value="yes"><span>I agree that Way to Asia may use these details to prepare and discuss my travel proposal. *</span></label><p class="privacy">This does not create a booking. We do not add you to marketing without separate consent.</p><div class="actions"><button class="back" type="button" data-back>← Back</button><button class="btn" type="submit">Send my enquiry ↗</button></div></fieldset>
</form></div></div></section></BaseLayout>
<script>
const form=document.querySelector<HTMLFormElement>('[data-planner]');
if(form){form.classList.add('enhanced');let step=1;const panels=[...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];const progress=[...document.querySelectorAll<HTMLElement>('[data-progress]')];
const show=(n:number)=>{step=n;panels.forEach(p=>p.hidden=Number(p.dataset.step)!==step);progress.forEach(p=>{const v=Number(p.dataset.progress);p.classList.toggle('active',v===step);p.classList.toggle('complete',v<step)});document.querySelector('.form-card')?.scrollIntoView({behavior:'smooth',block:'start'})};
const valid=()=>[...panels[step-1].querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('[required]')].every(x=>x.reportValidity());
const review=()=>{const d=new FormData(form);const v=(k:string)=>d.getAll(k).filter(Boolean).join(', ')||'Not specified';const selected=(k:string)=>{const control=form.elements.namedItem(k);return control instanceof HTMLSelectElement?control.selectedOptions[0]?.text||'Not specified':v(k)};const groups=[{title:'Your details',rows:[['Traveller',[v('title'),v('firstName'),v('lastName')].filter(x=>x!=='Not specified').join(' ')],['Email',v('email')],['Phone',v('phone')],['Residence & contact',v('residence')+' · '+selected('preferredContact')]]},{title:'Journey plan',rows:[['Destination',selected('destination')],['Journey idea',selected('journey')],['Travel dates',v('departureDate')+' · '+selected('dateFlexibility')],['Trip length',selected('duration')]]},{title:'Travellers & logistics',rows:[['Travel party',v('adults')+' adults · '+v('children')+' children'],['Rooms',v('rooms')+' room(s)'+(v('roomArrangement')==='Not specified'?'':' · '+v('roomArrangement'))],['Departure',v('departureAirport')],['International flights',selected('flightsStatus')]]},{title:'Budget & preferences',rows:[['Budget',selected('budgetCurrency')+' '+v('budgetPerPerson')+' per person'],['Accommodation',selected('accommodation')],['Pace',selected('pace')],['Interests',v('interests')]]},{title:'Personal requirements',rows:[['Dietary, mobility or accessibility',v('requirements')],['Anything else',v('message')]]}];const target=form.querySelector<HTMLElement>('[data-review]');if(!target)return;target.replaceChildren(...groups.map(group=>{const section=document.createElement('section');section.className='review-section';const heading=document.createElement('h3');heading.textContent=group.title;section.append(heading,...group.rows.map(([label,value])=>{const row=document.createElement('div');row.className='review-item';const term=document.createElement('span');term.textContent=label;const answer=document.createElement('b');answer.textContent=value;row.append(term,answer);return row}));return section}))};
form.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',()=>{if(!valid())return;if(step===2)review();show(Math.min(3,step+1))}));form.querySelectorAll('[data-back]').forEach(b=>b.addEventListener('click',()=>show(Math.max(1,step-1))));
const q=new URLSearchParams(location.search);const tour=q.get('tour');const destination=q.get('destination');if(tour){const s=form.elements.namedItem('journey') as HTMLSelectElement;s.value=tour;(form.elements.namedItem('tour') as HTMLInputElement).value=tour;const c=s.selectedOptions[0]?.dataset.country;if(c)(form.elements.namedItem('destination') as HTMLSelectElement).value=c}if(destination)(form.elements.namedItem('destination') as HTMLSelectElement).value=destination;show(1)}
</script>
<style>
.contact{background:var(--ink);color:var(--cream);padding:9.5rem 0 5.5rem;min-height:100vh}.contact-grid{display:grid;grid-template-columns:minmax(290px,.75fr) minmax(600px,1.35fr);gap:clamp(3rem,7vw,8rem);align-items:start}.intro{position:sticky;top:3rem}.intro h1{font-size:clamp(3.7rem,6vw,6.7rem);margin:.8rem 0 1.5rem}.intro>p{color:rgba(243,238,223,.78)}.promise{margin:3rem 0;border-top:1px solid #ffffff35}.promise p{padding:1rem 0;border-bottom:1px solid #ffffff25;color:#f3eedfb8;font-size:.76rem}.promise b{display:block;color:var(--gold);font:.65rem var(--mono)}.direct{display:flex;flex-direction:column;font:.7rem var(--mono);text-transform:uppercase}.direct span{color:var(--gold)}.form-card{background:var(--paper);color:var(--ink);box-shadow:0 28px 75px #0004}.progress{list-style:none;margin:0;padding:0 2rem;display:grid;grid-template-columns:repeat(3,1fr);background:#ded4c1}.progress li{display:flex;gap:.6rem;align-items:center;padding:1.1rem .4rem;color:#59655f;font:500 .65rem var(--mono);text-transform:uppercase;border-bottom:3px solid transparent}.progress b{display:grid;place-items:center;width:24px;height:24px;border:1px solid;border-radius:50%}.progress .active{color:var(--ink);border-color:var(--vermilion)}.progress .complete b{background:var(--ink);color:#fff}form{padding:clamp(1.5rem,4vw,3.5rem)}form.enhanced [data-step][hidden]{display:none}fieldset{border:0;margin:0;padding:0}fieldset>legend{font:500 clamp(2rem,3.5vw,3.4rem)/1 var(--display);margin-bottom:.7rem}fieldset>legend span{display:block;color:var(--vermilion-dark);font:500 .62rem var(--mono);text-transform:uppercase}.note{color:#4f5d56;margin-bottom:2.3rem}.fields{display:grid;gap:1.2rem;margin-bottom:1.3rem}.fields>label{justify-content:flex-end}.two{grid-template-columns:repeat(2,minmax(0,1fr))}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.names-row{grid-template-columns:.55fr 1fr 1fr}.four{grid-template-columns:repeat(4,minmax(0,1fr))}form label{display:flex;flex-direction:column;gap:.35rem;font:500 .64rem var(--mono);letter-spacing:.06em;text-transform:uppercase}input,select,textarea{width:100%;border:1px solid #938c7f;background:#f8f3e8;color:var(--ink);padding:.82rem .75rem;outline:none}input,select{height:3rem}input:focus,select:focus,textarea:focus{border-color:var(--vermilion);box-shadow:0 0 0 2px #c1442d25}label small{color:#59655f;font:normal .68rem var(--body);text-transform:none}.choices{margin:2rem 0}.choices>legend{font:500 .68rem var(--mono);text-transform:uppercase}.choices>legend small{font:normal .65rem var(--body);color:#59655f;text-transform:none}.choices>div{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.choices label{display:block;background:#e5dccb;padding:.75rem;text-transform:none;font:400 .78rem var(--body)}.choices input,.consent input{width:auto;accent-color:var(--vermilion)}.actions{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2.3rem;padding-top:1.3rem;border-top:1px solid #bdb4a5}.actions>span,.privacy{font-size:.7rem;color:#59655f}.back{border:0;background:none;font:500 .68rem var(--mono);text-transform:uppercase}.review{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:2rem 0}.review-section{background:#f8f3e8;border:1px solid #c9c0b1;padding:1.15rem 1.2rem}.review-section:last-child{grid-column:1/-1}.review-section h3{margin:0 0 .4rem;color:var(--vermilion-dark);font:500 .65rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.review-item{display:grid;grid-template-columns:minmax(105px,.7fr) minmax(0,1.3fr);gap:.8rem;padding:.65rem 0;border-bottom:1px solid #d7cfc1}.review-item:last-child{border-bottom:0}.review-item span{color:#59655f;font:500 .58rem var(--mono);letter-spacing:.04em;text-transform:uppercase}.review-item b{overflow-wrap:anywhere;font-size:.73rem;line-height:1.45}.consent{display:flex;flex-direction:row;gap:.75rem;align-items:flex-start;background:#ded4c1;padding:1rem 1.1rem;text-transform:none;font:400 .76rem/1.45 var(--body)}.consent input{flex:0 0 1.1rem;width:1.1rem;height:1.1rem;margin:.12rem 0 0}.consent span{min-width:0}.privacy{margin:.8rem 0 1rem;padding-left:1.1rem}.trap{position:absolute!important;left:-9999px!important}.btn{white-space:nowrap}
@media(max-width:1000px){.contact-grid{grid-template-columns:1fr}.intro{position:static}}@media(max-width:700px){.contact{padding-top:8rem}.two,.three,.four,.choices>div,.review{grid-template-columns:1fr}.progress{padding:0 .6rem}.progress li{font-size:.55rem}.actions{align-items:stretch;flex-direction:column-reverse}.actions .btn{width:100%}.review-section:last-child{grid-column:auto}.review-item{grid-template-columns:1fr;gap:.2rem}}
</style>
<style is:global>
.review-section{background:#f8f3e8;border:1px solid #c9c0b1;padding:1.15rem 1.2rem}.review-section:last-child{grid-column:1/-1}.review-section h3{margin:0 0 .4rem;color:var(--vermilion-dark);font:500 .65rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.review-item{display:grid;grid-template-columns:minmax(105px,.7fr) minmax(0,1.3fr);gap:.8rem;padding:.65rem 0;border-bottom:1px solid #d7cfc1}.review-item:last-child{border-bottom:0}.review-item span{color:#59655f;font:500 .58rem var(--mono);letter-spacing:.04em;text-transform:uppercase}.review-item b{overflow-wrap:anywhere;font-size:.73rem;line-height:1.45}@media(max-width:700px){.review-section:last-child{grid-column:auto}.review-item{grid-template-columns:1fr;gap:.2rem}}
</style>
