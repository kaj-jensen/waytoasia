---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import JourneyMap from '../../../../components/JourneyMap.astro';
import {countries,tours,type Country,type Tour} from '../../../../content/data';
import {formatPrice} from '../../../../lib/format';
import {locales,localizedPath,type Locale} from '../../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>tours.map(tour=>({params:{locale,country:tour.country,slug:tour.slug},props:{locale,tour,country:countries.find(c=>c.slug===tour.country)!}})))}
const {locale,tour,country}=Astro.props as {locale:Locale;tour:Tour;country:Country};
const path=`/${country.slug}/tours/${tour.slug}`;
const route=tour.route??tour.itinerary.map(step=>step.title.split(',')[0].split('—')[0].trim());
const highlights=tour.highlights??tour.itinerary.map(step=>step.copy);
const accommodation=tour.accommodation??route.slice(0,4).map((place,index)=>({place,nights:index===0?'Arrival stay':'Journey stay',style:'Personally selected character accommodation'}));
const transport=tour.transport??['Private arrival transfer','Reserved intercity transport','Locally arranged transfers'];
const enquiry=localizedPath(locale,`/contact?tour=${tour.slug}`);
---
<BaseLayout title={`${tour.name} — Way to Asia`} description={tour.teaser} {locale} {path} image={tour.image}>
<main>
<section class="tour-hero"><img src={tour.image} alt={`${tour.name} in ${country.name}`} fetchpriority="high"><div class="shade"></div><div class="shell hero-copy"><p class="hero-label">{tour.journeyType??'Private tailor-made journey'} <span>·</span> {tour.tripCode??country.code}</p><h1>{tour.name}</h1><p>{tour.teaser}</p></div></section>
<nav class="journey-nav" aria-label="Journey sections"><div class="shell"><span class="nav-label">On this page</span><a href="#overview">Overview</a><a href="#itinerary">Itinerary</a><a href="#stays">Accommodation</a><a href="#details">Included</a><a class="nav-enquire" href={enquiry}>Request a proposal</a></div></nav>

<section class="product-summary" id="overview"><div class="shell summary-grid"><div class="summary-copy"><span class="eyebrow">Tour overview</span><h2>{tour.teaser}</h2><p>This is a private, customisable journey through {country.name}. The route, hotels and included experiences form a complete starting point; we adjust the dates, room standard and pace around you.</p><div class="route-line" aria-label={`Route: ${route.join(' to ')}`}>{route.map((stop,index)=><span><i>{String(index+1).padStart(2,'0')}</i><b>{stop}</b></span>)}</div></div><aside class="booking-card" aria-label="Tour facts and price"><div class="price"><small>Guide price from</small><strong>{formatPrice(locale,tour.prices)}</strong><span>per person</span></div><dl><div><dt>Duration</dt><dd>{tour.duration} days</dd></div><div><dt>Tour type</dt><dd>{tour.groupSize}</dd></div><div><dt>Best time</dt><dd>{tour.departures.join(' · ')}</dd></div><div><dt>Pace</dt><dd>{tour.pace??'Thoughtfully balanced'}</dd></div><div><dt>Meals</dt><dd>{tour.meals??'Daily breakfast'}</dd></div></dl><a class="btn" href={enquiry}>Request a proposal ↗</a><p>{tour.priceNote??'Final price depends on dates and accommodation.'}</p></aside></div></section>

<section class="section compact-highlights"><div class="shell split-heading"><div><span class="eyebrow">Why choose this tour</span><h2>The journey highlights.</h2></div><ul>{highlights.slice(0,4).map(item=><li>{item}</li>)}</ul></div></section>

<section class="section itinerary-section" id="itinerary"><div class="shell content-shell"><header class="section-head"><div><span class="eyebrow">Suggested itinerary</span><h2>{tour.duration} days through {country.name}.</h2></div><p>The itinerary is clear enough to plan from and flexible enough to personalise. Optional activities are identified in your final proposal.</p></header>{tour.dailyItinerary ? <div class="daily-list">{tour.dailyItinerary.map(day=><details class="daily" open={day.day===1}><summary><span class="day-number">Day {day.day}</span><span><small>{day.location}</small><strong>{day.title}</strong></span><i aria-hidden="true">+</i></summary><div class="daily-body"><p>{day.summary}</p><section><h3>Planned experiences</h3><ul>{day.activities.map(item=><li>{item}</li>)}</ul></section><dl><div><dt>Overnight</dt><dd>{day.overnight}</dd></div><div><dt>Meals</dt><dd>{day.meals}</dd></div>{day.transport&&<div><dt>Transport</dt><dd>{day.transport}</dd></div>}</dl></div></details>)}</div> : <div class="stage-list">{tour.itinerary.map((step,index)=><article><span>Days {step.day}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div><b>{String(index+1).padStart(2,'0')}</b></article>)}</div>}</div></section>

<section class="section map-section" id="route"><div class="shell map-grid"><div><span class="eyebrow">Route & transport</span><h2>A logical route with less backtracking.</h2><p>Reserved intercity sectors and transfers are coordinated as one journey. Exact timings and tickets arrive with your final travel documents.</p><ul class="plain-list">{transport.map(item=><li>{item}</li>)}</ul></div><JourneyMap {route} country={country.slug}/></div></section>

<section class="section stays-section" id="stays"><div class="shell"><header class="section-head"><div><span class="eyebrow">Accommodation</span><h2>Where you will stay.</h2></div><p>Named properties and room categories are confirmed in your proposal. Comparable alternatives match location, quality and character.</p></header><div class="stay-list">{accommodation.map((stay,index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{stay.place}</h3><p>{stay.nights}</p><small>{stay.style}</small></article>)}</div></div></section>

<section class="section details-section" id="details"><div class="shell"><header class="section-head"><div><span class="eyebrow">Important information</span><h2>What is—and is not—included.</h2></div><p>This is an example of a tailor-made journey. Your proposal will state every confirmed service and any requested changes.</p></header><div class="detail-grid"><section><h3>Included</h3><ul>{tour.includes.map(x=><li>{x}</li>)}</ul></section><section><h3>Not included</h3><ul class="excluded">{tour.excludes.map(x=><li>{x}</li>)}</ul></section></div></div></section>

<section class="final-cta"><div class="shell"><span class="eyebrow">Tailor-made for you</span><h2>Use this tour as your starting point.</h2><p>Tell us your dates, travellers and priorities. A travel designer will return with a personal itinerary and itemised proposal.</p><a class="btn" href={enquiry}>Plan this journey ↗</a></div></section>
</main></BaseLayout>

<style>
.tour-hero{height:68svh;min-height:560px;max-height:760px;position:relative;display:flex;align-items:end;color:var(--cream);padding:0 0 4.5rem}.tour-hero>img,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{background:linear-gradient(90deg,rgba(4,17,13,.88),rgba(4,17,13,.3) 66%),linear-gradient(0deg,rgba(4,17,13,.7),transparent 55%)}.hero-copy{position:relative}.hero-label{font:500 .68rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}.hero-label span{padding:0 .45rem}.tour-hero h1{max-width:940px;font-size:clamp(3.7rem,7vw,7rem);margin:.5rem 0 .8rem}.tour-hero .hero-copy>p:last-child{max-width:680px;font-size:1.18rem;color:#eef2ef}
.journey-nav{position:sticky;top:0;z-index:20;background:rgba(243,238,223,.97);backdrop-filter:blur(14px);border-bottom:1px solid #d4ccbd}.journey-nav .shell{height:62px;display:flex;align-items:center;gap:2rem}.journey-nav a{font:500 .66rem var(--mono);text-transform:uppercase;letter-spacing:.07em}.journey-nav .nav-enquire{margin-left:auto;background:var(--vermilion);color:#fff;padding:.72rem 1rem}
.product-summary{background:var(--paper,#f3eedf);padding:4.5rem 0}.summary-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(330px,.65fr);gap:7vw;align-items:start}.summary-copy h2{font-size:clamp(2.2rem,4vw,4rem);margin:.65rem 0 1.2rem;max-width:760px}.summary-copy>p{font-size:1.05rem;max-width:710px;color:#526059}.route-line{display:flex;flex-wrap:wrap;margin-top:2.3rem;padding-top:1.3rem;border-top:1px solid #c9c0af}.route-line span{display:flex;align-items:center;gap:.5rem;font:500 .7rem var(--mono)}.route-line span:not(:last-child):after{content:'→';color:var(--vermilion);margin:0 .8rem}.route-line i{font-style:normal;color:var(--vermilion);font-size:.58rem}
.booking-card{background:var(--ink);color:var(--cream);padding:2rem;box-shadow:0 20px 50px rgba(15,33,28,.16)}.price small,.price span{display:block}.price small{font:500 .64rem var(--mono);color:var(--gold);text-transform:uppercase;letter-spacing:.08em}.price strong{display:block;font:500 2.6rem var(--display);margin:.1rem 0}.price span{font-size:.72rem;color:#c2ccc7}.booking-card dl{margin:1.2rem 0 1.5rem}.booking-card dl div{display:flex;justify-content:space-between;gap:1rem;padding:.68rem 0;border-bottom:1px solid rgba(255,255,255,.18)}.booking-card dt{font-size:.74rem;color:#c2ccc7}.booking-card dd{margin:0;text-align:right;font-size:.74rem;color:#f3eedf}.booking-card .btn{width:100%}.booking-card>p{font-size:.68rem;color:#b7c3bd;margin:.8rem 0 0}
.compact-highlights{background:#faf7ef}.split-heading{display:grid;grid-template-columns:.75fr 1.25fr;gap:7vw}.split-heading h2{margin:.6rem 0 0}.split-heading ul{list-style:none;margin:0;padding:0}.split-heading li{position:relative;padding:1.05rem 0 1.05rem 2rem;border-top:1px solid #d4ccbd;color:#435149}.split-heading li:before{content:'✓';position:absolute;left:0;color:var(--vermilion);font-weight:700}
.itinerary-section{background:#f7f3e9}.content-shell{max-width:1000px}.section-head{display:grid;grid-template-columns:1fr .72fr;gap:5vw;align-items:end;margin-bottom:2.7rem}.section-head h2{margin:.6rem 0 0}.section-head>p{color:#5a6760}.daily-list{border-top:1px solid #c8bfaf}.daily{border-bottom:1px solid #c8bfaf}.daily summary{list-style:none;display:grid;grid-template-columns:84px 1fr 30px;gap:1rem;align-items:center;padding:1.35rem 0;cursor:pointer}.daily summary::-webkit-details-marker{display:none}.day-number{font:500 .66rem var(--mono);color:var(--vermilion)}.daily summary small{display:block;color:#69756f;font:500 .61rem var(--mono);letter-spacing:.09em;text-transform:uppercase}.daily summary strong{font:500 clamp(1.2rem,2.2vw,1.75rem) var(--display)}.daily summary i{font-style:normal;font-size:1.7rem;transition:transform .2s}.daily[open] summary i{transform:rotate(45deg)}.daily-body{display:grid;grid-template-columns:1.1fr .9fr .7fr;gap:2rem;padding:0 0 2rem 100px}.daily-body>p{color:#526059}.daily-body h3{font:500 .66rem var(--mono);text-transform:uppercase;letter-spacing:.08em;margin:0 0 .5rem}.daily-body ul{margin:0;padding-left:1rem}.daily-body li{margin:.3rem 0}.daily-body dl{margin:0;background:#eee7d9;padding:1rem}.daily-body dl div{padding:.35rem 0;border-bottom:1px solid #d4ccbd}.daily-body dt{font:500 .58rem var(--mono);text-transform:uppercase;color:#69756f}.daily-body dd{margin:.12rem 0 0;font-size:.74rem}.stage-list{border-top:1px solid #c8bfaf}.stage-list article{display:grid;grid-template-columns:110px 1fr 40px;gap:2rem;padding:1.7rem 0;border-bottom:1px solid #c8bfaf}.stage-list article>span,.stage-list article>b{font:500 .65rem var(--mono);text-transform:uppercase;color:var(--vermilion)}.stage-list h3{font-size:1.55rem;margin:0 0 .35rem}.stage-list p{color:#526059;max-width:680px}.stage-list b{text-align:right;color:#9f9a8d}
.map-section{background:#faf7ef}.map-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:6vw;align-items:center}.map-grid h2{margin:.6rem 0 1rem}.map-grid p{color:#59665f}.plain-list{list-style:none;margin:1.3rem 0 0;padding:0}.plain-list li{padding:.5rem 0;border-bottom:1px solid #d4ccbd;font:500 .66rem var(--mono);text-transform:uppercase}
.stays-section{background:var(--ink);color:var(--cream)}.stays-section .eyebrow{color:var(--gold)}.stays-section .section-head>p{color:#b7c3bd}.stay-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));border-top:1px solid rgba(255,255,255,.2)}.stay-list article{padding:1.4rem 1.2rem 1.4rem 0;border-right:1px solid rgba(255,255,255,.16)}.stay-list article+article{padding-left:1.2rem}.stay-list span{font:500 .61rem var(--mono);color:var(--gold)}.stay-list h3{font-size:1.4rem;margin:.55rem 0 .25rem}.stay-list p{color:#f3eedf}.stay-list small{display:block;color:#b7c3bd;margin-top:.35rem}
.details-section{background:#f3eedf}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:5vw}.detail-grid section{background:#faf7ef;padding:1.7rem 2rem}.detail-grid h3{font-size:1.45rem;margin-bottom:.8rem}.detail-grid ul{list-style:none;margin:0;padding:0}.detail-grid li{position:relative;padding:.55rem 0 .55rem 1.6rem;border-bottom:1px solid #d4ccbd}.detail-grid li:before{content:'✓';position:absolute;left:0;color:var(--vermilion)}.detail-grid .excluded li:before{content:'—'}
.final-cta{background:#d8ece8;text-align:center;padding:5.5rem 0}.final-cta h2{margin:.6rem 0 .8rem}.final-cta p{max-width:650px;margin:0 auto 1.5rem;color:#526059}
@media(max-width:850px){.tour-hero{height:62svh;min-height:500px;padding-bottom:3rem}.journey-nav a:not(.nav-enquire):not(:first-child){display:none}.journey-nav .shell{gap:1rem}.summary-grid,.split-heading,.section-head,.map-grid,.detail-grid{grid-template-columns:1fr}.booking-card{order:-1}.section-head{align-items:start}.daily-body{grid-template-columns:1fr;padding-left:0}.stage-list article{grid-template-columns:75px 1fr}.stage-list article>b{display:none}.route-line span:not(:last-child):after{margin:0 .45rem}.stay-list{grid-template-columns:1fr 1fr}.product-summary{padding:3.5rem 0}}
@media(max-width:560px){.tour-hero h1{font-size:3.2rem}.journey-nav .nav-enquire{font-size:.58rem}.stay-list{grid-template-columns:1fr}.daily summary{grid-template-columns:64px 1fr 22px}.detail-grid section{padding:1.3rem}.product-summary,.section{padding-top:3.5rem;padding-bottom:3.5rem}}
.product-summary,.compact-highlights,.itinerary-section,.map-section,.stays-section,.details-section{padding-top:3.25rem;padding-bottom:3.25rem}.final-cta{padding-top:4rem;padding-bottom:4rem}.booking-card .price strong{color:#f3eedf}.journey-nav{background:#10271f;border-bottom:3px solid var(--gold);box-shadow:0 8px 22px rgba(4,17,13,.18)}.journey-nav .shell{height:68px}.journey-nav .nav-label{color:var(--gold);font:600 .6rem var(--mono);letter-spacing:.12em;text-transform:uppercase;padding-right:1.4rem;border-right:1px solid rgba(255,255,255,.25)}.journey-nav a{color:#f3eedf;font-weight:600;font-size:.7rem;letter-spacing:.1em;padding:.55rem 0;border-bottom:2px solid transparent}.journey-nav a:hover,.journey-nav a:focus-visible{color:var(--gold);border-bottom-color:var(--gold)}.journey-nav .nav-enquire{color:#fff;padding:.82rem 1.2rem;border:1px solid transparent}.journey-nav .nav-enquire:hover,.journey-nav .nav-enquire:focus-visible{color:#fff;background:#a93627;border-color:#fff}
@media(max-width:850px){.journey-nav .nav-label{display:none}.journey-nav .shell{height:62px}}
.content-shell{max-width:1180px}.section-head{grid-template-columns:.75fr 1.25fr;gap:7vw;align-items:start}.section-head>p{padding-top:2rem}
@media(max-width:850px){.section-head>p{padding-top:0}}
.journey-nav{background:#f3eedf;border-top:1px solid rgba(16,39,31,.18);border-bottom:3px solid var(--gold);box-shadow:0 10px 26px rgba(4,17,13,.2)}.journey-nav .nav-label{color:#8f3022;border-right-color:rgba(16,39,31,.28)}.journey-nav a{color:#10271f}.journey-nav a:hover,.journey-nav a:focus-visible{color:#8f3022;border-bottom-color:#8f3022}.journey-nav .nav-enquire{color:#fff}
</style>
