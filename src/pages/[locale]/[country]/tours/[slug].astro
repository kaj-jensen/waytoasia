---
import BaseLayout from '../../../../layouts/BaseLayout.astro';import Gallery from '../../../../components/Gallery';import {countries,tours,type Country,type Tour} from '../../../../content/data';import {formatPrice} from '../../../../lib/format';import {locales,localizedPath,type Locale} from '../../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>tours.map(tour=>({params:{locale,country:tour.country,slug:tour.slug},props:{locale,tour,country:countries.find(c=>c.slug===tour.country)!}})))}const {locale,tour,country}=Astro.props as {locale:Locale;tour:Tour;country:Country};const path=`/${country.slug}/tours/${tour.slug}`;const images=[tour.image,...country.gallery.slice(0,2)];
---
<BaseLayout title={`${tour.name} — Way to Asia`} description={tour.teaser} {locale} {path} image={tour.image}><section class="tour-hero"><img src={tour.image} alt={`${tour.name} in ${country.name}`} fetchpriority="high"><div class="shade"></div><div class="shell"><span class="eyebrow">{country.code} · {tour.duration} days</span><h1>{tour.name}</h1><p>{tour.teaser}</p></div></section><section class="summary section-paper"><div class="shell summary-grid"><div><span>Duration</span><b>{tour.duration} days</b></div><div><span>Travel style</span><b>{tour.groupSize}</b></div><div><span>Departures</span><b>{tour.departures.join(' · ')}</b></div><div><span>From</span><b class="red">{formatPrice(locale,tour.prices)}</b></div><a class="btn" href={localizedPath(locale,`/contact?tour=${tour.slug}`)}>Request this journey ↗</a></div></section><section class="section itinerary"><div class="shell route-grid"><div><span class="eyebrow">Day by day</span><h2>A route with a rhythm.</h2><p>We leave room for discovery while every essential detail is looked after.</p></div><div>{tour.itinerary.map(step=><article><span>{step.day}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div></article>)}</div></div></section><section class="section section-dark"><div class="shell details"><div><span class="eyebrow">Included</span><ul>{tour.includes.map(x=><li>{x}</li>)}</ul></div><div><span class="eyebrow">Not included</span><ul>{tour.excludes.map(x=><li>{x}</li>)}</ul></div><aside><h3>Private means personal.</h3><p>Dates, hotels and pace can be adjusted. Your designer will prepare a first route after a short conversation.</p><a class="btn" href={localizedPath(locale,'/contact')}>Start planning ↗</a></aside></div></section><section class="section section-paper"><div class="shell"><div class="section-head"><h2>From the route.</h2><p>Representative launch photography, ready to replace one-for-one in Sanity.</p></div><Gallery client:load images={images} name={tour.name}/></div></section></BaseLayout>
<style>.tour-hero{height:88svh;min-height:680px;position:relative;display:flex;align-items:end;color:var(--cream);padding-bottom:6rem}.tour-hero>img,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{background:linear-gradient(0deg,rgba(4,17,13,.88),transparent 70%)}.tour-hero .shell{position:relative}.tour-hero h1{max-width:1000px;font-size:clamp(4rem,10vw,9rem);margin:.5rem 0 1rem}.tour-hero p{max-width:560px}.summary{padding:2rem 0}.summary-grid{display:flex;gap:2rem;align-items:center}.summary-grid>div{display:flex;flex-direction:column;min-width:120px}.summary span{font:.61rem var(--mono);text-transform:uppercase;letter-spacing:.1em;color:#68736e}.summary b{font:500 .77rem var(--mono)}.summary .red{color:var(--vermilion)}.summary .btn{margin-left:auto}.route-grid{display:grid;grid-template-columns:1fr 1.5fr;gap:7rem}.route-grid>div:first-child{position:sticky;top:3rem;align-self:start}.route-grid h2{margin:.7rem 0 1rem}.route-grid>div:first-child p{color:#68736e}.route-grid article{display:grid;grid-template-columns:85px 1fr;gap:1.5rem;padding:2rem 0;border-top:1px solid #bbb5a8}.route-grid article>span{font:.7rem var(--mono);color:var(--vermilion)}.route-grid article h3{margin-bottom:.6rem}.route-grid article p{color:#68736e}.details{display:grid;grid-template-columns:1fr 1fr 1.7fr;gap:4rem}.details ul{padding-left:1rem}.details li{margin:.6rem 0;color:rgba(243,238,223,.7)}.details aside{border-left:1px solid rgba(243,238,223,.2);padding-left:3rem}.details aside p{color:rgba(243,238,223,.7);margin:1rem 0 1.5rem}@media(max-width:850px){.summary-grid{display:grid;grid-template-columns:1fr 1fr}.summary .btn{margin:0;grid-column:1/-1}.route-grid,.details{grid-template-columns:1fr;gap:2rem}.details aside{border:0;padding:0}.route-grid>div:first-child{position:static}}</style>
