---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Gallery from '../../../../components/Gallery';
import JourneyMap from '../../../../components/JourneyMap.astro';
import {countries,tours,type Country,type Tour} from '../../../../content/data';
import {formatPrice} from '../../../../lib/format';
import {locales,localizedPath,type Locale} from '../../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>tours.map(tour=>({params:{locale,country:tour.country,slug:tour.slug},props:{locale,tour,country:countries.find(c=>c.slug===tour.country)!}})))}
const {locale,tour,country}=Astro.props as {locale:Locale;tour:Tour;country:Country};
const path=`/${country.slug}/tours/${tour.slug}`;
const images=[tour.image,...country.gallery];
const route=tour.route??tour.itinerary.map(step=>step.title.split(',')[0].split('—')[0].trim());
const highlights=tour.highlights??tour.itinerary.map(step=>step.copy);
const accommodation=tour.accommodation??route.slice(0,4).map((place,index)=>({place,nights:index===0?'Arrival stay':'Journey stay',style:'Personally selected character accommodation'}));
const transport=tour.transport??['Private arrival transfer','Comfortable intercity transport','Locally arranged transfers'];
const enquiry=localizedPath(locale,`/contact?tour=${tour.slug}`);
---
<BaseLayout title={`${tour.name} — Way to Asia`} description={tour.teaser} {locale} {path} image={tour.image}>
<section class="tour-hero"><img src={tour.image} alt={`${tour.name} in ${country.name}`} fetchpriority="high"><div class="shade"></div><div class="shell hero-copy"><div class="hero-label"><span>{tour.journeyType??'Signature journey'}</span><span>{tour.tripCode??country.code}</span></div><h1>{tour.name}</h1><p>{tour.teaser}</p><a class="hero-scroll" href="#overview">Explore the journey <span>↓</span></a></div></section>
<nav class="journey-nav" aria-label="Journey sections"><div class="shell"><a href="#overview">Overview</a><a href="#itinerary">Day by day</a><a href="#stays">Accommodation</a><a href="#included">What’s included</a><a class="nav-enquire" href={enquiry}>Plan this journey</a></div></nav>
<main id="overview">
<section class="section-paper intro-section"><div class="shell intro-grid"><div class="intro-copy"><span class="eyebrow">The journey</span><h2>A considered way through {country.name}.</h2><p class="lead">{tour.teaser} Each element is arranged as part of one coherent journey, while dates, room category and pace remain flexible.</p><div class="route-line" aria-label={`Route: ${route.join(' to ')}`}>{route.map((stop,index)=><span><i>{String(index+1).padStart(2,'0')}</i><b>{stop}</b></span>)}</div></div><aside class="planner-card"><span class="eyebrow">Journey at a glance</span><dl><div><dt>Duration</dt><dd>{tour.duration} days</dd></div><div><dt>Journey style</dt><dd>{tour.groupSize}</dd></div><div><dt>Best for</dt><dd>{tour.bestFor??'Culture and discovery'}</dd></div><div><dt>Pace</dt><dd>{tour.pace??'Thoughtfully balanced'}</dd></div><div><dt>Travel window</dt><dd>{tour.departures.join(' · ')}</dd></div><div><dt>Meals</dt><dd>{tour.meals??'Daily breakfast'}</dd></div></dl><div class="price-block"><small>Guide price from</small><strong>{formatPrice(locale,tour.prices)}</strong><p>{tour.priceNote??'Per person. Final price depends on dates and chosen accommodation.'}</p></div><a class="btn" href={enquiry}>Request a proposal ↗</a><small class="response">A travel designer will respond personally.</small></aside></div></section>
<section class="section route-section" id="route"><div class="shell route-map-grid"><div><span class="eyebrow">Route & logistics</span><h2>See how the journey fits together.</h2><p>The route has been designed to minimise backtracking and make long transfers part of the experience. Every reserved sector is detailed in your final travel documents.</p><div class="transport-pills">{transport.map(item=><span>{item}</span>)}</div></div><JourneyMap {route} country={country.slug}/></div></section>
<section class="essentials section-dark" aria-labelledby="essentials-title"><div class="shell"><div class="essentials-head"><span class="eyebrow">Before you enquire</span><h2 id="essentials-title">What the guide price covers.</h2></div><div class="essential-columns"><div><h3>Included</h3><ul>{tour.includes.map(x=><li>{x}</li>)}</ul></div><div><h3>Not included</h3><ul>{tour.excludes.map(x=><li>{x}</li>)}</ul></div></div></div></section>
<section class="section highlights-section"><div class="shell highlights-grid"><div><span class="eyebrow">Why this journey</span><h2>Signature moments, intelligently connected.</h2></div><ol>{highlights.map((highlight,index)=><li><span>{String(index+1).padStart(2,'0')}</span><p>{highlight}</p></li>)}</ol></div></section>
<section class="visual-break"><img src={country.gallery[0]} alt={`${country.name} landscape on the ${tour.name} route`} loading="lazy"><blockquote>“The best journeys leave enough structure to feel effortless—and enough space to feel entirely your own.”</blockquote></section>
<section class="section itinerary-section" id="itinerary"><div class="shell"><div class="section-title"><span class="eyebrow">Complete itinerary</span><h2>{tour.duration} days, day by day.</h2><p>Activities marked optional are not included in the guide price. Final timings and confirmed accommodation are supplied in your personal proposal.</p></div>{tour.dailyItinerary?<div class="daily-list">{tour.dailyItinerary.map(day=><details class="daily" open={day.day===1}><summary><span class="day-number">Day {String(day.day).padStart(2,'0')}</span><span><small>{day.location}</small><strong>{day.title}</strong></span><i aria-hidden="true">+</i></summary><div class="daily-body"><p>{day.summary}</p><div><section><h4>Planned experiences</h4><ul>{day.activities.map(item=><li>{item}</li>)}</ul></section><dl><div><dt>Overnight</dt><dd>{day.overnight}</dd></div><div><dt>Meals</dt><dd>{day.meals}</dd></div>{day.transport&&<div><dt>Transport</dt><dd>{day.transport}</dd></div>}</dl></div></div></details>)}</div>:<div class="days">{tour.itinerary.map((step,index)=><article class="day-card"><div class="day-image"><img src={country.gallery[index%country.gallery.length]} alt={`${step.title}, ${country.name}`} loading="lazy"><span>Stage {String(index+1).padStart(2,'0')}</span></div><div class="day-copy"><span class="eyebrow">Days {step.day}</span><h3>{step.title}</h3><p>{step.copy}</p></div></article>)}</div>}</div></section>
<section class="section section-dark" id="stays"><div class="shell stay-grid"><div class="stay-intro"><span class="eyebrow">Where you stay</span><h2>Character, comfort and a sense of place.</h2><p>Named properties are confirmed in your proposal. If an alternative is required, we match its location, quality and character—not simply its star rating.</p></div><div class="stay-list">{accommodation.map((stay,index)=><article><span>{String(index+1).padStart(2,'0')}</span><div><h3>{stay.place}</h3><p>{stay.nights}</p><small>{stay.style}</small></div></article>)}</div></div></section>
<section class="section section-paper" id="included"><div class="shell practical-grid"><div class="included"><span class="eyebrow">The details</span><h2>Clear before you travel.</h2><div class="two-lists"><div><h3>Included</h3><ul>{tour.includes.map(x=><li>{x}</li>)}</ul></div><div><h3>Not included</h3><ul>{tour.excludes.map(x=><li>{x}</li>)}</ul></div></div></div><aside class="transport"><span class="eyebrow">Getting around</span><h3>Transport is part of the design.</h3><ul>{transport.map(x=><li>{x}</li>)}</ul><p>Exact timings, tickets and transfer instructions are included in your final travel documents.</p></aside></div></section>
<section class="section gallery-section"><div class="shell"><div class="section-head"><h2>Scenes from the route.</h2><p>Representative launch photography. Final hotel and experience imagery will be managed with each journey in Sanity.</p></div><Gallery client:load images={images} name={tour.name}/></div></section>
<section class="final-cta"><img src={country.gallery[2]} alt=""><div class="shade"></div><div><span class="eyebrow">Designed around you</span><h2>Make this journey yours.</h2><p>Tell us what draws you to {country.name}. We will shape the stays, pacing and experiences into a personal proposal.</p><a class="btn" href={enquiry}>Start planning ↗</a></div></section>
</main></BaseLayout>
<style>
.tour-hero{height:88svh;min-height:700px;position:relative;display:flex;align-items:end;color:var(--cream);padding-bottom:6rem}.tour-hero>img,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{background:linear-gradient(90deg,rgba(4,17,13,.88) 0%,rgba(4,17,13,.35) 58%,rgba(4,17,13,.1)),linear-gradient(0deg,rgba(4,17,13,.8),transparent 55%)}.hero-copy{position:relative}.hero-label{display:flex;gap:1.2rem;font:500 .67rem var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}.hero-label span+span{border-left:1px solid rgba(255,255,255,.35);padding-left:1.2rem}.tour-hero h1{max-width:990px;font-size:clamp(4rem,9vw,8.5rem);margin:.65rem 0 1.2rem}.tour-hero p{max-width:650px;font-size:clamp(1.05rem,1.8vw,1.35rem);color:rgba(255,255,255,.85)}.hero-scroll{display:inline-flex;gap:2rem;margin-top:2rem;border-bottom:1px solid rgba(255,255,255,.5);padding-bottom:.45rem;font:.69rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.journey-nav{position:sticky;top:0;z-index:20;background:rgba(243,238,223,.96);backdrop-filter:blur(14px);border-bottom:1px solid #d4ccbd}.journey-nav .shell{height:64px;display:flex;align-items:center;gap:2rem}.journey-nav a{font:500 .67rem var(--mono);text-transform:uppercase;letter-spacing:.08em}.journey-nav .nav-enquire{margin-left:auto;background:var(--vermilion);color:#fff;padding:.75rem 1rem}.intro-section{padding:7rem 0}.intro-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(320px,.65fr);gap:8vw;align-items:start}.intro-copy h2{margin:.8rem 0 1.7rem}.lead{font-size:1.2rem;max-width:700px;color:#4f5c56}.route-line{display:flex;flex-wrap:wrap;margin-top:3rem;padding-top:1.7rem;border-top:1px solid #c9c0af}.route-line span{display:flex;align-items:center;gap:.6rem;font:500 .72rem var(--mono)}.route-line span:not(:last-child):after{content:'→';color:var(--vermilion);margin:0 1rem}.route-line i{font-style:normal;color:var(--vermilion);font-size:.6rem}.planner-card{background:var(--ink);color:var(--cream);padding:2.2rem;box-shadow:0 24px 60px rgba(15,33,28,.18);position:sticky;top:92px}.planner-card .eyebrow{color:var(--gold)}.planner-card dl{margin:1.4rem 0}.planner-card dl div{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 0;border-bottom:1px solid rgba(255,255,255,.2)}.planner-card dt{color:#c2ccc7;font-size:.78rem}.planner-card dd{margin:0;text-align:right;font-size:.78rem;color:#f3eedf}.price-block{padding:1.2rem 0 1.5rem}.price-block small{display:block;color:var(--gold);font:500 .65rem var(--mono);text-transform:uppercase}.price-block strong{display:block;font:500 2.2rem var(--display);margin:.15rem 0}.price-block p,.response{color:#b7c3bd;font-size:.7rem}.planner-card .btn{width:100%}.response{display:block;text-align:center;margin-top:.8rem}.highlights-section{background:#faf7ef}.highlights-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw}.highlights-grid h2{margin-top:.8rem}.highlights-grid ol{list-style:none;margin:0;padding:0}.highlights-grid li{display:grid;grid-template-columns:55px 1fr;gap:1rem;padding:1.45rem 0;border-top:1px solid #d4ccbd}.highlights-grid li span{font:.65rem var(--mono);color:var(--vermilion)}.highlights-grid li p{font-size:1.08rem}.visual-break{height:72vh;min-height:580px;position:relative}.visual-break img{width:100%;height:100%}.visual-break:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,17,13,.65),transparent)}.visual-break blockquote{position:absolute;z-index:1;left:max(calc((100vw - 1180px)/2),20px);bottom:12%;max-width:620px;margin:0;color:white;font:500 clamp(2rem,4.5vw,4rem)/1.08 var(--display)}.itinerary-section{background:#f7f3e9}.section-title{max-width:760px;margin-bottom:5rem}.section-title h2{margin:.7rem 0 1rem}.section-title p{color:#617069}.days{display:grid;gap:6rem}.day-card{display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center}.day-card:nth-child(even) .day-image{order:2}.day-image{position:relative}.day-image img{width:100%;aspect-ratio:4/3}.day-image>span{position:absolute;left:0;bottom:0;background:var(--ink);color:var(--cream);padding:.8rem 1rem;font:.65rem var(--mono);text-transform:uppercase}.day-copy h3{font-size:clamp(2rem,4vw,3.7rem);margin:.6rem 0 1.2rem}.day-copy>p{color:#53615a;font-size:1.02rem}.overnight{display:flex;gap:1.5rem;margin-top:1.7rem;padding-top:1rem;border-top:1px solid #d4ccbd;font-size:.75rem}.overnight b{font-family:var(--mono);text-transform:uppercase;color:var(--vermilion)}.stay-grid{display:grid;grid-template-columns:1fr 1fr;gap:9vw}.stay-intro{position:sticky;top:110px;align-self:start}.stay-intro h2{margin:.7rem 0 1.5rem}.stay-intro p{color:rgba(255,255,255,.62);max-width:500px}.stay-list article{display:grid;grid-template-columns:55px 1fr;padding:1.6rem 0;border-top:1px solid rgba(255,255,255,.2)}.stay-list article>span{font:.65rem var(--mono);color:var(--gold)}.stay-list h3{font-size:1.6rem}.stay-list p{color:var(--cream)}.stay-list small{color:rgba(255,255,255,.55)}.practical-grid{display:grid;grid-template-columns:1.5fr .65fr;gap:8vw}.included h2{margin:.7rem 0 2.5rem}.two-lists{display:grid;grid-template-columns:1fr 1fr;gap:3rem}.two-lists h3,.transport h3{font-size:1.5rem;margin-bottom:1rem}.two-lists ul,.transport ul{list-style:none;padding:0;margin:0}.two-lists li,.transport li{padding:.55rem 0 .55rem 1.5rem;position:relative;border-bottom:1px solid #d4ccbd}.two-lists li:before,.transport li:before{content:'✓';position:absolute;left:0;color:var(--vermilion)}.two-lists div+div li:before{content:'—'}.transport{background:#fff;padding:2rem;align-self:start}.transport h3{margin-top:.7rem}.transport p{font-size:.8rem;color:#617069;margin-top:1.5rem}.gallery-section{background:#f7f3e9}.final-cta{height:70vh;min-height:560px;position:relative;display:grid;place-items:center;text-align:center;color:white}.final-cta>img{position:absolute;inset:0;width:100%;height:100%}.final-cta .shade{background:rgba(4,17,13,.66)}.final-cta>div:last-child{position:relative;max-width:760px;padding:2rem}.final-cta h2{margin:.7rem 0 1rem}.final-cta p{margin:0 auto 1.8rem;max-width:600px;color:rgba(255,255,255,.75)}
.route-section{background:#faf7ef}.route-map-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:7vw;align-items:center}.route-map-grid h2{margin:.7rem 0 1.2rem}.route-map-grid p{color:#59665f}.transport-pills{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}.transport-pills span{border:1px solid #c7bdad;padding:.45rem .7rem;font:500 .62rem var(--mono);text-transform:uppercase}.essentials{padding:5rem 0}.essentials-head{display:grid;grid-template-columns:.5fr 1.5fr;gap:3rem;align-items:end;margin-bottom:3rem}.essential-columns{display:grid;grid-template-columns:1fr 1fr;gap:5vw}.essential-columns>div{border-top:1px solid rgba(255,255,255,.22);padding-top:1.5rem}.essential-columns h3{margin-bottom:1rem}.essential-columns ul{list-style:none;margin:0;padding:0}.essential-columns li{position:relative;padding:.55rem 0 .55rem 1.7rem;color:rgba(255,255,255,.72);border-bottom:1px solid rgba(255,255,255,.1)}.essential-columns li:before{content:'✓';position:absolute;left:0;color:var(--gold)}.essential-columns>div+div li:before{content:'—';color:#d97967}.daily-list{border-top:1px solid #c8bfaf}.daily{border-bottom:1px solid #c8bfaf}.daily summary{list-style:none;display:grid;grid-template-columns:90px 1fr 30px;gap:1rem;align-items:center;padding:1.6rem 0;cursor:pointer}.daily summary::-webkit-details-marker{display:none}.day-number{font:500 .68rem var(--mono);color:var(--vermilion)}.daily summary small{display:block;color:#6b756f;font:500 .62rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.daily summary strong{font:500 clamp(1.25rem,2.5vw,2rem) var(--display)}.daily summary i{font-style:normal;font-size:1.8rem;transition:transform .2s}.daily[open] summary i{transform:rotate(45deg)}.daily-body{padding:0 0 2.4rem 106px}.daily-body>p{max-width:760px;font-size:1.05rem;color:#526059;margin-bottom:1.5rem}.daily-body>div{display:grid;grid-template-columns:1fr .75fr;gap:5vw}.daily-body h4{margin:0 0 .6rem;font:500 .68rem var(--mono);text-transform:uppercase;letter-spacing:.1em}.daily-body ul{margin:0;padding-left:1.2rem}.daily-body li{margin:.35rem 0}.daily-body dl{margin:0;background:#eee7d9;padding:1.2rem}.daily-body dl div{display:grid;grid-template-columns:85px 1fr;gap:1rem;padding:.45rem 0;border-bottom:1px solid #d4ccbd}.daily-body dt{font:500 .62rem var(--mono);text-transform:uppercase;color:#6b756f}.daily-body dd{margin:0;font-size:.78rem}
@media(max-width:850px){.journey-nav a:not(.nav-enquire):not(:first-child){display:none}.journey-nav .shell{gap:1rem}.intro-grid,.highlights-grid,.stay-grid,.practical-grid,.route-map-grid,.essential-columns,.essentials-head{grid-template-columns:1fr}.planner-card,.stay-intro{position:static}.day-card{grid-template-columns:1fr;gap:2rem}.day-card:nth-child(even) .day-image{order:0}.two-lists{grid-template-columns:1fr}.tour-hero{min-height:620px}.visual-break{min-height:480px}.route-line span:not(:last-child):after{margin:0 .5rem}.intro-section{padding:4.5rem 0}.days{gap:4rem}.daily summary{grid-template-columns:62px 1fr 22px}.daily-body{padding-left:0}.daily-body>div{grid-template-columns:1fr}}
</style>
