---
import BaseLayout from '../../../../layouts/BaseLayout.astro';import TourCard from '../../../../components/TourCard.astro';import {countries,tours,type Country} from '../../../../content/data';import {locales,tr,localizeContent,type Locale} from '../../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>countries.map(country=>({params:{locale,country:country.slug},props:{locale,country:localizeContent(locale,country)}})))}const {locale,country}=Astro.props as {locale:Locale;country:Country};const list=localizeContent(locale,tours.filter(t=>t.country===country.slug));const path=`/${country.slug}/tours`;
---
<BaseLayout title={`${country.name} ${tr(locale,'tours')} — Way to Asia`} description={tr(locale,'Private and small-group journeys through {country}.',{country:country.name})} {locale} {path} image={country.hero}><section class="mast" style={`--hero:url('${country.hero}')`}><div class="shell"><span class="eyebrow">{country.code} · {tr(locale,'Journey collection')}</span><h1>{country.name},<br>{tr(locale,'with time.')}</h1></div></section><section class="section section-paper"><div class="shell"><div class="section-head"><h2>{tr(locale,'Journeys through {country}.',{country:country.name})}</h2><p>{tr(locale,'Each is a starting point, designed to be adjusted in conversation with you.')}</p></div><div class="cards">{list.map(tour=><TourCard {tour} {locale}/>)}</div></div></section></BaseLayout>
<style>.mast{min-height:680px;background:linear-gradient(0deg,rgba(5,18,14,.8),rgba(5,18,14,.15)),var(--hero) center/cover;display:flex;align-items:end;color:var(--cream);padding:0 0 6rem}.mast h1{margin-top:.7rem}.cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}@media(max-width:1000px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.cards{grid-template-columns:1fr}}</style>
