---
import {photoSize,photoSrcSet} from '../../../lib/photoSize';
import BaseLayout from '../../../layouts/BaseLayout.astro';import TourCard from '../../../components/TourCard.astro';import Gallery from '../../../components/Gallery';import {countries,tours,type Country} from '../../../content/data';import {locales,localizedPath,t,tr,localizeContent,type Locale} from '../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>countries.map(country=>({params:{locale,country:country.slug},props:{locale,country:localizeContent(locale,country)}})))} const {locale,country}=Astro.props as {locale:Locale;country:Country};const countryTours=localizeContent(locale,tours.filter(x=>x.country===country.slug));const path=`/${country.slug}`;
---
<BaseLayout title={tr(locale,'{country} tailor-made travel — Way to Asia',{country:country.name})} description={country.intro} {locale} {path} image={country.hero}>
 <section class="country-hero"><img src={photoSize(country.hero,1600)} srcset={photoSrcSet(country.hero)} sizes="100vw" alt={country.name} fetchpriority="high"><div class="shade"></div><div class="shell title"><span class="eyebrow">{country.code} · {tr(locale,'Destination')}</span><h1>{country.name}</h1><p>{country.nativeName !== country.name ? country.nativeName : null}</p></div></section>
 <section class="section intro section-paper"><div class="shell intro-grid"><div><p>{country.intro}</p></div><aside><b>{tr(locale,'Best approached')}</b><p>{country.practical[0]}</p></aside></div></section>
 <section class="section section-dark"><div class="shell"><div class="section-head"><div><span class="eyebrow">{countryTours.length} {tr(locale,'journeys')} · {country.code}</span><h2>{tr(locale,'Routes through {country}.',{country:country.name})}</h2></div><a class="btn outline" href={localizedPath(locale,`/${country.slug}/tours`)}>{tr(locale,'Compare all {country} journeys',{country:country.name})} ↗</a></div><div class="cards journey-cards">{countryTours.map(tour=><TourCard {tour} {locale}/>)}</div></div></section>
 <section class="section editorial"><div class="shell"><div class="section-head"><div><span class="eyebrow">{t(locale,'things')}</span><h2>A country in chapters.</h2></div><p>We shape each journey through distinct regions, allowing enough time for the character of each place to emerge.</p></div><div class="regions">{country.regions.map((r,i)=><article><span>0{i+1}</span><h3>{r.name}</h3><p>{r.copy}</p></article>)}</div><div class="practical"><div><span class="eyebrow">At the table</span><h3>Food is part of the route.</h3><p>Market mornings, family kitchens and thoughtful restaurants connect landscape, season and culture.</p></div><div><span class="eyebrow">Practical notes</span><ul>{country.practical.map(p=><li>{p}</li>)}</ul></div></div></div></section>
 <section class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">{t(locale,'gallery')}</span><h2>Light, texture, atmosphere.</h2></div><p>A first impression. Every image slot maps directly to a Sanity asset, ready for the final client photography.</p></div><Gallery client:load images={country.gallery} name={country.name} labels={Object.fromEntries(['Gallery','Travel photograph','Previous photograph','Next photograph','Show photograph','Close gallery'].map(s=>[s,tr(locale,s)]))}/></div></section>
 <section class="cta"><div class="shell"><span class="eyebrow">Begin a conversation</span><h2>{tr(locale,'Let’s compose your {country}.',{country:country.name})}</h2><a class="btn" href={localizedPath(locale,'/contact')}>{t(locale,'inquire')} ↗</a></div></section>
</BaseLayout>
<style>.country-hero{height:88svh;min-height:690px;position:relative;background:var(--ink);color:var(--cream);display:flex;align-items:end;padding-bottom:9rem}.country-hero>img,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{background:linear-gradient(0deg,rgba(5,18,14,.85),transparent 65%)}.title{position:relative}.title h1{font-size:clamp(5rem,14vw,12rem)}.title p{font:1.3rem var(--display);color:var(--gold)}.route{position:absolute;bottom:1.3rem;left:50%;transform:translateX(-50%)}.intro-grid{display:grid;grid-template-columns:1fr 3fr 1fr;gap:4rem;align-items:start}.intro h2{font-size:clamp(2.2rem,4.5vw,4rem);margin-bottom:1.5rem}.intro-grid>div>p{max-width:680px;font-size:1.05rem}.intro aside{border-top:1px solid var(--gold);padding-top:1rem}.intro aside b{font:.65rem var(--mono);text-transform:uppercase;letter-spacing:.1em}.intro aside p{font-size:.78rem;margin-top:.6rem}.section-dark .card{color:var(--ink-text)}.journey-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.editorial{background:var(--cream)}.regions{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #b9b5a7}.regions article{padding:2rem;border-right:1px solid #b9b5a7}.regions article:last-child{border:0}.regions span{font:.7rem var(--mono);color:var(--vermilion)}.regions h3{margin:2rem 0 .8rem}.regions p{color:#69716e}.practical{margin-top:3.5rem;background:var(--ink);color:var(--cream);display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding:clamp(2rem,5vw,5rem)}.practical h3{margin:.7rem 0}.practical p,.practical li{color:rgba(243,238,223,.7)}.practical li{margin-bottom:.7rem}.cta{text-align:center;background:var(--jade);padding:6rem 0}.cta h2{font-size:clamp(3rem,7vw,6rem);margin:.8rem auto 2rem}@media(max-width:1000px){.journey-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.country-hero{min-height:640px}.intro-grid{grid-template-columns:1fr;gap:2rem}.journey-cards{grid-template-columns:1fr}.regions{grid-template-columns:1fr}.regions article{border-right:0;border-bottom:1px solid #b9b5a7}.practical{grid-template-columns:1fr;gap:2rem}}</style>

<style>
.country-hero{height:300px;min-height:0;margin-top:86px;padding:0 0 28px;align-items:end}.title h1{font-size:clamp(2.5rem,5vw,4rem);line-height:1.05;margin:10px 0 0}.title p{font-size:1rem;margin:8px 0 0}.title p:empty{display:none}.shade{background:linear-gradient(0deg,rgba(5,18,14,.8),transparent 80%)}
.section{padding:32px 0}.intro{padding:24px 0}.intro-grid{grid-template-columns:minmax(0,3fr) minmax(180px,1fr);gap:32px}.intro-grid>div>p{max-width:850px;font-size:1rem;line-height:1.55;margin:0}.intro aside{padding:0 0 0 20px;border-top:0;border-left:1px solid var(--gold)}.intro aside p{margin:6px 0 0}.section-head{margin-bottom:20px;gap:20px}.section-head h2{font-size:clamp(1.65rem,2.5vw,2.2rem);margin:6px 0 0}.journey-cards{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.regions article{padding:20px}.regions h3{margin:12px 0 8px}.practical{margin-top:24px;padding:24px;gap:28px}.cta{padding:32px 0}.cta h2{font-size:clamp(1.8rem,3vw,2.5rem);margin:8px auto 20px}
@media(max-width:1000px){.journey-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:800px){.country-hero{margin-top:72px;height:220px;min-height:0;padding-bottom:22px}.title h1{font-size:2.6rem}.section{padding:24px 0}.intro{padding:20px 0}.intro-grid{grid-template-columns:1fr;gap:14px}.intro aside{padding-left:12px}.practical{padding:20px;gap:20px}.cta{padding:24px 0}}
@media(max-width:560px){.journey-cards{grid-template-columns:1fr}}
</style>
