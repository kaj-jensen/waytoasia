---
import BaseLayout from '../../../layouts/BaseLayout.astro';import RouteMap from '../../../components/RouteMap.astro';import TourCard from '../../../components/TourCard.astro';import Gallery from '../../../components/Gallery';import {countries,tours,type Country} from '../../../content/data';import {locales,localizedPath,t,type Locale} from '../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>countries.map(country=>({params:{locale,country:country.slug},props:{locale,country}})))} const {locale,country}=Astro.props as {locale:Locale;country:Country};const countryTours=tours.filter(x=>x.country===country.slug);const path=`/${country.slug}`;
---
<BaseLayout title={`${country.name} tailor-made travel — Way to Asia`} description={country.intro} {locale} {path} image={country.hero}>
 <section class="country-hero"><img src={country.hero} alt={country.alt} fetchpriority="high"><div class="shade"></div><div class="shell title"><span class="eyebrow">{country.code} · Destination</span><h1>{country.name}</h1><p>{country.nativeName}</p></div><div class="shell route"><RouteMap active={country.slug}/></div></section>
 <section class="section intro section-paper"><div class="shell intro-grid"><span class="eyebrow">A sense of place</span><div><h2>{country.intro.split('.')[0]}.</h2><p>{country.intro}</p></div><aside><b>Best approached</b><p>{country.practical[0]}</p></aside></div></section>
 <section class="section section-dark"><div class="shell"><div class="section-head"><div><span class="eyebrow">Journeys · {country.code}</span><h2>Routes through {country.name}.</h2></div><a class="btn outline" href={localizedPath(locale,`/${country.slug}/tours`)}>All {country.name} journeys ↗</a></div><div class="cards">{countryTours.map(tour=><TourCard {tour} {locale}/>)}</div></div></section>
 <section class="section editorial"><div class="shell"><div class="section-head"><div><span class="eyebrow">{t(locale,'things')}</span><h2>A country in chapters.</h2></div><p>We shape each journey through distinct regions, allowing enough time for the character of each place to emerge.</p></div><div class="regions">{country.regions.map((r,i)=><article><span>0{i+1}</span><h3>{r.name}</h3><p>{r.copy}</p></article>)}</div><div class="practical"><div><span class="eyebrow">At the table</span><h3>Food is part of the route.</h3><p>Market mornings, family kitchens and thoughtful restaurants connect landscape, season and culture.</p></div><div><span class="eyebrow">Practical notes</span><ul>{country.practical.map(p=><li>{p}</li>)}</ul></div></div></div></section>
 <section class="section section-paper"><div class="shell"><div class="section-head"><div><span class="eyebrow">{t(locale,'gallery')}</span><h2>Light, texture, atmosphere.</h2></div><p>A first impression. Every image slot maps directly to a Sanity asset, ready for the final client photography.</p></div><Gallery client:load images={country.gallery} name={country.name}/></div></section>
 <section class="cta"><div class="shell"><span class="eyebrow">Begin a conversation</span><h2>Let’s compose your {country.name}.</h2><a class="btn" href={localizedPath(locale,'/contact')}>{t(locale,'inquire')} ↗</a></div></section>
</BaseLayout>
<style>.country-hero{height:88svh;min-height:690px;position:relative;background:var(--ink);color:var(--cream);display:flex;align-items:end;padding-bottom:9rem}.country-hero>img,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{background:linear-gradient(0deg,rgba(5,18,14,.85),transparent 65%)}.title{position:relative}.title h1{font-size:clamp(5rem,14vw,12rem)}.title p{font:1.3rem var(--display);color:var(--gold)}.route{position:absolute;bottom:1.3rem;left:50%;transform:translateX(-50%)}.intro-grid{display:grid;grid-template-columns:1fr 3fr 1fr;gap:4rem;align-items:start}.intro h2{font-size:clamp(2.2rem,4.5vw,4rem);margin-bottom:1.5rem}.intro-grid>div>p{max-width:680px;font-size:1.05rem}.intro aside{border-top:1px solid var(--gold);padding-top:1rem}.intro aside b{font:.65rem var(--mono);text-transform:uppercase;letter-spacing:.1em}.intro aside p{font-size:.78rem;margin-top:.6rem}.section-dark .card{color:var(--ink-text)}.editorial{background:var(--cream)}.regions{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #b9b5a7}.regions article{padding:2rem;border-right:1px solid #b9b5a7}.regions article:last-child{border:0}.regions span{font:.7rem var(--mono);color:var(--vermilion)}.regions h3{margin:2rem 0 .8rem}.regions p{color:#69716e}.practical{margin-top:5rem;background:var(--ink);color:var(--cream);display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding:clamp(2rem,5vw,5rem)}.practical h3{margin:.7rem 0}.practical p,.practical li{color:rgba(243,238,223,.7)}.practical li{margin-bottom:.7rem}.cta{text-align:center;background:var(--jade);padding:8rem 0}.cta h2{font-size:clamp(3rem,7vw,6rem);margin:.8rem auto 2rem}@media(max-width:800px){.country-hero{min-height:640px}.intro-grid{grid-template-columns:1fr;gap:2rem}.regions{grid-template-columns:1fr}.regions article{border-right:0;border-bottom:1px solid #b9b5a7}.practical{grid-template-columns:1fr;gap:2rem}}</style>
