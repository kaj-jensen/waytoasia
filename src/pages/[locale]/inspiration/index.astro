---
import {photoSize,photoSrcSet} from '../../../lib/photoSize';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {articles,countries} from '../../../content/data';
import {locales,localizedPath,tr,type Locale} from '../../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}
const {locale}=Astro.props as {locale:Locale};
const storyCountries=[...countries.map(({slug,name})=>({slug,name})),{slug:"japan",name:tr(locale,'Japan')}];
---
<BaseLayout title="Travel stories and practical insight — Way to Asia" description="Seasonal guidance, cultural context and considered routes across Asia." {locale} path="/inspiration">
 <section class="compact-intro"><div class="shell"><h1>The field journal</h1><p>Ideas, practical knowledge and cultural context from the people who shape our journeys.</p></div></section>
 <section class="section section-paper journal-content"><div class="shell"><div class="topics" aria-label="Story topics"><span>Explore:</span><a href="#all">All stories</a>{storyCountries.map(c=><a href={`#${c.slug}`}>{c.name}</a>)}</div><div id="all" class="country-stories">{storyCountries.map(country=><section id={country.slug} class="country-group" aria-labelledby={`heading-${country.slug}`}><h2 id={`heading-${country.slug}`}>{country.name}</h2><div class="stories">{articles.filter(article=>article.country===country.slug).map(article=><a class="story" href={localizedPath(locale,`/inspiration/${article.slug}`)}><div class="media"><img src={photoSize(article.image,768)} srcset={photoSrcSet(article.image,[480,768,1200,1600])} sizes="(max-width: 750px) 100vw, 50vw" width="1600" height="1067" alt={article.imageAlt??article.title} loading="lazy" decoding="async" style={article.slug==='slow-route-northern-vietnam'?'object-position:50% 80%':undefined}></div><div class="body"><span>{article.category} · {article.readTime}</span><h3>{article.title}</h3><p>{article.standfirst}</p><b>Read the story ↗</b></div></a>)}</div></section>)}</div></div></section>
</BaseLayout>
<style>.country-group{scroll-margin-top:100px;padding-top:2rem}.country-group>h2{font-size:1.35rem;margin:0 0 1rem}.country-group .story:last-child:nth-child(odd){display:grid;grid-template-columns:1.15fr 1fr;grid-column:1/-1}.country-group .story:last-child:nth-child(odd) .media{height:320px;min-height:0}.stories{align-items:stretch}.body{align-self:center}@media(max-width:750px){.country-group .story:last-child:nth-child(odd){grid-template-columns:1fr}.country-group .story:last-child:nth-child(odd) .media{height:220px;min-height:0}}.journal-content{padding-top:0}.topics{display:flex;gap:1.5rem;flex-wrap:wrap;padding-bottom:2rem;border-bottom:1px solid #b8b1a2;font:.66rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.topics span{color:var(--vermilion-dark)}.stories{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#b8b1a2}.story{background:var(--paper)}.story.lead{grid-column:1/-1;display:grid;grid-template-columns:1.25fr 1fr}.media{overflow:hidden;height:320px;position:relative}.media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s}.story:hover img{transform:scale(1.035)}.body{padding:clamp(1.25rem,2vw,1.75rem)}.body>span,.body b{font:.62rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.body>span{color:var(--vermilion-dark)}.body h3{font-size:clamp(1.7rem,3vw,2.5rem);margin:.7rem 0 1rem}.body p{color:#526058}.body b{display:block;margin-top:2rem;color:var(--vermilion-dark)}@media(max-width:750px){.media{height:220px}.stories,.story.lead{display:grid;grid-template-columns:1fr}.story.lead{grid-column:auto}}</style>
