---
import {photoSize,photoSrcSet} from '../../../lib/photoSize';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {articles,countries,type Article} from '../../../content/data';
import {locales,localizedPath,tr,localizeContent,type Locale} from '../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>articles.map(article=>({params:{locale,slug:article.slug},props:{locale,article:localizeContent(locale,article)}})))}
const {locale,article}=Astro.props as {locale:Locale;article:Article};
const articleUrl=new URL(`/${locale}/inspiration/${article.slug}/`,Astro.site).href;
const articleSchema={'@context':'https://schema.org','@type':'BlogPosting',headline:article.title,description:article.standfirst,datePublished:article.published,inLanguage:locale,image:new URL(article.image,Astro.site).href,mainEntityOfPage:articleUrl,publisher:{'@id':new URL('/#organization',Astro.site).href}};
const countryName=countries.find(country=>country.slug===article.country)?.name??tr(locale,'Japan');
---
<BaseLayout title={`${article.title} — Way to Asia`} description={article.standfirst} {locale} path={`/inspiration/${article.slug}`} image={article.image}>
 <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
 <article><header><img src={photoSize(article.image,1200)} srcset={photoSrcSet(article.image,[480,768,1200,1600])} sizes="(max-width: 800px) 100vw, 50vw" width="1600" height="1067" decoding="async" alt={article.imageAlt??article.title} fetchpriority="high" style={article.country==='japan'?'object-position:50% 38%':article.slug==='slow-route-northern-vietnam'?'object-position:50% 80%':undefined}><span class="shade"></span><div class="shell"><span class="eyebrow">{article.category} · {article.readTime}</span><h1>{article.title}</h1><p>{article.standfirst}</p></div></header><div class="shell article-grid"><aside><span>Destination</span><a href={localizedPath(locale,article.country==='japan'?'/inspiration#japan':`/${article.country}`)}>{countryName} ↗</a></aside><div class="prose">{article.body.map((paragraph,i)=>i===0?<p class="opening">{paragraph}</p>:<p>{paragraph}</p>)}<hr><h2>Make it part of your journey.</h2><p>Our specialists can use this idea as one element in a route designed around your season, pace and interests.</p><a class="btn" href={localizedPath(locale,article.country==='japan'?'/trip-planner':`/contact?destination=${article.country}`)}>Start planning ↗</a></div></div></article>
</BaseLayout>
<style>header{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:2.5rem;padding:100px max(24px,calc((100vw - 1280px)/2)) 32px;background:var(--paper)}header>img{width:100%;height:420px;object-fit:cover}.shade{display:none}header .shell{width:auto;padding:0}header h1{font-size:clamp(2rem,3.5vw,3.5rem);margin:.7rem 0 1rem}header p{color:#526058;max-width:650px}@media(max-width:800px){header{grid-template-columns:1fr;gap:1.25rem;padding-top:86px}header>img{height:260px}}.article-grid{display:grid;grid-template-columns:220px minmax(0,700px);gap:clamp(3rem,8vw,9rem);padding-block:3rem}.article-grid aside{display:flex;flex-direction:column;font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.08em;align-self:start;gap:.4rem}.article-grid aside span{color:var(--vermilion);margin-top:0}.article-grid aside a{font-weight:600;text-transform:capitalize}.prose p{font-size:1.05rem;margin-bottom:1.6rem;color:#42504a}.prose .opening{font:500 clamp(1.6rem,3vw,2.3rem)/1.45 var(--display);color:var(--ink)}.prose hr{border:0;border-top:1px solid #b7b0a2;margin:2rem 0}.prose h2{font-size:clamp(2.4rem,5vw,4rem);margin-bottom:1.2rem}.prose .btn{margin-top:1rem}@media(max-width:700px){.article-grid{grid-template-columns:1fr;padding-block:1.25rem 2rem;gap:1.25rem}.article-grid aside{flex-direction:row;align-items:center;gap:.65rem}.prose .opening{font-size:1.4rem;line-height:1.5}.prose h2{font-size:1.8rem}header{padding-bottom:1.25rem}header h1{margin:.5rem 0 .75rem}header p{margin-bottom:0}}</style>
