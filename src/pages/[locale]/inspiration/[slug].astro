---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {articles,type Article} from '../../../content/data';
import {locales,localizedPath,type Locale} from '../../../i18n';
export function getStaticPaths(){return locales.flatMap(locale=>articles.map(article=>({params:{locale,slug:article.slug},props:{locale,article}})))}
const {locale,article}=Astro.props as {locale:Locale;article:Article};
---
<BaseLayout title={`${article.title} — Way to Asia`} description={article.standfirst} {locale} path={`/inspiration/${article.slug}`} image={article.image}>
 <article><header><img src={article.image} alt="" fetchpriority="high"><span class="shade"></span><div class="shell"><span class="eyebrow">{article.category} · {article.readTime}</span><h1>{article.title}</h1><p>{article.standfirst}</p></div></header><div class="shell article-grid"><aside><span>Published</span><time datetime={article.published}>{new Intl.DateTimeFormat(locale,{dateStyle:'long'}).format(new Date(article.published))}</time><span>Destination</span><a href={localizedPath(locale,`/${article.country}`)}>{article.country} ↗</a></aside><div class="prose">{article.body.map((paragraph,i)=>i===0?<p class="opening">{paragraph}</p>:<p>{paragraph}</p>)}<hr><h2>Make it part of your journey.</h2><p>Our specialists can use this idea as one element in a route designed around your season, pace and interests.</p><a class="btn" href={localizedPath(locale,`/contact?destination=${article.country}`)}>Start planning ↗</a></div></div></article>
</BaseLayout>
<style>header{height:82svh;min-height:650px;position:relative;display:flex;align-items:end;color:var(--cream);padding-bottom:6rem;background:var(--ink)}header>img,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{background:linear-gradient(0deg,rgba(5,18,14,.9),rgba(5,18,14,.08) 70%)}header .shell{position:relative}header h1{max-width:950px;margin:.7rem 0 1rem}header p{max-width:650px;color:rgba(243,238,223,.75)}.article-grid{display:grid;grid-template-columns:220px minmax(0,700px);gap:clamp(3rem,8vw,9rem);padding-block:7rem}.article-grid aside{display:flex;flex-direction:column;font:.7rem var(--mono);text-transform:uppercase;letter-spacing:.08em}.article-grid aside span{color:var(--vermilion);margin-top:1.2rem}.article-grid aside a{font-weight:600;text-transform:capitalize}.prose p{font-size:1.05rem;margin-bottom:1.6rem;color:#42504a}.prose .opening{font:500 clamp(1.6rem,3vw,2.3rem)/1.45 var(--display);color:var(--ink)}.prose hr{border:0;border-top:1px solid #b7b0a2;margin:4rem 0}.prose h2{font-size:clamp(2.4rem,5vw,4rem);margin-bottom:1.2rem}.prose .btn{margin-top:1rem}@media(max-width:700px){.article-grid{grid-template-columns:1fr;padding-block:4rem}.article-grid aside{display:grid;grid-template-columns:1fr 1fr;gap:.3rem 1rem}}</style>
