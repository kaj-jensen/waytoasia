---
import BaseLayout from '../../layouts/BaseLayout.astro';import {locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}const {locale}=Astro.props as {locale:Locale};
---
<BaseLayout title="Our travel studio — Way to Asia" description="Why Way to Asia designs fewer, better journeys." {locale} path="/about"><section class="mast"><div class="shell"><span class="eyebrow">Our studio</span><h1>Travel is personal.<br>Planning should be too.</h1></div></section><section class="section section-paper"><div class="shell manifesto"><span class="eyebrow">Our point of view</span><div><h2>Fewer places.<br>Deeper connections.</h2><p>Way to Asia is a travel studio for people who want the confidence of thoughtful planning without losing the freedom of discovery. We work with a small network of guides, hosts and specialists across five countries.</p><p>Every route begins in conversation. We listen for what draws you east, then shape the pace, places and encounters around that.</p></div></div></section><section class="values section-dark section"><div class="shell"><div class="section-head"><h2>What we hold onto.</h2><p>Clear principles make room for more individual journeys.</p></div><div class="value-grid"><article><b>01</b><h3>Attention over access</h3><p>The right context can matter more than a closed door opened.</p></article><article><b>02</b><h3>Pace is a luxury</h3><p>We plan less into each day, and make each choice count.</p></article><article><b>03</b><h3>Local relationships</h3><p>Long-term partners shape how every route feels on the ground.</p></article></div></div></section></BaseLayout>
<style>.mast{background:var(--ink);color:var(--cream);padding:15rem 0 8rem}.mast h1{font-size:clamp(4rem,9vw,8rem);margin-top:1rem}.manifesto{display:grid;grid-template-columns:1fr 3fr;gap:5rem}.manifesto h2{margin-bottom:2rem}.manifesto p{max-width:700px;font-size:1.1rem;margin-bottom:1.2rem;color:#5f6965}.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(243,238,223,.2)}.value-grid article{background:var(--ink);padding:2.3rem}.value-grid b{font:.7rem var(--mono);color:var(--gold)}.value-grid h3{margin:2rem 0 1rem}.value-grid p{color:rgba(243,238,223,.6)}@media(max-width:700px){.manifesto,.value-grid{grid-template-columns:1fr;gap:2rem}}</style>
