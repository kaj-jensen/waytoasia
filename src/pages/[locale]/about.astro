---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {locales,type Locale} from '../../i18n';

export function getStaticPaths(){return locales.map(locale=>({params:{locale},props:{locale}}))}
const {locale}=Astro.props as {locale:Locale};
const staff=[
  {name:'Maya Chen',role:'Japan & China travel designer',base:'Copenhagen · Tokyo',languages:'English · Danish · Mandarin',note:'I look for the small rituals—a morning market, a neighbourhood table, the quiet hour before a temple fills.',image:'https://images.unsplash.com/photo-1758600587833-c07c5bda5c70?auto=format&fit=crop&w=900&q=82',alt:'Sample portrait of a smiling woman',credit:'Vitaly Gariev',source:'https://unsplash.com/photos/close-up-of-a-smiling-asian-woman-with-long-dark-hair-Yh1jghdz9Mg'},
  {name:'Sofia Lind',role:'Thailand & Indonesia specialist',base:'Stockholm · Bangkok',languages:'English · Swedish · Thai',note:'The best itinerary has contrast: a lively city, a slow train, then somewhere beautiful enough to stay an extra day.',image:'https://images.unsplash.com/photo-1768326205125-e7a30f054696?auto=format&fit=crop&w=900&q=82',alt:'Sample portrait of a woman smiling outdoors',credit:'Atul Pandey',source:'https://unsplash.com/photos/a-woman-with-long-dark-hair-smiles-softly-outdoors-xxrz4LJutjA'},
  {name:'Daniel Sørensen',role:'Private journeys director',base:'Copenhagen',languages:'English · Danish · German',note:'I begin with how you want the journey to feel, then make every hotel, transfer and guide support that feeling.',image:'https://images.unsplash.com/photo-1758599543136-5977bf2dd922?auto=format&fit=crop&w=900&q=82',alt:'Sample portrait of a smiling man outdoors',credit:'Vitaly Gariev',source:'https://unsplash.com/photos/a-man-in-a-suit-smiles-confidently-outdoors-UCXGPXBhwGE'},
  {name:'Minh Le',role:'Vietnam journey specialist',base:'Copenhagen · Hanoi',languages:'English · Vietnamese · French',note:'Food is often the most direct route into a place. I plan time for kitchens, growers and the people behind them.',image:'https://images.unsplash.com/photo-1780733062101-3831bb673f22?auto=format&fit=crop&w=900&q=82',alt:'Sample portrait of a smiling man in a blue jacket',credit:'Md Ishak Rahman',source:'https://unsplash.com/photos/happy-man-in-blue-jacket-smiling-outdoors-PIMt1Qn_km8'},
];
---
<BaseLayout title="Our travel studio — Way to Asia" description="Why Way to Asia designs fewer, better journeys." {locale} path="/about">
  <section class="mast"><div class="shell"><span class="eyebrow">Our studio</span><h1>Travel is personal.<br>Planning should be too.</h1></div></section>
  <section class="section section-paper"><div class="shell manifesto"><span class="eyebrow">Our point of view</span><div><h2>Fewer places.<br>Deeper connections.</h2><p>Way to Asia is a travel studio for people who want the confidence of thoughtful planning without losing the freedom of discovery. We work with a small network of guides, hosts and specialists across five countries.</p><p>Every route begins in conversation. We listen for what draws you east, then shape the pace, places and encounters around that.</p></div></div></section>
  <section class="team section" aria-labelledby="team-title"><div class="shell"><header class="team-head"><div><span class="eyebrow">People behind the journeys</span><h2 id="team-title">Your trip starts with a person.</h2></div><p>You will have one travel designer who knows your plans from the first conversation to your return home. These demonstration profiles show how our growing team will be introduced before launch.</p></header><div class="team-grid">{staff.map(member=><article class="staff-card"><figure><img src={member.image} alt={member.alt} loading="lazy"><figcaption>Sample portrait · <a href={member.source} target="_blank" rel="noreferrer">{member.credit} / Unsplash</a></figcaption></figure><div class="staff-copy"><span class="sample">Demonstration profile</span><h3>{member.name}</h3><p class="role">{member.role}</p><dl><div><dt>Based</dt><dd>{member.base}</dd></div><div><dt>Languages</dt><dd>{member.languages}</dd></div></dl><blockquote>“{member.note}”</blockquote></div></article>)}</div></div></section>
  <section class="values section-dark section" aria-labelledby="why-us"><div class="shell"><div class="section-head"><div><span class="eyebrow">Why travel with us</span><h2 id="why-us">Close to you.<br>Present in Asia.</h2></div><p>You plan with one dedicated travel designer and travel with the reassurance of destination teams who understand the language, culture and realities on the ground.</p></div><div class="office-network" aria-label="Proposed local office network"><span>Proposed local office network</span><ul><li><b>PEK</b> Beijing</li><li><b>NRT</b> Tokyo</li><li><b>BKK</b> Bangkok</li><li><b>HAN</b> Hanoi</li><li><b>DPS</b> Bali</li></ul></div><div class="value-grid"><article><b>01</b><h3>Local offices</h3><p>Our destination offices keep planning close to the people, places and partners that shape each journey.</p></article><article><b>02</b><h3>Support where you travel</h3><p>If plans change while you are away, you reach people in the destination who can respond with local knowledge.</p></article><article><b>03</b><h3>First-hand expertise</h3><p>Routes are informed by specialists who know the seasons, distances, neighbourhoods and cultural context.</p></article><article><b>04</b><h3>One accountable designer</h3><p>Your dedicated contact follows the whole journey—from the first conversation until you return home.</p></article></div></div></section>
</BaseLayout>
<style>
.mast{background:var(--ink);color:var(--cream);padding:12rem 0 6rem}.mast h1{font-size:clamp(4rem,9vw,8rem);margin-top:1rem}.manifesto{display:grid;grid-template-columns:1fr 3fr;gap:5rem}.manifesto h2{margin-bottom:2rem}.manifesto p{max-width:700px;font-size:1.1rem;margin-bottom:1.2rem;color:#5f6965}.team{background:#d8ece8}.team-head{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:end;margin-bottom:2.4rem}.team-head h2{margin:.6rem 0 0}.team-head>p{max-width:560px;color:#526059}.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(16,39,31,.22);border:1px solid rgba(16,39,31,.22)}.staff-card{background:#faf7ef;min-width:0}.staff-card figure{margin:0;position:relative}.staff-card img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;filter:saturate(.86)}.staff-card figcaption{position:absolute;inset:auto .7rem .7rem;background:rgba(6,25,19,.82);color:#e1e8e3;padding:.35rem .5rem;font:.48rem var(--mono);letter-spacing:.03em}.staff-card figcaption a{color:#fff;text-decoration:underline;text-underline-offset:2px}.staff-copy{padding:1.35rem}.sample{display:block;color:#8f3022;font:600 .55rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.staff-copy h3{font-size:1.65rem;margin:.55rem 0 .15rem}.role{min-height:2.4em;color:#526059;font-weight:600}.staff-copy dl{margin:1.2rem 0;border-top:1px solid #d4ccbd}.staff-copy dl div{padding:.55rem 0;border-bottom:1px solid #d4ccbd}.staff-copy dt{font:500 .52rem var(--mono);text-transform:uppercase;color:#69756f}.staff-copy dd{margin:.12rem 0 0;font-size:.68rem}.staff-copy blockquote{margin:1.1rem 0 0;color:#435149;font-size:.73rem;line-height:1.55}.values .section-head{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:end;margin-bottom:2rem}.values .section-head h2{margin:.6rem 0 0}.values .section-head>p{color:#b7c3bd;max-width:560px}.office-network{display:grid;grid-template-columns:auto 1fr;gap:2rem;align-items:center;padding:1rem 0;margin-bottom:1px;border-top:1px solid rgba(243,238,223,.22);border-bottom:1px solid rgba(243,238,223,.22)}.office-network>span{font:600 .56rem var(--mono);color:var(--gold);letter-spacing:.1em;text-transform:uppercase}.office-network ul{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;list-style:none;margin:0;padding:0}.office-network li{font-size:.7rem;color:#f3eedf}.office-network b{display:block;color:var(--gold);font:.55rem var(--mono);letter-spacing:.08em}.value-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(243,238,223,.2)}.value-grid article{background:var(--ink);padding:2rem 1.5rem}.value-grid b{font:.7rem var(--mono);color:var(--gold)}.value-grid h3{margin:1.5rem 0 .75rem}.value-grid p{color:#b7c3bd}
@media(max-width:950px){.team-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.values .section-head{grid-template-columns:1fr}.office-network{grid-template-columns:1fr}.office-network ul{grid-template-columns:repeat(3,1fr)}.value-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.manifesto,.team-head,.value-grid{grid-template-columns:1fr;gap:2rem}.team-head{align-items:start}.office-network ul{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.team-grid{grid-template-columns:1fr}.staff-copy .role{min-height:0}}
</style>
