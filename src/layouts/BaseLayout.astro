---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {locales,type Locale} from '../i18n';
const {title,description,locale,path='',image='https://images.unsplash.com/photo-1528181304800-259b08848526?auto=format&fit=crop&w=1600&q=80'}=Astro.props as {title:string;description:string;locale:Locale;path?:string;image?:string};
const canonical=new URL(`/${locale}${path}`,Astro.site);
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#0f211c"><link rel="canonical" href={canonical}>{locales.map(l=><link rel="alternate" hreflang={l} href={new URL(`/${l}${path}`,Astro.site)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(`/en${path}`,Astro.site)}/><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={image}><meta property="og:type" content="website"><title>{title}</title><slot name="head" /></head><body><a class="skip-link" href="#content">Skip to content</a><Header locale={locale} path={path}/><main id="content"><slot /></main><Footer locale={locale} path={path}/></body></html>
