---
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import {tr,locales,type Locale} from '../i18n';
const {title,description,locale,path='',image='https://images.unsplash.com/photo-1528181304800-259b08848526?auto=format&fit=crop&w=1600&q=80'}=Astro.props as {title:string;description:string;locale:Locale;path?:string;image?:string};
const canonical=new URL(`/${locale}${path}`,Astro.site);
const structuredData={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'Organization','@id':new URL('/#organization',Astro.site).href,name:'Way to Asia',url:new URL('/',Astro.site).href},
    {'@type':'WebSite','@id':new URL('/#website',Astro.site).href,url:new URL('/',Astro.site).href,name:'Way to Asia',publisher:{'@id':new URL('/#organization',Astro.site).href},inLanguage:locale},
    {'@type':'WebPage','@id':`${canonical.href}#webpage`,url:canonical.href,name:title,description,isPartOf:{'@id':new URL('/#website',Astro.site).href},about:{'@id':new URL('/#organization',Astro.site).href},inLanguage:locale},
  ],
};
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="robots" content="index, follow, max-image-preview:large"><meta name="theme-color" content="#0f211c"><link rel="preconnect" href="https://images.unsplash.com" crossorigin><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin><link rel="canonical" href={canonical}>{locales.map(l=><link rel="alternate" hreflang={l} href={new URL(`/${l}${path}`,Astro.site)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(`/en${path}`,Astro.site)}/><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={image}><meta property="og:url" content={canonical}><meta property="og:site_name" content="Way to Asia"><meta property="og:type" content="website"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}><meta name="twitter:image" content={image}><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script><title>{title}</title><slot name="head" /></head><body><a class="skip-link" href="#content">{tr(locale,'Skip to content')}</a><Header locale={locale} path={path}/><main id="content"><slot /></main><Footer locale={locale} path={path}/><AnalyticsConsent {locale}/></body></html>
